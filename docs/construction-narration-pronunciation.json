{
  "version": 1,
  "title": "Construction narration pronunciation",
  "purpose": "How PilotFish Sandbox construction videos should pronounce technical terms and paths. Display text (transcript/PDF overlay) stays normal; TTS speech is rewritten from these rules.",
  "display_vs_speech": "Keep human-readable spelling in build-replay detail and transcript PDFs (SFTP, /opt/...). Apply this guide only when synthesizing voiceover.",
  "path_rules": {
    "never_say_slash": true,
    "never_say_backslash": true,
    "unix_path_speak": "Speak folder segments as words separated by short pauses (commas). Example: /opt/pilotfish/input/staged \u2192 opt, pilotfish, input, staged.",
    "windows_path_speak": "Same for backslash paths. Example: C:\\data\\in \u2192 C, data, in.",
    "prefer_friendly_folder": "When a well-known env folder is meant, prefer the role name in speech: staged folder, archive folder, upload folder \u2014 and only spell the full path when the exact location matters.",
    "file_extensions": "Leading dot extensions: say 'dot' then the usual name. Example: .csv \u2192 dot csv. Do not letter-spell csv or xml."
  },
  "replacements": [
    {
      "id": "2-x",
      "match": "\\b2\\.x\\b",
      "flags": "i",
      "speak": "two dot x",
      "notes": "Spoken sample; heard \u201ctwo dot x\u201d."
    },
    {
      "id": "fhir",
      "match": "\\bFHIR\\b",
      "flags": "i",
      "speak": "fire",
      "notes": "Brian: say fire, not letter-soup."
    },
    {
      "id": "hl7",
      "match": "\\bHL7\\b",
      "flags": "i",
      "speak": "HL seven",
      "notes": "Spoken sample."
    },
    {
      "id": "llp",
      "match": "\\bLLP\\b",
      "flags": "i",
      "speak": "LL P",
      "notes": "Spoken sample."
    },
    {
      "id": "pid-7",
      "match": "\\bPID\\.7\\b",
      "flags": "i",
      "speak": "P I D seven",
      "notes": "HL7 PID-7 / date of birth field."
    },
    {
      "id": "yyyymmdd-dash",
      "match": "\\byyyy-MM-dd\\b",
      "flags": "i",
      "speak": "Y Y Y Y dash M M dash D D",
      "notes": "ISO date pattern. Applied before the compact form."
    },
    {
      "id": "yyyymmdd",
      "match": "\\byyyyMMdd\\b",
      "flags": "i",
      "speak": "Y Y Y Y M M D D",
      "notes": "Compact HL7 date pattern."
    },
    {
      "id": "adt",
      "match": "\\bADT\\b",
      "flags": "",
      "speak": "A D T",
      "notes": "Admit/discharge/transfer. Letter-by-letter like the source video."
    },
    {
      "id": "834-a1",
      "match": "\\b834-A1\\b",
      "flags": "i",
      "speak": "eight thirty-four A-one",
      "notes": "X12 834 table-data folder. Never 'eight hundred thirty-four'."
    },
    {
      "id": "834",
      "match": "\\b834\\b",
      "flags": "",
      "speak": "eight thirty-four",
      "notes": "Always eight thirty-four. Never eight hundred thirty-four."
    },
    {
      "id": "x12",
      "match": "\\bX12\\b",
      "flags": "i",
      "speak": "X twelve",
      "notes": "Do not say X one two."
    },
    {
      "id": "edi",
      "match": "\\bEDI\\b",
      "flags": "",
      "speak": "E D I",
      "notes": "Letter-by-letter, then 834 as eight thirty-four. Never eight hundred thirty-four."
    },
    {
      "id": "5010",
      "match": "\\b5010\\b",
      "flags": "",
      "speak": "five oh ten",
      "notes": "HIPAA 5010 version."
    },
    {
      "id": "loop-2000",
      "match": "\\bLoop\\s*2000\\b",
      "flags": "i",
      "speak": "loop two thousand",
      "notes": ""
    },
    {
      "id": "csv-to-sqlxml",
      "match": "\\bcsv-to-sqlxml\\b",
      "flags": "i",
      "speak": "csv to sequel xml",
      "notes": "Demo stylesheet basename without extension."
    },
    {
      "id": "sftp",
      "match": "\\bSFTP\\b",
      "flags": "i",
      "speak": "FTP",
      "notes": "Spoken sample."
    },
    {
      "id": "ftps",
      "match": "\\bFTPS\\b",
      "flags": "i",
      "speak": "F T P S",
      "notes": "Spoken sample."
    },
    {
      "id": "ftp",
      "match": "\\bFTP\\b",
      "flags": "",
      "speak": "F T P",
      "notes": "Letter-by-letter."
    },
    {
      "id": "ssh",
      "match": "\\bSSH\\b",
      "flags": "",
      "speak": "S S H",
      "notes": ""
    },
    {
      "id": "jsch",
      "match": "\\bJSCH\\b",
      "flags": "",
      "speak": "J S C H",
      "notes": "PilotFish encrypted SFTP library."
    },
    {
      "id": "jdbc",
      "match": "\\bJDBC\\b",
      "flags": "",
      "speak": "J D B C",
      "notes": ""
    },
    {
      "id": "sqlxml",
      "match": "\\bSQLXML\\b",
      "flags": "",
      "speak": "S Q L X M L",
      "notes": "Spell fully; do not say 'sequel XML'."
    },
    {
      "id": "sql-server",
      "match": "\\bSQL\\s*Server\\b",
      "flags": "i",
      "speak": "sequel Server",
      "notes": "Product name uses 'sequel'."
    },
    {
      "id": "sqlserver-host",
      "match": "\\bsqlserver\\b",
      "flags": "i",
      "speak": "sequel Server",
      "notes": "Docker service / hostname for SQL Server \u2014 do not letter-spell."
    },
    {
      "id": "sql",
      "match": "\\bSQL\\b",
      "flags": "",
      "speak": "sequel",
      "notes": "Standalone SQL \u2192 sequel. Applied after SQLXML / SQL Server rules."
    },
    {
      "id": "csv",
      "match": "\\bCSV\\b",
      "flags": "",
      "speak": "csv",
      "notes": "Say it as a word, not C S V."
    },
    {
      "id": "xml",
      "match": "\\bXML\\b",
      "flags": "",
      "speak": "xml",
      "notes": "Say it as a word, not X M L."
    },
    {
      "id": "xslt",
      "match": "\\bXSLT\\b",
      "flags": "",
      "speak": "xslt",
      "notes": "Say it as a word, not X S L T."
    },
    {
      "id": "xpath",
      "match": "\\bXPath\\b",
      "flags": "i",
      "speak": "ex-path",
      "notes": "Spoken sample."
    },
    {
      "id": "json",
      "match": "\\bJSON\\b",
      "flags": "i",
      "speak": "jay-sonn",
      "notes": "Spoken sample."
    },
    {
      "id": "api",
      "match": "\\bAPI\\b",
      "flags": "",
      "speak": "A P I",
      "notes": ""
    },
    {
      "id": "http",
      "match": "\\bHTTPS?\\b",
      "flags": "i",
      "speak_map": {
        "HTTP": "H T T P",
        "HTTPS": "H T T P S",
        "http": "H T T P",
        "https": "H T T P S"
      },
      "notes": ""
    },
    {
      "id": "eiplatform",
      "match": "\\beiPlatform\\b",
      "flags": "i",
      "speak": "E I Platform",
      "notes": ""
    },
    {
      "id": "eiconsole-s",
      "match": "\\beiConsole's\\b",
      "flags": "i",
      "speak": "ee-eye-kahn-sohl's",
      "notes": "Spoken sample."
    },
    {
      "id": "eiconsole",
      "match": "\\beiConsole\\b",
      "flags": "i",
      "speak": "ee-eye-kahn-sohl",
      "notes": "Spoken sample."
    },
    {
      "id": "ognl",
      "match": "\\bOGNL\\b",
      "flags": "i",
      "speak": "Ohhh-Gee-NL",
      "notes": "Spoken sample."
    },
    {
      "id": "fqcn",
      "match": "\\bFQCN\\b",
      "flags": "i",
      "speak": "f-cue-c-n",
      "notes": "Spoken sample."
    },
    {
      "id": "dbo",
      "match": "\\bdbo\\.",
      "flags": "i",
      "speak": "D B O dot ",
      "notes": "Schema qualifier before a table name."
    },
    {
      "id": "localhost",
      "match": "\\blocalhost\\b",
      "flags": "i",
      "speak": "local host",
      "notes": ""
    },
    {
      "id": "uuid-ish",
      "match": "\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b",
      "flags": "i",
      "speak": "module id",
      "notes": "Do not read UUID hex aloud."
    }
  ],
  "friendly_paths": [
    {
      "match": "/opt/pilotfish/input/staged",
      "speak": "the staged input folder"
    },
    {
      "match": "/opt/pilotfish/output/archive",
      "speak": "the archive output folder"
    },
    {
      "match": "/opt/pilotfish/output/staged-archive",
      "speak": "the staged-archive output folder"
    },
    {
      "match": "input/staged",
      "speak": "the staged input folder"
    },
    {
      "match": "output/archive",
      "speak": "the archive folder"
    }
  ],
  "examples": [
    {
      "display": "Connects to FTP host, port 22, folder upload.",
      "speak": "Connects to F T P host, port 22, folder upload."
    },
    {
      "display": "Writes to /opt/pilotfish/input/staged.",
      "speak": "Writes to the staged input folder."
    },
    {
      "display": "Uses stylesheet csv-to-sqlxml.xslt on Saxon.",
      "speak": "Uses stylesheet csv to sequel xml dot xslt on Saxon."
    },
    {
      "display": "JDBC to sqlserver, database CsvSftpDemo.",
      "speak": "J D B C to sequel Server, database Csv Sftp Demo."
    }
  ]
}
