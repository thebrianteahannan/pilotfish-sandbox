<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:x12:schemas:005:010:820A1:PaymentOrderRemittanceAdvice" xmlns:x12="http://schemas.x12.org/isomorph" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:x12:schemas:005:010:820A1:PaymentOrderRemittanceAdvice" elementFormDefault="qualified" version="005010">
	<xs:annotation>
		<xs:documentation xml:lang="en">Accredited Standards Committee X12 TR3 Schema: 005010X218 - 820 - Payment Order/Remittance Advice</xs:documentation>
	</xs:annotation>
	<xs:annotation>
		<xs:documentation>2010 (c) Data Interchange Standards Association for the members of ASC X12</xs:documentation>
	</xs:annotation>
	<xs:element name="X12_005010X218_820A1">
		<xs:annotation>
			<xs:documentation>This X12 Transaction Set contains the format and establishes the data contents of the Payment Order/Remittance Advice Transaction Set (820) for use within the context of an Electronic Data Interchange (EDI) environment. The transaction set can be used to make a payment, send a remittance advice, or make a payment and send a remittance advice.

This transaction set can be an order to a financial institution to make a payment to a payee. It can also be a remittance advice identifying the detail needed to perform cash application to the payee's accounts receivable system. The remittance advice can go directly from payer to payee, through a financial institution, or through a third party agent.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ST_820Header"/>
				<xs:element ref="BPR_FinancialInformation"/>
				<xs:element ref="TRN_ReassociationTraceNumber"/>
				<xs:element ref="CUR_ForeignCurrencyInformation" minOccurs="0"/>
				<xs:element ref="REF_PremiumReceiversIdentificationKey" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="DTM_ProcessDate" minOccurs="0"/>
				<xs:element ref="DTM_DeliveryDate" minOccurs="0"/>
				<xs:element ref="DTM_CoveragePeriod" minOccurs="0"/>
				<xs:element ref="DTM_CreationDate" minOccurs="0"/>
				<xs:element ref="Loop_1000A"/>
				<xs:element ref="Loop_1000B"/>
				<xs:element ref="Loop_1000C" minOccurs="0" maxOccurs="14"/>
				<xs:element ref="Loop_2000A" minOccurs="0"/>
				<xs:element ref="Loop_2000B" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="SE_TransactionSetTrailer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000A">
		<xs:annotation>
			<xs:documentation>Premium Receivers Name Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PremiumReceiversName_1000A"/>
				<xs:element ref="N2_PremiumReceiverAdditionalName_1000A" minOccurs="0"/>
				<xs:element ref="N3_PremiumReceiversAddress_1000A" minOccurs="0"/>
				<xs:element ref="N4_PremiumReceiversCityStateAndZIPCode_1000A" minOccurs="0"/>
				<xs:element ref="RDM_PremiumReceiversRemittanceDeliveryMethod_1000A" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000B">
		<xs:annotation>
			<xs:documentation>Premium Payers Name Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PremiumPayersName_1000B"/>
				<xs:element ref="N2_PremiumPayerAdditionalName_1000B" minOccurs="0"/>
				<xs:element ref="N3_PremiumPayersAddress_1000B" minOccurs="0"/>
				<xs:element ref="N4_PremiumPayersCityStateZIPCode_1000B" minOccurs="0"/>
				<xs:element ref="PER_PremiumPayersAdministrativeContact_1000B" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000C">
		<xs:annotation>
			<xs:documentation>Intermediary Bank Information Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_IntermediaryBankInformation_1000C"/>
				<xs:element ref="N2_IntermediaryBankAdditionalName_1000C" minOccurs="0"/>
				<xs:element ref="N3_IntermediaryBanksAddress_1000C" minOccurs="0"/>
				<xs:element ref="N4_IntermediaryBanksCityStateZIPCode_1000C" minOccurs="0"/>
				<xs:element ref="PER_IntermediaryBanksAdministrativeContact_1000C" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2000A">
		<xs:annotation>
			<xs:documentation>Organization Summary Remittance Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ENT_OrganizationSummaryRemittance_2000A"/>
				<xs:element ref="Loop_2200A" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Loop_2300A" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2200A">
		<xs:annotation>
			<xs:documentation>Organization Summary Remittance Level Adjustment For Previous Payment Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ADX_OrganizationSummaryRemittanceLevelAdjustmentForPreviousPayment_2200A"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2300A">
		<xs:annotation>
			<xs:documentation>Organization Summary Remittance Detail Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="RMR_OrganizationSummaryRemittanceDetail_2300A"/>
				<xs:element ref="REF_ReferenceInformation_2300A" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="DTM_OrganizationalCoveragePeriod_2300A" minOccurs="0"/>
				<xs:element ref="Loop_2310A" minOccurs="0"/>
				<xs:element ref="Loop_2320A" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2310A">
		<xs:annotation>
			<xs:documentation>Summary Line Item Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="IT1_SummaryLineItem_2310A"/>
				<xs:element ref="Loop_2312A" minOccurs="0" maxOccurs="4"/>
				<xs:element ref="Loop_2315A" minOccurs="0" maxOccurs="3"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2312A">
		<xs:annotation>
			<xs:documentation>Service Promotion Allowance Or Charge Information Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SAC_ServicePromotionAllowanceOrChargeInformation_2312A"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2315A">
		<xs:annotation>
			<xs:documentation>Member Count Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SLN_MemberCount_2315A"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2320A">
		<xs:annotation>
			<xs:documentation>Organization Summary Remittance Level Adjustment For Current Payment Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ADX_OrganizationSummaryRemittanceLevelAdjustmentForCurrentPayment_2320A"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2000B">
		<xs:annotation>
			<xs:documentation>Individual Remittance Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ENT_IndividualRemittance_2000B"/>
				<xs:element ref="Loop_2100B" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Loop_2200B" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Loop_2300B" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2100B">
		<xs:annotation>
			<xs:documentation>Individual Name Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="NM1_IndividualName_2100B"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2200B">
		<xs:annotation>
			<xs:documentation>Individual Premium Adjustment For Previous Payment Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ADX_IndividualPremiumAdjustmentForPreviousPayment_2200B"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2300B">
		<xs:annotation>
			<xs:documentation>Individual Premium Remittance Detail Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="RMR_IndividualPremiumRemittanceDetail_2300B"/>
				<xs:element ref="REF_ReferenceInformation_2300B" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="DTM_IndividualCoveragePeriod_2300B" minOccurs="0"/>
				<xs:element ref="Loop_2320B" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2320B">
		<xs:annotation>
			<xs:documentation>Individual Premium Adjustment For Current Payment Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ADX_IndividualPremiumAdjustmentForCurrentPayment_2320B"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ST_820Header">
		<xs:annotation>
			<xs:documentation>820 Header</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ST01__TransactionSetIdentifierCode">
					<xs:annotation>
						<xs:documentation>Code uniquely identifying a Transaction Set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Set Identifier Code" Number="143" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="820">
								<xs:annotation>
									<xs:documentation>Payment Order/Remittance Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST02__TransactionSetControlNumber">
					<xs:annotation>
						<xs:documentation>The unique identification number within a transaction set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Set Control Number" Number="329" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="4"/>
							<xs:maxLength value="9"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST03__ImplementationConventionReference">
					<xs:annotation>
						<xs:documentation>Reference assigned to identify Implementation Convention.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Implementation Convention Reference" Number="1705" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BPR_FinancialInformation">
		<xs:annotation>
			<xs:documentation>Financial Information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BPR01__TransactionHandlingCode">
					<xs:annotation>
						<xs:documentation>This code designates whether and how the money and remittance information will be processed.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Handling Code" Number="305" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Payment Accompanies Remittance Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="D">
								<xs:annotation>
									<xs:documentation>Make Payment Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="I">
								<xs:annotation>
									<xs:documentation>Remittance Information Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="P">
								<xs:annotation>
									<xs:documentation>Prenotification of Future Transfers</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="U">
								<xs:annotation>
									<xs:documentation>Split Payment and Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="X">
								<xs:annotation>
									<xs:documentation>Handling Party's Option to Split Payment and Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR02__TotalPremiumPaymentAmount">
					<xs:annotation>
						<xs:documentation>The total premium payment for this batch or transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Monetary Amount" Number="782" DataType="R" MaximumLength="18"/>
							<x12:TR3_Info MaximumLength="11"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="20"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR03__CreditOrDebitFlagCode">
					<xs:annotation>
						<xs:documentation>Code indicating whether amount is a credit or debit</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Credit/Debit Flag Code" Number="478" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="1"/>
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Credit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR04__PaymentMethodCode">
					<xs:annotation>
						<xs:documentation>Code identifying the method for the movement of payment instructions.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Payment Method Code" Number="591" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="ACH">
								<xs:annotation>
									<xs:documentation>Automated Clearing House (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="BOP">
								<xs:annotation>
									<xs:documentation>Financial Institution Option</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CHK">
								<xs:annotation>
									<xs:documentation>Check</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="FWT">
								<xs:annotation>
									<xs:documentation>Federal Reserve Funds/Wire Transfer - Nonrepetitive</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="NON">
								<xs:annotation>
									<xs:documentation>Non-Payment Data</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SWT">
								<xs:annotation>
									<xs:documentation>Society for Worldwide Interbank Financial Telecommunications (S.W.I.F.T.)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR05__PaymentFormatCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Type of format chosen to send payment</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Payment Format Code" Number="812" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="10"/>
							<xs:enumeration value="CCP">
								<xs:annotation>
									<xs:documentation>Cash Concentration/Disbursement plus Addenda (CCD+) (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CTX">
								<xs:annotation>
									<xs:documentation>Corporate Trade Exchange (CTX) (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR06__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) ID Number Qualifier" Number="506" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9 digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="02">
								<xs:annotation>
									<xs:documentation>Swift Identification (8 or 11 characters)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR07__OriginatingDepositoryFinancialInstitutionDFIIdentifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number identifying the financial institution originating the transaction in an ACH network.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) Identification Number" Number="507" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="12"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR08__AccountNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code indicating the type of account</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number Qualifier" Number="569" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="ALC">
								<xs:annotation>
									<xs:documentation>Agency Location Code (ALC)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="DA">
								<xs:annotation>
									<xs:documentation>Demand Deposit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR09__SenderBankAccountNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The sender's bank account number at the Originating Depository Financial Institution.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number" Number="508" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR10__PayerIdentifier">
					<xs:annotation>
						<xs:documentation>Number identifying the payer organization.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Originating Company Identifier" Number="509" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="10"/>
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR11__OriginatingCompanySupplementalCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number identifying a further subdivision within the entity originating the transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Originating Company Supplemental Code" Number="510" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="9"/>
							<xs:maxLength value="9"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR12__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) ID Number Qualifier" Number="506" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9 digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="02">
								<xs:annotation>
									<xs:documentation>Swift Identification (8 or 11 characters)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR13__ReceivingDepositoryFinancialInstitutionDFIIdentifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number identifying the financial institution receiving the transaction from an ACH network.</xs:documentation>
						<xs:appinfo>
