<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:x12:schemas:005:010:835W1A1:HealthCareClaimPaymentAdvice" xmlns:x12="http://schemas.x12.org/isomorph" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:x12:schemas:005:010:835W1A1:HealthCareClaimPaymentAdvice" elementFormDefault="qualified" version="005010">
	<xs:annotation>
		<xs:documentation xml:lang="en">Accredited Standards Committee X12 TR3 Schema: 005010X221A1 - 835 - Health Care Claim Payment/Advice</xs:documentation>
	</xs:annotation>
	<xs:annotation>
		<xs:documentation>2010 (c) Data Interchange Standards Association for the members of ASC X12</xs:documentation>
	</xs:annotation>
	<xs:element name="X12_005010X221A1_835W1">
		<xs:annotation>
			<xs:documentation>This X12 Transaction Set contains the format and establishes the data contents of the Health Care Claim Payment/Advice Transaction Set (835) for use within the context of the Electronic Data Interchange (EDI) environment. This transaction set can be used to make a payment, send an Explanation of Benefits (EOB) remittance advice, or make a payment and send an EOB remittance advice only from a health insurer to a health care provider either directly or via a financial institution.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ST_TransactionSetHeader"/>
				<xs:element ref="BPR_FinancialInformation"/>
				<xs:element ref="TRN_ReassociationTraceNumber"/>
				<xs:element ref="CUR_ForeignCurrencyInformation" minOccurs="0"/>
				<xs:element ref="REF_ReceiverIdentification" minOccurs="0"/>
				<xs:element ref="REF_VersionIdentification" minOccurs="0"/>
				<xs:element ref="DTM_ProductionDate" minOccurs="0"/>
				<xs:element ref="Loop_1000A"/>
				<xs:element ref="Loop_1000B"/>
				<xs:element ref="Loop_2000" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="PLB_ProviderAdjustment" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="SE_TransactionSetTrailer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000A">
		<xs:annotation>
			<xs:documentation>Payer Identification Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PayerIdentification_1000A"/>
				<xs:element ref="N3_PayerAddress_1000A"/>
				<xs:element ref="N4_PayerCityStateZIPCode_1000A"/>
				<xs:element ref="REF_AdditionalPayerIdentification_1000A" minOccurs="0" maxOccurs="4"/>
				<xs:element ref="PER_PayerBusinessContactInformation_1000A" minOccurs="0"/>
				<xs:element ref="PER_PayerTechnicalContactInformation_1000A" maxOccurs="unbounded"/>
				<xs:element ref="PER_PayerWEBSite_1000A" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000B">
		<xs:annotation>
			<xs:documentation>Payee Identification Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PayeeIdentification_1000B"/>
				<xs:element ref="N3_PayeeAddress_1000B" minOccurs="0"/>
				<xs:element ref="N4_PayeeCityStateZIPCode_1000B" minOccurs="0"/>
				<xs:element ref="REF_PayeeAdditionalIdentification_1000B" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="RDM_RemittanceDeliveryMethod_1000B" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2000">
		<xs:annotation>
			<xs:documentation>Claim Payment Line Item Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LX_HeaderNumber_2000"/>
				<xs:element ref="TS3_ProviderSummaryInformation_2000" minOccurs="0"/>
				<xs:element ref="TS2_ProviderSupplementalSummaryInformation_2000" minOccurs="0"/>
				<xs:element ref="Loop_2100" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2100">
		<xs:annotation>
			<xs:documentation>Claim Payment Information Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CLP_ClaimPaymentInformation_2100"/>
				<xs:element ref="CAS_ClaimAdjustment_2100" minOccurs="0" maxOccurs="99"/>
				<xs:element ref="NM1_PatientName_2100"/>
				<xs:element ref="NM1_InsuredName_2100" minOccurs="0"/>
				<xs:element ref="NM1_CorrectedPatientInsuredName_2100" minOccurs="0"/>
				<xs:element ref="NM1_ServiceProviderName_2100" minOccurs="0"/>
				<xs:element ref="NM1_CrossoverCarrierName_2100" minOccurs="0"/>
				<xs:element ref="NM1_CorrectedPriorityPayerName_2100" minOccurs="0"/>
				<xs:element ref="NM1_OtherSubscriberName_2100" minOccurs="0"/>
				<xs:element ref="MIA_InpatientAdjudicationInformation_2100" minOccurs="0"/>
				<xs:element ref="MOA_OutpatientAdjudicationInformation_2100" minOccurs="0"/>
				<xs:element ref="REF_OtherClaimRelatedIdentification_2100" minOccurs="0" maxOccurs="5"/>
				<xs:element ref="REF_RenderingProviderIdentification_2100" minOccurs="0" maxOccurs="10"/>
				<xs:element ref="DTM_StatementFromOrToDate_2100" minOccurs="0" maxOccurs="2"/>
				<xs:element ref="DTM_CoverageExpirationDate_2100" minOccurs="0"/>
				<xs:element ref="DTM_ClaimReceivedDate_2100" minOccurs="0"/>
				<xs:element ref="PER_ClaimContactInformation_2100" minOccurs="0" maxOccurs="2"/>
				<xs:element ref="AMT_ClaimSupplementalInformation_2100" minOccurs="0" maxOccurs="13"/>
				<xs:element ref="QTY_ClaimSupplementalInformationQuantity_2100" minOccurs="0" maxOccurs="14"/>
				<xs:element ref="Loop_2110" minOccurs="0" maxOccurs="999"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2110">
		<xs:annotation>
			<xs:documentation>Service Payment Information Loop</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SVC_ServicePaymentInformation_2110"/>
				<xs:element ref="DTM_ServiceDate_2110" minOccurs="0" maxOccurs="2"/>
				<xs:element ref="CAS_ServiceAdjustment_2110" minOccurs="0" maxOccurs="99"/>
				<xs:element ref="REF_ServiceIdentification_2110" minOccurs="0" maxOccurs="8"/>
				<xs:element ref="REF_LineItemControlNumber_2110" minOccurs="0"/>
				<xs:element ref="REF_RenderingProviderInformation_2110" minOccurs="0" maxOccurs="10"/>
				<xs:element ref="REF_HealthCarePolicyIdentification_2110" minOccurs="0" maxOccurs="5"/>
				<xs:element ref="AMT_ServiceSupplementalAmount_2110" minOccurs="0" maxOccurs="9"/>
				<xs:element ref="QTY_ServiceSupplementalQuantity_2110" minOccurs="0" maxOccurs="6"/>
				<xs:element ref="LQ_HealthCareRemarkCodes_2110" minOccurs="0" maxOccurs="99"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ST_TransactionSetHeader">
		<xs:annotation>
			<xs:documentation>Transaction Set Header</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ST01__TransactionSetIdentifierCode">
					<xs:annotation>
						<xs:documentation>Code uniquely identifying a Transaction Set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Set Identifier Code" Number="143" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="835">
								<xs:annotation>
									<xs:documentation>Health Care Claim Payment/Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST02__TransactionSetControlNumber">
					<xs:annotation>
						<xs:documentation>The unique identification number within a transaction set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Set Control Number" Number="329" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="4"/>
							<xs:maxLength value="9"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST03" minOccurs="0">
					<xs:annotation>
						<xs:appinfo>
							<x12:STD_Info Name="Implementation Convention Reference" Number="1705" DataType="AN"/>
							<x12:TR3_Info Used="No"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BPR_FinancialInformation">
		<xs:annotation>
			<xs:documentation>Financial Information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BPR01__TransactionHandlingCode">
					<xs:annotation>
						<xs:documentation>This code designates whether and how the money and remittance information will be processed.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Transaction Handling Code" Number="305" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Payment Accompanies Remittance Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="D">
								<xs:annotation>
									<xs:documentation>Make Payment Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="H">
								<xs:annotation>
									<xs:documentation>Notification Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="I">
								<xs:annotation>
									<xs:documentation>Remittance Information Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="P">
								<xs:annotation>
									<xs:documentation>Prenotification of Future Transfers</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="U">
								<xs:annotation>
									<xs:documentation>Split Payment and Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="X">
								<xs:annotation>
									<xs:documentation>Handling Party's Option to Split Payment and Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR02__TotalActualProviderPaymentAmount">
					<xs:annotation>
						<xs:documentation>The actual payment to the provider for this batch, transaction, or summary.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Monetary Amount" Number="782" DataType="R" MaximumLength="18"/>
							<x12:TR3_Info MaximumLength="11"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="20"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR03__CreditOrDebitFlagCode">
					<xs:annotation>
						<xs:documentation>Code indicating whether amount is a credit or debit</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Credit/Debit Flag Code" Number="478" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="1"/>
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Credit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="D">
								<xs:annotation>
									<xs:documentation>Debit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR04__PaymentMethodCode">
					<xs:annotation>
						<xs:documentation>Code identifying the method for the movement of payment instructions.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Payment Method Code" Number="591" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="ACH">
								<xs:annotation>
									<xs:documentation>Automated Clearing House (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="BOP">
								<xs:annotation>
									<xs:documentation>Financial Institution Option</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CHK">
								<xs:annotation>
									<xs:documentation>Check</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="FWT">
								<xs:annotation>
									<xs:documentation>Federal Reserve Funds/Wire Transfer - Nonrepetitive</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="NON">
								<xs:annotation>
									<xs:documentation>Non-Payment Data</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR05__PaymentFormatCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Type of format chosen to send payment</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Payment Format Code" Number="812" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="10"/>
							<xs:enumeration value="CCP">
								<xs:annotation>
									<xs:documentation>Cash Concentration/Disbursement plus Addenda (CCD+) (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CTX">
								<xs:annotation>
									<xs:documentation>Corporate Trade Exchange (CTX) (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR06__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) ID Number Qualifier" Number="506" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9 digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR07__SenderDFIIdentifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The Depository Financial Institution (DFI) identification number of the originator of the transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) Identification Number" Number="507" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="12"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR08__AccountNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code indicating the type of account</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number Qualifier" Number="569" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="DA">
								<xs:annotation>
									<xs:documentation>Demand Deposit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR09__SenderBankAccountNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The sender's bank account number at the Originating Depository Financial Institution.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number" Number="508" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR10__PayerIdentifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number identifying the payer organization.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Originating Company Identifier" Number="509" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="10"/>
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR11__OriginatingCompanySupplementalCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Number identifying a further subdivision within the entity originating the transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Originating Company Supplemental Code" Number="510" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="9"/>
							<xs:maxLength value="9"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR12__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) ID Number Qualifier" Number="506" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="2"/>
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9 digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR13__ReceiverOrProviderBankIDNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The American Banking Association Identification Number used to identify the receiving depository financial institution or provider's bank within the Federal Reserve System when an EFT is being sent.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) Identification Number" Number="507" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3"/>
							<xs:maxLength value="12"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR14__AccountNumberQualifier" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Code indicating the type of account</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number Qualifier" Number="569" DataType="ID"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="3"/>
							<xs:enumeration value="DA">
								<xs:annotation>
									<xs:documentation>Demand Deposit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="SG">
								<xs:annotation>
									<xs:documentation>Savings</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR15__ReceiverOrProviderAccountNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The receiver's/provider's Bank Account Number into which payment has been or will be deposited according to the previously identified receiving depository financial institution.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Account Number" Number="508" DataType="AN"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR16__CheckIssueOrEFTEffectiveDate">
					<xs:annotation>
						<xs:documentation>Date the check was issued or the electronic funds transfer (EFT) effective date.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info Name="Date" Number="373" DataType="DT" MaximumLength="8"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="8"/>
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR17" minOccurs="0">
					<xs:annotation>
						<xs:appinfo>
							<x12:STD_Info Name="Business Function Code" Number="1048" DataType="ID"/>
							<x12:TR3_Info Used="No"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="3"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR18" minOccurs="0">
					<xs:annotation>
						<xs:appinfo>
							<x12:STD_Info Name="(DFI) ID Number Qualifier" Number="506" DataType="ID"/>
							<x12:TR3_Info Used="No"/>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
