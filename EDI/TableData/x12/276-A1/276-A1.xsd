			<xs:sequence>
				<xs:element ref="ST_TransactionSetHeader"/>
				<xs:element ref="BHT_BeginningOfHierarchicalTransaction"/>
				<xs:element ref="Loop_2000A" maxOccurs="unbounded"/>
