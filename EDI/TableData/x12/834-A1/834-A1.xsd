			<xs:sequence>
				<xs:element ref="ST_TransactionSetHeader"/>
				<xs:element ref="BGN_BeginningSegment"/>
				<xs:element ref="REF_TransactionSetPolicyNumber" minOccurs="0"/>
				<xs:element ref="DTP_FileEffectiveDate" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="QTY_TransactionSetControlTotals" minOccurs="0" maxOccurs="3"/>
