<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:x12="http://schemas.x12.org/isomorph" elementFormDefault="qualified" targetNamespace="urn:x12:schemas:008:020:835W1:HealthCareClaimPaymentAdvice" version="008020">
	<xs:annotation>
		<xs:documentation xml:lang="en">Accredited Standards Committee X12 TR3 Schema:
      008020X322</xs:documentation>
	</xs:annotation>
	<xs:annotation>
		<xs:documentation>2022 © Accredited Standards Committee X12 Incorporated, Format © 2022
      Washington Publishing Company. Exclusively published by the Washington Publishing Company. No
      part of this publication may be distributed, posted, reproduced, stored in a retrieval system,
