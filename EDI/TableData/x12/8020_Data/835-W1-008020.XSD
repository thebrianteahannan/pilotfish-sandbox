	</xs:annotation>
	<xs:element name="X12_008020X322_835W1">
		<xs:annotation>
			<xs:documentation>This X12 Transaction Set contains the format and establishes the data
        contents of the Health Care Claim Payment/Advice Transaction Set (835) for use within the
        context of the Electronic Data Interchange (EDI) environment. This transaction set can be
        used to make a payment, send an Explanation of Benefits (EOB) remittance advice, or make a
        payment and send an EOB remittance advice only from a health insurer to a health care
        provider either directly or via a financial institution.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ST_TransactionSetHeader" />
				<xs:element ref="BPR_FinancialInformation" />
				<xs:element ref="TRN_ReassociationTraceNumber" />
				<xs:element minOccurs="0" ref="CUR_ForeignCurrencyInformation" />
				<xs:element minOccurs="0" ref="REF_ReceiverIdentification" />
				<xs:element minOccurs="0" ref="REF_CardSecurityVerificationCode" />
				<xs:element minOccurs="0" ref="DTM_ProductionDate" />
				<xs:element minOccurs="0" ref="DTM_CardExpirationDate" />
				<xs:element ref="Loop_1000A" />
				<xs:element ref="Loop_1000B" />
				<xs:element maxOccurs="unbounded" minOccurs="0" ref="Loop_2000" />
				<xs:element maxOccurs="unbounded" minOccurs="0" ref="PLB_ProviderAdjustment" />
				<xs:element ref="SE_TransactionSetTrailer" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000A">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PayerIdentification_1000A" />
				<xs:element ref="N3_PayerAddress_1000A" />
				<xs:element ref="N4_PayerCityStateZIPCode_1000A" />
				<xs:element maxOccurs="3" minOccurs="0" ref="REF_AdditionalPatientInformation_1000A" />
				<xs:element minOccurs="0" ref="REF_TransactionCreatorIdentifier_1000A" />
				<xs:element maxOccurs="2" minOccurs="0" ref="PER_PayerBusinessContactInformation_1000A" />
				<xs:element maxOccurs="3" ref="PER_PayerTechnicalContactInformation_1000A" />
				<xs:element maxOccurs="2" minOccurs="0" ref="PER_PayerWebsiteContactInformation_1000A" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_1000B">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_PayeeIdentification_1000B" />
				<xs:element minOccurs="0" ref="N3_PayeeAddress_1000B" />
				<xs:element minOccurs="0" ref="N4_PayeeCityStateZIPCode_1000B" />
				<xs:element maxOccurs="3" minOccurs="0" ref="REF_PayeeAdditionalIdentification_1000B" />
				<xs:element ref="REF_PayeeTaxIdentification_1000B" />
				<xs:element minOccurs="0" ref="RDM_RemittanceDeliveryMethod_1000B" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2000">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LX_HeaderNumber_2000" />
				<xs:element minOccurs="0" ref="TS3_ProviderSummaryInformation_2000" />
				<xs:element minOccurs="0" ref="TS2_ProviderSupplementalSummaryInformation_2000" />
				<xs:element maxOccurs="unbounded" ref="Loop_2100" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2100">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CLP_ClaimPaymentInformation_2100" />
				<xs:element maxOccurs="99" minOccurs="0" ref="RAS_ClaimAdjustmentInformation_2100" />
				<xs:element ref="NM1_PatientName_2100" />
				<xs:element minOccurs="0" ref="NM1_SubscriberName_2100" />
				<xs:element maxOccurs="2" minOccurs="0" ref="NM1_CorrectedPatientSubscriberName_2100" />
				<xs:element minOccurs="0" ref="NM1_ServiceProviderName_2100" />
				<xs:element maxOccurs="10" minOccurs="0" ref="NM1_CrossoverCarrierName_2100" />
				<xs:element minOccurs="0" ref="MIA_InpatientAdjudicationInformation_2100" />
				<xs:element minOccurs="0" ref="MOA_OutpatientAdjudicationInformation_2100" />
				<xs:element maxOccurs="10" minOccurs="0" ref="REF_OtherClaimRelatedIdentification_2100" />
				<xs:element minOccurs="0" ref="REF_OriginalPayerClaimControlNumber_2100" />
				<xs:element minOccurs="0" ref="REF_ClassOfContractCode_2100" />
				<xs:element maxOccurs="3" minOccurs="0" ref="REF_ServiceProviderSecondaryIdentification_2100" />
				<xs:element maxOccurs="4" minOccurs="0" ref="REF_PaymentDeterminationMethodology_2100" />
				<xs:element ref="REF_OriginalClaimInformation_2100" />
				<xs:element maxOccurs="2" minOccurs="0" ref="REF_ClaimAuthorizationInformation_2100" />
				<xs:element maxOccurs="2" minOccurs="0" ref="DTM_StatementDates_2100" />
				<xs:element minOccurs="0" ref="DTM_CoverageExpirationDate_2100" />
				<xs:element minOccurs="0" ref="DTM_ClaimReceivedDate_2100" />
				<xs:element minOccurs="0" ref="DTM_CleanClaimDate_2100" />
				<xs:element minOccurs="0" ref="DTM_CorrectedAccidentDate_2100" />
				<xs:element minOccurs="0" ref="DTM_CorrectedOnsetOfCurrentSymptomsOrIllnessDate_2100" />
				<xs:element maxOccurs="2" minOccurs="0" ref="PER_ClaimContactInformation_2100" />
				<xs:element minOccurs="0" ref="PER_EntitySelfInsuredPlanJurisdictionContact_2100" />
				<xs:element minOccurs="0" ref="PER_WorkersCompensationPayerWebsite_2100" />
				<xs:element ref="AMT_ClaimAllowedAmount_2100" />
				<xs:element maxOccurs="12" minOccurs="0" ref="AMT_ClaimSupplementalInformation_2100" />
				<xs:element maxOccurs="14" minOccurs="0" ref="QTY_ClaimSupplementalInformationQuantity_2100" />
				<xs:element maxOccurs="99" minOccurs="0" ref="LQ_HealthCareRemarkCodes_2100" />
				<xs:element maxOccurs="10" ref="Loop_2105" />
				<xs:element maxOccurs="999" ref="Loop_2110" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2105">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="N1_CorrectedPriorityPayerName_2105" />
				<xs:element minOccurs="0" ref="NM1_OtherSubscriberName_2105" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Loop_2110">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SVC_ServicePaymentInformation_2110" />
				<xs:element maxOccurs="2" minOccurs="0" ref="DTM_ServiceDate_2110" />
				<xs:element maxOccurs="99" minOccurs="0" ref="RAS_ServiceAdjustmentInformation_2110" />
				<xs:element maxOccurs="2" minOccurs="0" ref="REF_ServiceIdentification_2110" />
				<xs:element maxOccurs="4" minOccurs="0" ref="REF_PaymentDeterminationMethodology_2110" />
				<xs:element minOccurs="0" ref="REF_LineItemControlNumber_2110" />
				<xs:element maxOccurs="3" minOccurs="0" ref="REF_ServiceProviderInformation_2110" />
				<xs:element maxOccurs="5" minOccurs="0" ref="REF_HealthCarePolicyIdentification_2110" />
				<xs:element maxOccurs="2" minOccurs="0" ref="REF_ServiceAuthorizationInformation_2110" />
				<xs:element ref="AMT_ServiceAllowedAmount_2110" />
				<xs:element maxOccurs="7" minOccurs="0" ref="AMT_ServiceSupplementalAmount_2110" />
				<xs:element maxOccurs="5" minOccurs="0" ref="QTY_ServiceSupplementalQuantity_2110" />
				<xs:element maxOccurs="99" minOccurs="0" ref="LQ_HealthCareRemarkCodes_2110" />
				<xs:element maxOccurs="32" minOccurs="0" ref="TOO_ToothInformation_2110" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ST_TransactionSetHeader">
		<xs:annotation>
			<xs:documentation>Transaction Set Header</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ST01__TransactionSetIdentifierCode">
					<xs:annotation>
						<xs:documentation>Code uniquely identifying a Transaction Set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Transaction Set Identifier Code" Number="143" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3" />
							<xs:maxLength value="3" />
							<xs:enumeration value="835">
								<xs:annotation>
									<xs:documentation>Health Care Claim Payment/Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST02__TransactionSetControlNumber">
					<xs:annotation>
						<xs:documentation>The unique identification number within a transaction
              set.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="Transaction Set Control Number" Number="329" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="4" />
							<xs:maxLength value="9" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ST03__ImplementationGuideVersionName">
					<xs:annotation>
						<xs:documentation>Name of the referenced implementation guide
              version.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="Implementation Convention Reference" Number="1705" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="35" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BPR_FinancialInformation">
		<xs:annotation>
			<xs:documentation>Financial Information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BPR01__TransactionHandlingCode">
					<xs:annotation>
						<xs:documentation>This code designates whether and how the money and remittance
              information will be processed.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Transaction Handling Code" Number="305" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="2" />
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Payment Accompanies Remittance Advice</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="D">
								<xs:annotation>
									<xs:documentation>Make Payment Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="H">
								<xs:annotation>
									<xs:documentation>Notification Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="I">
								<xs:annotation>
									<xs:documentation>Remittance Information Only</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="K">
								<xs:annotation>
									<xs:documentation>Reimbursement to Follow</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="P">
								<xs:annotation>
									<xs:documentation>Prenotification of Future Transfers</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="U">
								<xs:annotation>
									<xs:documentation>Split Payment and Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="X">
								<xs:annotation>
									<xs:documentation>Handling Party's Option to Split Payment and
                    Remittance</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR02__TotalActualProviderPaymentAmount">
					<xs:annotation>
						<xs:documentation>The actual payment to the provider for this batch, transaction, or
              summary.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="R" MaximumLength="18" Name="Monetary Amount" Number="782" />
							<x12:TR3_Info MaximumLength="11" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="20" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR03__CreditOrDebitFlagCode">
					<xs:annotation>
						<xs:documentation>Code indicating whether amount is a credit or debit</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Credit/Debit Flag Code" Number="478" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="1" />
							<xs:enumeration value="C">
								<xs:annotation>
									<xs:documentation>Credit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="D">
								<xs:annotation>
									<xs:documentation>Debit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BPR04__PaymentMethodCode">
					<xs:annotation>
						<xs:documentation>Code identifying the method for the movement of payment
              instructions.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Payment Method Code" Number="591" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3" />
							<xs:maxLength value="3" />
							<xs:enumeration value="ACH">
								<xs:annotation>
									<xs:documentation>Automated Clearing House (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="BOP">
								<xs:annotation>
									<xs:documentation>Financial Institution Option</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CCC">
								<xs:annotation>
									<xs:documentation>Credit Card</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CHK">
								<xs:annotation>
									<xs:documentation>Check</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="DEB">
								<xs:annotation>
									<xs:documentation>Debit Card</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="FWT">
								<xs:annotation>
									<xs:documentation>Federal Reserve Funds/Wire Transfer -
                    Nonrepetitive</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="NON">
								<xs:annotation>
									<xs:documentation>Non-Payment Data</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR05__PaymentFormatCode">
					<xs:annotation>
						<xs:documentation>Type of format chosen to send payment</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Payment Format Code" Number="812" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="10" />
							<xs:enumeration value="CCP">
								<xs:annotation>
									<xs:documentation>Corporate Credit or Debit plus Addenda (CCD+)
                    (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="CTX">
								<xs:annotation>
									<xs:documentation>Corporate Trade Exchange (CTX) (ACH)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR06__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository
              Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="(DFI) ID Number Qualifier" Number="506" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2" />
							<xs:maxLength value="2" />
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9
                    digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR07__SenderDFIIdentifier">
					<xs:annotation>
						<xs:documentation>The Depository Financial Institution (DFI) identification number of
              the originator of the transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="(DFI) Identification Number" Number="507" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3" />
							<xs:maxLength value="12" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR08__AccountNumberQualifier">
					<xs:annotation>
						<xs:documentation>Code indicating the type of account</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Account Number Qualifier" Number="569" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="3" />
							<xs:enumeration value="DA">
								<xs:annotation>
									<xs:documentation>Demand Deposit</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR09__SenderBankAccountNumber">
					<xs:annotation>
						<xs:documentation>The sender's bank account number at the Originating Depository
              Financial Institution.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="Account Number" Number="508" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="35" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR10__PayerIdentifier">
					<xs:annotation>
						<xs:documentation>Number identifying the payer organization.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="Originating Company Identifier" Number="509" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="10" />
							<xs:maxLength value="10" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR11__OriginatingCompanySupplementalCode">
					<xs:annotation>
						<xs:documentation>Number identifying a further subdivision within the entity originating
              the transaction.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="Originating Company Supplemental Code" Number="510" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="9" />
							<xs:maxLength value="9" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR12__DepositoryFinancialInstitutionDFIIdentificationNumberQualifier">
					<xs:annotation>
						<xs:documentation>Code identifying the type of identification number of Depository
              Financial Institution (DFI).</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="(DFI) ID Number Qualifier" Number="506" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2" />
							<xs:maxLength value="2" />
							<xs:enumeration value="01">
								<xs:annotation>
									<xs:documentation>ABA Transit Routing Number Including Check Digits (9
                    digits)</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="04">
								<xs:annotation>
									<xs:documentation>Canadian Bank Branch and Institution Number</xs:documentation>
								</xs:annotation>
							</xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR13__ReceiverOrProviderBankIDNumber">
					<xs:annotation>
						<xs:documentation>The American Banking Association Identification Number used to
              identify the receiving depository financial institution or provider's bank within the
              Federal Reserve System when an EFT is being sent.</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="AN" Name="(DFI) Identification Number" Number="507" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="3" />
							<xs:maxLength value="12" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="BPR14__AccountNumberQualifier">
					<xs:annotation>
						<xs:documentation>Code indicating the type of account</xs:documentation>
						<xs:appinfo>
							<x12:STD_Info DataType="ID" Name="Account Number Qualifier" Number="569" />
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1" />
							<xs:maxLength value="3" />
							<xs:enumeration value="DA">
								<xs:annotation>
