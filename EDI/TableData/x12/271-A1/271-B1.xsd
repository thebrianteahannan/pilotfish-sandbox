	<xs:element name="X12_005010X279A1_271B1">
		<xs:annotation>
			<xs:documentation>This X12 Transaction Set contains the format and establishes the data contents of the Eligibility, Coverage or Benefit Information Transaction Set (271) for use within the context of an Electronic Data Interchange (EDI) environment. This transaction set can be used to communicate information about or changes to eligibility, coverage or benefits from information sources (such as - insurers, sponsors, payors) to information receivers (such as - physicians, hospitals, repair facilities, third party administrators, governmental agencies). This information includes but is not limited to: benefit status, explanation of benefits, coverages, dependent coverage level, effective dates, amounts for co-insurance, co-pays, deductibles, exclusions and limitations.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ST_TransactionSetHeader"/>
				<xs:element ref="BHT_BeginningOfHierarchicalTransaction"/>
				<xs:element ref="Loop_2000A" maxOccurs="unbounded"/>
				<xs:element ref="SE_TransactionSetTrailer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
