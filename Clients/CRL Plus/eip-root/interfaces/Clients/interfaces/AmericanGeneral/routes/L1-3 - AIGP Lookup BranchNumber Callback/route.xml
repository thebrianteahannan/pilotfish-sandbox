<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2026-06-29T13:18:28-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="AmericanGeneral.L1-3 - AIGP Lookup BranchNumber Callback.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>false</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="AIG.L1-3 - AIGP Lookip Branch Number Callback Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
        <TransactionLoggingAllowedLoggedAttributes>[eip_pair:Transaction Resubmit Attribute:eip_name:com.pilotfish.Dashboard.ResubmissionOriginalTxID:eip_value]</TransactionLoggingAllowedLoggedAttributes>
        <TransactionLoggingLogAllAttributes>true</TransactionLoggingLogAllAttributes>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="AIG.L1-3 - Store lookupResults">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>lookupResults</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="AIG.L1-3- Evaluate SQL Result">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:#results=getAttribute('lookupResults'),(#results != null &amp;&amp; #results.contains('&lt;BRORDNO&gt;'))}</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:teledexRemoteNo:eip_name://REMOTENO:eip_value][eip_pair:teledexRemoteID:eip_name://REMOTEID:eip_value][eip_pair:teledexOrderNumber:eip_name://BRORDNO:eip_value]</XPathExpressions>
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>true</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="AmericanGeneral.L1 - AIGP Legacy 1122 Status or Result.Processor-Copy-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>AmericanGeneral.L1-3 - AIGP Lookup BranchNumber Callback</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="AmericanGeneral.L1-3 - AIGP Lookup BranchNumber Callback.Processor-Copy-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="AIGP.L1-3 Sync Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Restore previousContents">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>previousContents</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="Remote previousContents">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:previousContents:eip_name:no longer needed:eip_value][eip_pair:lookupResults:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

