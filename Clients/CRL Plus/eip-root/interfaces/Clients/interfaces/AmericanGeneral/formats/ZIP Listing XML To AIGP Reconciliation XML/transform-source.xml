<?xml version="1.0" encoding="UTF-8"?>
<formatWrapper>
	<formatBuilderData>
		<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pf="http://com.pilotfish/eip/gui/mapper/formats/FormatToXsdWriter">
			<xsd:element name="FileList" type="FileList_type" />
			<xsd:complexType name="File_type">
				<xsd:sequence>
					<xsd:element form="unqualified" maxOccurs="1" minOccurs="1" name="FileName" type="xsd:string" />
					<xsd:element form="unqualified" maxOccurs="1" minOccurs="1" name="FilePath" type="xsd:string" />
					<xsd:element form="unqualified" maxOccurs="1" minOccurs="1" name="FileSize" type="xsd:string" />
					<xsd:element form="unqualified" maxOccurs="1" minOccurs="1" name="LastModified" type="xsd:string" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="FileList_type">
				<xsd:sequence>
					<xsd:element form="unqualified" maxOccurs="unbounded" minOccurs="1" name="File" type="File_type" />
				</xsd:sequence>
			</xsd:complexType>
		</xsd:schema>
	</formatBuilderData>
</formatWrapper>

