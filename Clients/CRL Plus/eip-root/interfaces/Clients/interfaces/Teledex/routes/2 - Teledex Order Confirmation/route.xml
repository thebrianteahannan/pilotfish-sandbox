<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="From Normalization">
    <FormatProfile name="Normalized 121 to Teledex Order Confirmation" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="Teledex Success Response Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="RestoreOriginal121">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.original.txt</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source name="System Unnamed">
    <FormatProfile name="Normailzed 121to Teledex Failure Response" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="Teledex Failure Response Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Get TransRefGUID">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute("com.pilotfish.crl.original.txt")!=null &amp;&amp; getAttribute("com.pilotfish.crl.original.txt").length()&gt;20}</ExecuteProcessor>
          <AttributeName>TransRefGUID</AttributeName>
          <Expression>{ognl:#text = getAttribute("com.pilotfish.crl.original.txt"), #start = #text.indexOf("TransRefGUID&gt;") + "TransRefGUID&gt;".length(), #end = #text.indexOf("&lt;", #start), (#start&gt;0 &amp;&amp; #end&gt;#start) ? #text.substring(#start, #end) : ""}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="SetErrorTransactionAttributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:error.exceptionMessage:eip_name://err:exceptionMessage:eip_value][eip_pair:error.rootExceptionMessage:eip_name://err:rootExceptionMessage:eip_value][eip_pair:error.exceptionTrace:eip_name://err:exceptionTrace:eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:err:eip_name:http://www.pilotfishtechnology.com/eip/RouteErrorReport:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="RestoreOriginalText">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute("com.pilotfish.crl.original.txt")!=null &amp;&amp; getAttribute("com.pilotfish.crl.original.txt").length()&gt;20}</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.original.txt</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="Response to Client">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Teledex Order Confirmation.Synchronous Response Transport" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="SetArchiveDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>$$archive.dir</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="SetArchiveSubDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>{ognl:getAttribute("archive.dir")+"/"+getAttribute("sourceClient")+"/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="CreateArchiveSubdir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute("archive.dir")}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Create Folder</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="ArchiveResponseFile">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:getAttribute("archive.dir")}</TargetDirectory>
          <TargetFileName>{ognl:"121Response-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID() +".xml"}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEscapingProcessor" name="Teledex.2 - Teledex Order Confirmation.Processor">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <XPath>//*[local-name()='SubmitOrderDataResult']</XPath>
          <Direction>Escape</Direction>
          <Namespaces />
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

