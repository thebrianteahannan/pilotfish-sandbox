  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Teledex.1 - Load in FlowNet" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>skipTeledex</Name>
              <Operator>=</Operator>
              <Value>true</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Retry Incoming Order" />
          </Targets>
          <Condition>
            <Expression>
              //ORDERNO[contains(.,'ERROR') and substring-after(.,'-')&lt;3]
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Send Error Notice" />
          </Targets>
          <Condition>
            <Expression>
              //ORDERNO[contains(.,'ERROR') and substring-after(.,'-')=3]
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Teledex.1 - Load in FlowNet" />
          </Targets>
          <Condition>
            <And>
              <Attribute>
                <Name>acordDoctype</Name>
                <Operator>=</Operator>
                <Value>103</Value>
              </Attribute>
              <Attribute>
                <Name>teledexOrder</Name>
                <Operator>exists</Operator>
                <Value />
              </Attribute>
            </And>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Teledex.1 - Stage Incoming Order.Directory / File Transport" />
            <TransportTarget name="Teledex.1 - Load in FlowNet" />
            <TransportTarget name="Stage 103 File For Teledex" />
          </Targets>
          <Condition>
            <And>
              <Attribute>
                <Name>acordDoctype</Name>
                <Operator>=</Operator>
                <Value>103</Value>
              </Attribute>
              <Attribute>
                <Name>teledexOrder</Name>
                <Operator>does not exist</Operator>
                <Value />
              </Attribute>
            </And>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Teledex.1 - Load in FlowNet" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>teledexOrder</Name>
              <Operator>exists</Operator>
              <Value />
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Teledex.1 - Stage Incoming Order.Directory / File Transport" />
            <TransportTarget name="Teledex.1 - Load in FlowNet" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>teledexOrder</Name>
              <Operator>does not exist</Operator>
              <Value />
            </Attribute>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
