<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Error Handling">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" name="TDEX.2 - Generate Teledex DB Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <PollingInterval>600</PollingInterval>
        <PollingDirectory>$$TeledexStagingDirectory</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction />
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Move</PostProcessOperation>
        <TargetDirectory>{ognl:#properties.get('archive.dir')+"/TELEDEX/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())+"/DBF-XML"}</TargetDirectory>
        <Tokenizers />
        <SerializedTransactionsTag>500</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>10</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>true</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XMLWrapProcessor" name="Teledex.2 - Wrap XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <ROOT_ELEMENT_NAME_TAG>XCSData</ROOT_ELEMENT_NAME_TAG>
          <USE_CDATA_TAG>false</USE_CDATA_TAG>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="TDEX.3 set dbf.archive.dir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>dbf.archive.dir</AttributeName>
          <Expression>{ognl:#properties.get('archive.dir')+"/TELEDEX/"+new java.text.SimpleDateFormat('yyyy-MM/MMddHHmm').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="TDEX.3 - Create dbf.archive.dir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('dbf.archive.dir')}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Create Folder</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="TDEX.3 - Move Archive Folder">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:#properties.get('archive.dir')+"/TELEDEX/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())+"/DBF-XML"}</FileName>
          <Overwrite>true</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Move</PostProcessOperation>
          <TargetDirectory>{ognl:getAttribute('dbf.archive.dir')}</TargetDirectory>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="Store a local copy of the DBF">
    <FormatProfile name="Teledex Combined XML Format" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Teledex.2 - Generate Teledex DB.Directory / File Transport" retries="1">
      <ModuleConfig>
        <TargetDirectory>{ognl:getAttribute('dbf.archive.dir')}</TargetDirectory>
        <FileName>{ognl:"HHP"+new java.text.SimpleDateFormat("MMddHHmm").format(new java.util.Date())}</FileName>
        <FileExtension>994</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Create New</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.custom.dbf.DBFOutputProcessor" name="Teledex.2 - Generate Teledex DB File">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target name="Upload to SFTP Server">
    <FormatProfile name="Teledex Combined XML Format" />
    <Transport class="com.pilotfish.eip.modules.file.ftp.FTPTransport" name="SFTP Server" retries="40" retryDelayMs="15000">
      <ModuleConfig>
        <FTPTransportType>Encrypted FTP (SSH/SFTP)</FTPTransportType>
        <Host>$$TeledexDBFSFTPHost</Host>
        <Port>22</Port>
        <TargetDirectory>$$TeledexDBFSFTPDirectory</TargetDirectory>
        <FileName>{ognl:"HHP"+new java.text.SimpleDateFormat("MMddHHmm").format(new java.util.Date())}</FileName>
        <FileExtension>994</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <Timeout>300</Timeout>
        <Sftp_SocketTimeout>300</Sftp_SocketTimeout>
        <RetryConnection>true</RetryConnection>
        <RetryDelay>15</RetryDelay>
        <KeepConnection>false</KeepConnection>
        <UsePassiveMode>true</UsePassiveMode>
        <SSLProtocol>TLS</SSLProtocol>
        <Protection>Private (P)</Protection>
        <FileType>Binary</FileType>
        <AppendToFile>false</AppendToFile>
        <Overwrite>false</Overwrite>
        <CheckForFileAfterWriting>false</CheckForFileAfterWriting>
        <FAIL_ON_FALSE_RESULT>true</FAIL_ON_FALSE_RESULT>
        <WriteFromHome>false</WriteFromHome>
        <UserName>$$TeledexDBFSFTPUsername</UserName>
        <Password>$$TeledexDBFSFTPPassword</Password>
        <KeyAuthentication>false</KeyAuthentication>
        <KeyFileName />
        <UseKeyStore>false</UseKeyStore>
        <KeyStoreFilePath />
        <KeyStoreFileType />
        <KeyStoreFilePassword />
        <UseTrustStore>false</UseTrustStore>
        <TrustStoreFilePath />
        <TrustStoreFileType />
        <TrustStoreFilePassword />
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.custom.dbf.DBFOutputProcessor" name="Teledex.3 - Generate Teledex DB.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.internal.ListenerTriggeringProcessor" name="TDEX.3 - Trigger TDEX.4">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <ServiceName>Clients.Teledex.4 - Upload Erie 103 Files::TDEX.4 - Upload Erie 103 Files Listener</ServiceName>
          <RUN_ONCE>true</RUN_ONCE>
          <ENABLE_LISTENER_ACTION>false</ENABLE_LISTENER_ACTION>
          <DISABLE_LISTENER_ACTION>false</DISABLE_LISTENER_ACTION>
          <ACTION_WAIT_TIME>30</ACTION_WAIT_TIME>
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
</Route>

