<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-02-13T15:19:18-05:00" ModifiedBy="aramos@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="AXA.3-DeleteFile" />
          </Targets>
          <Condition>
            <Expression>
              /File[string-length(FileName)&gt;0 and number(DaysOld)&gt;30]
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="AXA.3 - Keep newer file" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="AXA_3_ForkOnSingleFile" />
    <Listener class="com.pilotfish.eip.modules.internal.NullListener" enabled="true" name="AXA.3-GetFTPListing">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <PollingInterval>86400</PollingInterval>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.ftp.JschListingProcessor" name="AXA.3-FTP Listing">
        <ModuleConfig>
          <Host>$$Axa1122FTPHost</Host>
          <Port>22</Port>
          <Timeout>300</Timeout>
          <SocketTimeout>300</SocketTimeout>
          <UserName>$$Axa1122FTPUsername</UserName>
          <Password>$$Axa1122FTPPassword</Password>
          <TargetDirectory>$$Axa1122FTPDirectory</TargetDirectory>
          <UseChangeDirectoryCommand>false</UseChangeDirectoryCommand>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="AXA.3-AddDaysOld">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>AddDaysOld.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTVersion>1.0</XSLTVersion>
          <XSLTEngine>Xalan (Interpreted)</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.other.NullTransport" name="AXA.3-DeleteFile" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="AXA.3-set Filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:Filename:eip_name:/File/FileName:eip_value]</XPathExpressions>
          <Namespaces>null</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.ftp.JschSingleFileProcessor" name="AXA.3-DeleteSftpFile">
        <ModuleConfig>
          <Host>$$Axa1122FTPHost</Host>
          <Port>22</Port>
          <Timeout>300</Timeout>
          <SocketTimeout>300</SocketTimeout>
          <UserName>$$Axa1122FTPUsername</UserName>
          <Password>$$Axa1122FTPPassword</Password>
          <TargetDirectory>$$Axa1122FTPDirectory</TargetDirectory>
          <FileName>{ognl:getAttribute('Filename')}</FileName>
          <PostProcessOperation>Delete</PostProcessOperation>
          <MoveToDir />
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.other.NullTransport" name="AXA.3 - Keep newer file" retries="1" />
  </Target>
</Route>

