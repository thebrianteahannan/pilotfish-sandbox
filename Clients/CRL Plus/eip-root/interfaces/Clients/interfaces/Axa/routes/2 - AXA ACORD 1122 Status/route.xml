<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-03-03T15:42:45-05:00" ModifiedBy="aramos@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="AXA.2 Ignore Status" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Axa.2 - Append to Report" />
            <TransportTarget name="AXA.2 - Load 1122 to SFTP" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.crl.ordercompletedate')!=null and getAttribute('finalResultsDeliveredDate')==null</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="CRL Order Status DB">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="AXA ACORD 1122 Status">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Axa.2 Set normalized1122">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>normalized1122</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="AXA.2 Ignore Status" retries="1">
      <ModuleConfig>
        <ServiceName>Update Status Inbound</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="1122 to Reconciliation" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Axa.2 - Append to Report" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$AxaEquitableStagingDirectory</TargetDirectory>
        <FileName>{ognl:"HHAXA"+new java.text.SimpleDateFormat("MMddyy").format(new java.util.Date())}</FileName>
        <FileExtension>CSV</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>true</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.ftp.FTPTransport" name="AXA.2 - Load 1122 to SFTP" retries="1">
      <ModuleConfig>
        <FTPTransportType>Encrypted FTP (JSCH SSH/SFTP)</FTPTransportType>
        <Host>$$Axa1122FTPHost</Host>
        <Port>22</Port>
        <TargetDirectory>$$Axa1122FTPDirectory</TargetDirectory>
        <FileName>{ognl:"AXA-1122-"+getAttribute('flownetOrderNumber')+"-"+new java.text.SimpleDateFormat("MMddyyHHmmss").format(new java.util.Date())}</FileName>
        <FileExtension />
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <Timeout>300</Timeout>
        <Sftp_SocketTimeout>0</Sftp_SocketTimeout>
        <KeepConnection>false</KeepConnection>
        <UsePassiveMode>true</UsePassiveMode>
        <SSLProtocol>TLS</SSLProtocol>
        <Protection>Private (P)</Protection>
        <FileType>Binary</FileType>
        <AppendToFile>false</AppendToFile>
        <Overwrite>false</Overwrite>
        <CheckForFileAfterWriting>false</CheckForFileAfterWriting>
        <FAIL_ON_FALSE_RESULT>true</FAIL_ON_FALSE_RESULT>
        <WriteFromHome>false</WriteFromHome>
        <UserName>$$Axa1122FTPUsername</UserName>
        <Password>$$Axa1122FTPPassword</Password>
        <KeyAuthentication>false</KeyAuthentication>
        <KeyFileName />
        <UseKeyStore>false</UseKeyStore>
        <KeyStoreFilePath />
        <KeyStoreFileType />
        <KeyStoreFilePassword />
        <UseTrustStore>false</UseTrustStore>
        <TrustStoreFilePath />
        <TrustStoreFileType />
        <TrustStoreFilePassword />
      </ModuleConfig>
    </Transport>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="Axa.2 - Call DB Update Route">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>Update Status Inbound</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
</Route>

