<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2026-05-01T09:55:25-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Wait For Attachment" />
          </Targets>
          <Condition>
            <Expression>
              //acord:ReqStatus/@tc=11 and //acord:StatusEvent and not(//acord:Attachment) and not(//acord:ProviderEventCode[.='S78' or .='333' or .='334' or .='S82']) and not(//acord:StatusEventDetail[contains(.,'CNR') or .='Cancelled per customer'])
              <Namespaces>
                <Namespace name="acord">http://ACORD.org/Standards/Life/2</Namespace>
              </Namespaces>
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Bypass Delivery Archive" />
            <TransportTarget name="Upload Test Status" />
          </Targets>
          <Condition>
            <And>
              <Attribute>
                <Name>com.pilotfish.crl.testindicator</Name>
                <Operator>=</Operator>
                <Value>2</Value>
              </Attribute>
              <Expression>
                //acord:StatusEvent
                <Namespaces>
                  <Namespace name="acord">http://ACORD.org/Standards/Life/2</Namespace>
                </Namespaces>
              </Expression>
            </And>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="1122 Status or Result" />
          </Targets>
          <Condition>
            <Expression>
              //acord:StatusEvent and //acord:ProviderEventCode[. != 'S82']
              <Namespaces>
                <Namespace name="acord">http://ACORD.org/Standards/Life/2</Namespace>
              </Namespaces>
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Empty Status" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="LL.3-Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
