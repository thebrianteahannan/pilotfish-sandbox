        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <Timeout>300</Timeout>
        <Sftp_SocketTimeout>300</Sftp_SocketTimeout>
        <KeepConnection>false</KeepConnection>
        <UsePassiveMode>true</UsePassiveMode>
        <SSLProtocol>TLS</SSLProtocol>
        <Protection>Private (P)</Protection>
        <FileType>Binary</FileType>
        <AppendToFile>false</AppendToFile>
        <Overwrite>false</Overwrite>
        <CheckForFileAfterWriting>false</CheckForFileAfterWriting>
        <FAIL_ON_FALSE_RESULT>true</FAIL_ON_FALSE_RESULT>
        <WriteFromHome>false</WriteFromHome>
        <UserName>$$sftp.username</UserName>
        <Password>$$sftp.password</Password>
        <KeyAuthentication>false</KeyAuthentication>
        <KeyFileName />
        <UseKeyStore>false</UseKeyStore>
        <KeyStoreFilePath />
        <KeyStoreFileType />
        <KeyStoreFilePassword />
        <UseTrustStore>false</UseTrustStore>
        <TrustStoreFilePath />
        <TrustStoreFileType />
        <TrustStoreFilePassword />
        <RetryDelay>1</RetryDelay>
        <SetFileTime>true</SetFileTime>
        <RetryConnection>false</RetryConnection>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="set audit.filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>audit.filename</AttributeName>
          <Expression>{ognl:'audit-outgoing-LADDER-'+getAttribute('OrderNumber')+'-'+getAttribute('ReqInfoStatus')+'-'+new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID()}</Expression>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
          <AttributePairs>[eip_pair:audit.filename:eip_name:{ognl:'audit-outgoing-FGLI-'+getAttribute('OrderNumber')+'-'+getAttribute('ReqInfoStatus')+'-'+new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID()}:eip_value]</AttributePairs>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.PauseProcessor" name="Random pause for SFTP concurrency issue">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Period>{ognl:new java.util.Random().nextDouble()*15+1}</Period>
        </ModuleConfig>
      </Processor>
    </Processors>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="PacificLife.3 - Post upload - update status">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>Update Status Inbound</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
