<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-10-30T08:41:25-05:00" ModifiedBy="ntpfish-pvl1@crlcorp.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="PRUX ACORD 121 Order Confirmation.Synchronous Response" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>com.pilotfish.eip.synchronousResponseTicket</Name>
              <Operator>exists</Operator>
              <Value />
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="PRUX.2-Store Error" />
          </Targets>
          <Condition>
            <Expression>
              //ns2:ResultCode/@tc=5
              <Namespaces>
                <Namespace name="ns2">http://ACORD.org/Standards/Life/2</Namespace>
              </Namespaces>
            </Expression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Advanced Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>false</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
        <MonitorTransports>false</MonitorTransports>
        <IgnoreListenerErrorPeriod>900</IgnoreListenerErrorPeriod>
        <DataIDOGNLExpression>{ognl:#transaction.getTransactionID()}</DataIDOGNLExpression>
        <IgnoreTransportErrorPeriod>900</IgnoreTransportErrorPeriod>
        <MonitorListeners>false</MonitorListeners>
        <DeDuplicateErrorPeriod>86400</DeDuplicateErrorPeriod>
        <IgnoreStageErrorPeriod>900</IgnoreStageErrorPeriod>
        <CollectDataIDs>true</CollectDataIDs>
        <MonitorStages>true</MonitorStages>
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="From Normalization">
    <FormatProfile name="Normalized 121 to PRUX Order Confirmation" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="PRUX Success Response Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="RestoreOriginal121">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.original.txt</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source icon="" name="Error Route">
    <FormatProfile name="Normalized 121 to PRUX Failure Response" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="PRUX Failure Response Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Get TransRefGUID">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute("com.pilotfish.crl.original.txt")!=null &amp;&amp; getAttribute("com.pilotfish.crl.original.txt").length()&gt;20}</ExecuteProcessor>
          <AttributeName>TransRefGUID</AttributeName>
          <Expression>{ognl:#text = getAttribute("com.pilotfish.crl.original.txt"), #start = #text.indexOf("TransRefGUID&gt;") + "TransRefGUID&gt;".length(), #end = #text.indexOf("&lt;", #start), (#start&gt;0 &amp;&amp; #end&gt;#start) ? #text.substring(#start, #end) : ""}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="SetErrorTransactionAttributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:error.exceptionMessage:eip_name://err:exceptionMessage:eip_value][eip_pair:error.rootExceptionMessage:eip_name://err:rootExceptionMessage:eip_value][eip_pair:error.exceptionTrace:eip_name://err:exceptionTrace:eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:err:eip_name:http://www.pilotfishtechnology.com/eip/RouteErrorReport:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="RestoreOriginalText">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute("com.pilotfish.crl.original.txt")!=null &amp;&amp; getAttribute("com.pilotfish.crl.original.txt").length()&gt;20}</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.original.txt</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="Response to Client">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="PRUX ACORD 121 Order Confirmation.Synchronous Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX SetArchiveDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>$$archive.dir</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX SetArchiveSubDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>{ognl:getAttribute("archive.dir")+"/"+getAttribute("sourceClient")+"/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="PRUX CreateArchiveSubdir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute("archive.dir")}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Create Folder</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="PRUX ArchiveResponseFile">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:getAttribute("archive.dir")}</TargetDirectory>
          <TargetFileName>{ognl:"121Response-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID() +"-"+ getAttribute('com.pilotfish.FileName') +((getAttribute('insert.order.error')==null &amp;&amp; getAttribute('error.exceptionMessage')==null)?'-SUCCESS':'-FAIL') +".xml"}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.2-set reponse code success">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>{ognl:#insertError=getAttribute('insert.order.error'),#exception=getAttribute('error.exceptionMessage'),(#insertError!=null)?'400':(#exception!=null)?'500':'200'}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="PRUX.2-Store Error" retries="1">
      <ModuleConfig>
        <ServiceName>V2 - Other Inbound Error Listener</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.2-set reponse code 500">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>500</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

