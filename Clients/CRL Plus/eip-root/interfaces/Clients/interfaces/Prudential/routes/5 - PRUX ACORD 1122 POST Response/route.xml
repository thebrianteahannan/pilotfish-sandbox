<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-01-18T15:25:36-05:00" ModifiedBy="aramos@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Archive 1122 SOAP Response" />
            <TransportTarget name="PRUX Mark status sent in Database" />
          </Targets>
          <Condition>
            <Expression>
              /soapenv:Envelope/soapenv:Body/*[local-name() = 'TXLife']/*[local-name() = 'TXLifeResponse']/*[local-name() = 'TransResult']/*[local-name() = 'ResultCode']/text() = 'Success'
              <Namespaces>
                <Namespace name="soapenv">http://schemas.xmlsoap.org/soap/envelope/</Namespace>
              </Namespaces>
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Retry if ResultCode not successful" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('Retry.Count')&lt;8</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Exceeded Retry Count" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Advanced Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>false</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
        <MonitorTransports>false</MonitorTransports>
        <IgnoreListenerErrorPeriod>900</IgnoreListenerErrorPeriod>
        <DataIDOGNLExpression>{ognl:#transaction.getTransactionID()}</DataIDOGNLExpression>
        <IgnoreTransportErrorPeriod>900</IgnoreTransportErrorPeriod>
        <MonitorListeners>false</MonitorListeners>
        <DeDuplicateErrorPeriod>86400</DeDuplicateErrorPeriod>
        <IgnoreStageErrorPeriod>900</IgnoreStageErrorPeriod>
        <CollectDataIDs>true</CollectDataIDs>
        <MonitorStages>true</MonitorStages>
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="PRUX Result Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="PRUX Result SOAP POST">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Archive 1122 SOAP Response" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$archive.dir</TargetDirectory>
        <FileName>{ognl:"PRUX/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())+"/1122-post-response-"+new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID()}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>true</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="PRUX Mark status sent in Database" retries="3" retryDelayMs="60000">
      <ModuleConfig>
        <ServiceName>Update Status Inbound</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.FileDeletionProcessor" name="PRUX4 - Delete staged outbound file">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('delete.if.successfully.delivered')}</FileName>
          <ExceptionOnFailure>true</ExceptionOnFailure>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX4 set stagedBatchName">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.stagedBatchName</AttributeName>
          <Expression>{ognl:getAttribute('com.pilotfish.SourceFile').getParentFile().getName()}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX4 set stagedBatchName-Copy-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.stagedBatchName</AttributeName>
          <Expression>PRUX</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX4 set com.pilotfish.crl.statustype">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.statustype</AttributeName>
          <Expression>batch</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX4 set zipBatchName">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>zip.filename</AttributeName>
          <Expression>{ognl:new java.text.SimpleDateFormat('yyyy-MM-dd HH:mm:ss').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="Retry if ResultCode not successful" retries="1">
      <ModuleConfig>
        <ServiceName>PRUX Pickup File For Retry Listener</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.PauseProcessor" name="PRUX Set time for retry">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Period>900</Period>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX Increase retry count">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Retry.Count</AttributeName>
          <Expression>{ognl:@java.lang.Integer@parseInt(getAttribute('Retry.Count'))+1}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.email.EmailTransport" name="Exceeded Retry Count" retries="1">
      <ModuleConfig>
        <Host>$$mail.server</Host>
        <UserName />
        <Password />
        <Port>25</Port>
        <SSLEnabled>false</SSLEnabled>
        <StartTLS>false</StartTLS>
        <SendFrom>$$mail.errors.from</SendFrom>
        <ReplyTo />
        <SendTo>$$mail.errors.to</SendTo>
        <Subject>{ognl:'PRUX - Failed to POST 1122 message on ' + #properties.get('crl.environment') + '. Outbound file: ' + getAttribute('staged.outbound.filename')}</Subject>
        <DataInAttachment>false</DataInAttachment>
        <AttachmentFilename>data.dat</AttachmentFilename>
        <MIMEType>text/plain</MIMEType>
        <ENCRYPT_MESSAGE>false</ENCRYPT_MESSAGE>
        <DNS_FIND_CERT>false</DNS_FIND_CERT>
        <PathToCertificate />
        <SIGN_MESSAGE>false</SIGN_MESSAGE>
        <PathToPemFile />
        <PrivateKeyName />
        <PrivateKeyPassword />
      </ModuleConfig>
    </Transport>
  </Target>
</Route>

