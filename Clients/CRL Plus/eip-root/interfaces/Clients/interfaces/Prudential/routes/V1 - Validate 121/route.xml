<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Unsuccessful Validation" />
          </Targets>
          <Condition>
            <Expression>
              /Messages/Message[@level="error"]
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Successful Validation" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="ROOT.3 - 121 Normalization.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>V2 - Transaction Error Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="From Doc Source">
    <FormatProfile name="121 Data Validation" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="Prudential 121 Validate Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Prudential.V1 - set Incoming121XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming121XML</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Prudential.V1 - set Incoming121DOM">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming121DOM</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>true</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Prudential.V1 - Validate 121.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:PolNumber:eip_name:/ns1:TXLife/ns1:TXLifeRequest/ns1:OLifE/ns1:Holding/ns1:Policy/ns1:PolNumber:eip_value][eip_pair:ReqCodeTC:eip_name:/ns1:TXLife/ns1:TXLifeRequest/ns1:OLifE/ns1:Holding/ns1:Policy/ns1:RequirementInfo/ns1:ReqCode/@tc:eip_value][eip_pair:ReqCodeText:eip_name:/ns1:TXLife/ns1:TXLifeRequest/ns1:OLifE/ns1:Holding/ns1:Policy/ns1:RequirementInfo/ns1:ReqCode:eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:ns1:eip_name:http://ACORD.org/Standards/Life/2:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="Process Order">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="Successful Validation" retries="1">
      <ModuleConfig>
        <ServiceName>Source Document Listener</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Prudential.V1 - Restore 121">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming121XML</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="Prudential.V1 - remove attrs">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:Incoming121XML:eip_name:restored to transaction data:eip_value][eip_pair:Incoming121DOM:eip_name:not needed anymore:eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Prudential.V1 - set validated 121">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>validated.121</AttributeName>
          <Expression>true</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target name="Pridential.V2 route">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="Unsuccessful Validation" retries="1">
      <ModuleConfig>
        <ServiceName>V2 - Validation Results Listener</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Prudential.V1 - Set validation errors">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>validation.errors</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>true</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set validated false">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>validated.121</AttributeName>
          <Expression>false</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Description>&lt;h1&gt;
      121 Normalization
    &lt;/h1&gt;
    &lt;h2&gt;
      Overview:
    &lt;/h2&gt;
    &lt;p&gt;
      The 121 Normalization route listens for a non-normalized Acord 121 
      document format and applies XSLT to transform it into a normalized 
      format able to be read by CRL's inhouse information systems.
    &lt;/p&gt;
    &lt;p&gt;
      
    &lt;/p&gt;
    &lt;h2&gt;
      Source:
    &lt;/h2&gt;
    &lt;p&gt;
      The two possible sources for this route are the Document Type Discovery 
      route, in the case of Acord 121, or the Incoming to Standard 121, in the 
      case of Acord 103 or Nailba.
    &lt;/p&gt;
    &lt;p&gt;
      
    &lt;/p&gt;
    &lt;h2&gt;
      Listener:
    &lt;/h2&gt;
    &lt;p&gt;
      A programmable listener is called from a previous route containing a 
      non-normalized Acord 121 document in the transaciton body. The listener 
      forwards the transaction to the Acord 121 Attachments route to strip any 
      inline attachments prior to any transformation taking place.
    &lt;/p&gt;
    &lt;p&gt;
      
    &lt;/p&gt;
    &lt;h2&gt;
      Source Transform:
    &lt;/h2&gt;
    &lt;p&gt;
      The document is transformed into a normalized Acord 121 format by 
      appying the &amp;quot;ToStandard121.xslt&amp;quot; style sheet.
    &lt;/p&gt;
    &lt;p&gt;
      
    &lt;/p&gt;
    &lt;h2&gt;
      Target Transform:
    &lt;/h2&gt;
    &lt;p&gt;
      The transaction is relayed to the Target transport that will include 
      output to a CRL in-house system.
    &lt;/p&gt;</Description>
</Route>

