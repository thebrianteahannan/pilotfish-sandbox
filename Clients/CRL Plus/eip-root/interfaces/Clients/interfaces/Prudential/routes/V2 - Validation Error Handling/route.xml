<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="V2 - Synchronous Response" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>com.pilotfish.eip.synchronousResponseTicket</Name>
              <Operator>exists</Operator>
              <Value />
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="V2 - Save Errors To Database" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="V2.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="V2 - Validation Results Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.V2-set reponse code 400">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>400</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="V2 - Transaction Error Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.V2-set reponse code 500">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>500</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="V2 - Other Inbound Error Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="Pru.V2 - No Sync Response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:com.pilotfish.eip.synchronousResponseTicket:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="To Client">
    <FormatProfile name="Generate 121 Validation Failed Response" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="V2 - Synchronous Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PRUX.V2 - Store error.response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>error.response</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.V2 SetArchiveDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>$$archive.dir</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.V2 SetArchiveSubDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>{ognl:getAttribute("archive.dir")+"/"+getAttribute("sourceClient")+"/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="PRUX.V2 CreateArchiveSubdir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute("archive.dir")}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Create Folder</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PRUX.V2 - Restore Incoming121XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming121XML</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="PRUX.V2 ArchiveIncomingFile">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:getAttribute("archive.dir")}</TargetDirectory>
          <TargetFileName>{ognl:"incoming-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID() +"-"+ getAttribute('com.pilotfish.FileName') +".xml"}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PRUX.V2 - Restore error.response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>error.response</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="PRUX.V2 ArchiveResponseFile">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:getAttribute("archive.dir")}</TargetDirectory>
          <TargetFileName>{ognl:"121Response-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID() +"-"+ getAttribute('com.pilotfish.FileName') +"-INVALID.xml"}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target name="VALIDATION_ERROR table">
    <FormatProfile name="Create SQLXML to Insert Validation Errors" />
    <Transport class="com.pilotfish.eip.modules.db.DatabaseSqlTransport" name="V2 - Save Errors To Database" retries="4" retryDelayMs="300000">
      <ModuleConfig>
        <InputFile />
        <UserName>$$db.username</UserName>
        <Password>$$db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$db.driver</JdbcDriver>
        <JdbcURL>$$db.url</JdbcURL>
        <KeepConnection>false</KeepConnection>
        <Autocommit>false</Autocommit>
        <Timeout>600</Timeout>
        <RestrictMetaDataToCatalog />
        <RestrictMetaDataToSchema>CRL_INSIGHT_TO_PFISH</RestrictMetaDataToSchema>
        <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
        <CallbackListenerName />
        <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
        <JDBCProperties>null</JDBCProperties>
        <UseConnectionPooling>false</UseConnectionPooling>
        <PermittedDBConnections>5</PermittedDBConnections>
        <LogMetadata>false</LogMetadata>
        <LogSQL>false</LogSQL>
      </ModuleConfig>
    </Transport>
  </Target>
</Route>

