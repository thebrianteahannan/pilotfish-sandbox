<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Invalid Credentials Response" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>Acord123.ValidCredentials</Name>
              <Operator>=</Operator>
              <Value>false</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Success Response" />
            <TransportTarget name="Query Order" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Prudential.5 - PRUX ACORD 123 SOAP.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.http.SoapHttpPostListener" name="Prudential 123">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <RequestPath>prux-response</RequestPath>
        <Timeout>600</Timeout>
        <TimeoutHandlingMechanism>Send timeout message</TimeoutHandlingMechanism>
        <Synchronous>true</Synchronous>
        <RequireSSL>false</RequireSSL>
        <HTTPHeaders>[eip_pair:Content-Type:eip_name:text/xml;charset=UTF-8:eip_value]</HTTPHeaders>
        <WsdlFile>HHRESPONSE.wsdl</WsdlFile>
        <WsdlContentType>application/wsdl+xml</WsdlContentType>
        <ValidateAtListenerLevel>false</ValidateAtListenerLevel>
        <USE_BASIC_AUTH>true</USE_BASIC_AUTH>
        <AUTH_FILE>$$PrudentialIncomingAuthFile</AUTH_FILE>
        <REALM>PilotFish</REALM>
        <AdditionalResources />
        <SoapVersion>Autodetect SOAP Version</SoapVersion>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract 123 Elements">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:Acord123.UserID:eip_name://response:UserID:eip_value][eip_pair:Acord123.Password:eip_name://response:PassWD:eip_value][eip_pair:Acord123.Policy:eip_name://response:Policy:eip_value][eip_pair:Acord123.Req_Info.UniqueID:eip_name://response:RequirmentInfoUniqueID:eip_value][eip_pair:Acord123.TransMode:eip_name://response:TransMode:eip_value][eip_pair:Acord123.ReqCode:eip_name://response:ReqCode:eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:SOAPENV:eip_name:http://schemas.xmlsoap.org/soap/envelope/:eip_value][eip_pair:response:eip_name:http://crlcorp.com/crlresponse:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Check Credentials">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <AttributeName>Acord123.ValidCredentials</AttributeName>
          <Expression>{ognl:#userID=getAttribute('Acord123.UserID'),#pass=getAttribute('Acord123.Password'),("wprurx1" == #userID &amp;&amp; "prur04rltime" == #pass) ? "true" : "false"}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="System Unnamed">
    <FormatProfile name="Generate 123 Fail Response" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Invalid Credentials Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.5-set reponse code 401">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>401</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target name="System Unnamed">
    <FormatProfile name="Generate 123 Success Response" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Success Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.5-set reponse code 200">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>200</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target name="System Unnamed">
    <FormatProfile name="SelectStatusDetailsForOrder" />
    <Transport class="com.pilotfish.eip.modules.db.DatabaseSqlTransport" name="Query Order" retries="1">
      <ModuleConfig>
        <InputFile />
        <UserName>$$db.username</UserName>
        <Password>$$db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$db.driver</JdbcDriver>
        <JdbcURL>$$db.url</JdbcURL>
        <KeepConnection>false</KeepConnection>
        <Autocommit>false</Autocommit>
        <Timeout>600</Timeout>
        <RestrictMetaDataToCatalog />
        <RestrictMetaDataToSchema>$$db.username</RestrictMetaDataToSchema>
        <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
        <CallbackListenerName>Trigger QueryStatus</CallbackListenerName>
        <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
        <JDBCProperties>null</JDBCProperties>
        <UseConnectionPooling>false</UseConnectionPooling>
        <PermittedDBConnections>5</PermittedDBConnections>
        <LogMetadata>false</LogMetadata>
        <LogSQL>false</LogSQL>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Archive Incoming" retries="1">
      <ModuleConfig>
        <TargetDirectory>{ognl:getAttribute('archive.directory')}</TargetDirectory>
        <FileName>{ognl:getAttribute('archive.filename')}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Create New</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.5 get archive directory">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.directory</AttributeName>
          <Expression>$$archive.dir</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.5 set archive directory">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.directory</AttributeName>
          <Expression>{ognl:getAttribute('archive.directory')+"/PRUX"}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PRUX.5 set archive filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.filename</AttributeName>
          <Expression>{ognl:"incoming-ACORD123-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss").format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

