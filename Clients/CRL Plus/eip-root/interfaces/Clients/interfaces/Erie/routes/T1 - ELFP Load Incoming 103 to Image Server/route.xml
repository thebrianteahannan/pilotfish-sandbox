<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-09-12T13:52:14-05:00" ModifiedBy="ntpfish-pvl1@crlcorp.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="Load Image File Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="T1 - Set Retry count to 0">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Retry.Count</AttributeName>
          <Expression>0</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="T1 - Base64 encode incoming data">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="T1 - Store Base64 data in attribute">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Base64_Data</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="T1 - Create temp XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Temp_XML</AttributeName>
          <Expression>&lt;INCOMING103&gt;&lt;FILEMIMETYPE&gt;application/pdf&lt;/FILEMIMETYPE&gt;&lt;FILENAME&gt;[FNAME]&lt;/FILENAME&gt;&lt;FILEDATA&gt;[FDATA]&lt;/FILEDATA&gt;&lt;/INCOMING103&gt;</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="T1 - Load Temp XML to transaction data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Temp_XML</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExProcessor" name="T1 - Set Temp XML values">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Encoding>UTF-8</Encoding>
          <REGEX_TABLE_TAG>[eip_pair:\[FNAME\]:eip_name:{ognl:@java.util.regex.Matcher@quoteReplacement(getAttribute('Incoming103_Filename'))}:eip_value][eip_pair:\[FDATA\]:eip_name:{ognl:@java.util.regex.Matcher@quoteReplacement(getAttribute('Incoming103_Base64_Data'))}:eip_value]</REGEX_TABLE_TAG>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="Erie.T1 - Remove temporary attributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:Incoming103_Base64_Data:eip_name:Not needed anymore:eip_value][eip_pair:Incoming103_Temp_XML:eip_name:Not needed anymore:eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="ELFP Retry loading 103 file">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.StaticFileProcessor" name="Erie.T1 - Reload incoming 103 file">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:#properties.get('processing.dir') + "/" + getAttribute('sourceClient') + "/" + getAttribute('Incoming103_Filename')}</FileName>
          <PostProcessOperation>Do Nothing</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="Erie.T1 - Base64 encode retry data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Erie.T1 - Store Base64 retry data in attribute">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Base64_Data</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T1 - Create retry temp XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Temp_XML</AttributeName>
          <Expression>&lt;INCOMING103&gt;&lt;FILEMIMETYPE&gt;application/pdf&lt;/FILEMIMETYPE&gt;&lt;FILENAME&gt;[FNAME]&lt;/FILENAME&gt;&lt;FILEDATA&gt;[FDATA]&lt;/FILEDATA&gt;&lt;/INCOMING103&gt;</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Erie.T1 - Load retry Temp XML to transaction data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_Temp_XML</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExProcessor" name="Erie.T1 - Set retry Temp XML values">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Encoding>UTF-8</Encoding>
          <REGEX_TABLE_TAG>[eip_pair:\[FNAME\]:eip_name:{ognl:@java.util.regex.Matcher@quoteReplacement(getAttribute('Incoming103_Filename'))}:eip_value][eip_pair:\[FDATA\]:eip_name:{ognl:@java.util.regex.Matcher@quoteReplacement(getAttribute('Incoming103_Base64_Data'))}:eip_value]</REGEX_TABLE_TAG>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T1 - Increase retry count">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Retry.Count</AttributeName>
          <Expression>{ognl:@java.lang.Integer@parseInt(getAttribute('Retry.Count'))+1}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="Erie.T1 - Remove temporary retry attributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:Incoming103_Base64_Data:eip_name:Not needed anymore:eip_value][eip_pair:Incoming103_Temp_XML:eip_name:Not needed anymore:eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Incoming 103 to SOAP" />
    <Transport class="com.pilotfish.eip.modules.http.HttpPostTransport" name="ELFP Incoming103 to CRL ImgServer" retries="1">
      <ModuleConfig>
        <TargetURL>$$imagews.store.url</TargetURL>
        <UserName />
        <AUTH_HOST_TAG />
        <AUTH_PORT_TAG />
        <Password />
        <PreemptiveAuthentication>false</PreemptiveAuthentication>
        <ResponseListener>Loading Incoming 103 SOAP Response</ResponseListener>
        <ResponseCodeHandling>Default</ResponseCodeHandling>
        <Timeout>60000</Timeout>
        <ResponseCodeList />
        <ErrorOnConnectionFailure>true</ErrorOnConnectionFailure>
        <SynchronizationKey />
        <FormElement />
        <HTTPHeaders>[eip_pair:Content-Type:eip_name:text/xml;charset=UTF-8:eip_value]</HTTPHeaders>
        <useProxy>false</useProxy>
        <proxyHost>127.0.0.1</proxyHost>
        <proxyPort>8080</proxyPort>
        <proxyUsername />
        <proxyPassword />
        <SpecifyTLS>false</SpecifyTLS>
        <TLSVersion>TLSv1.1</TLSVersion>
        <KeyStoreFilePath />
        <KeyStoreFileType />
        <KeyStoreFilePassword />
        <UseCertificateAttribute>false</UseCertificateAttribute>
        <CertificateAttribute />
        <TrustStoreFilePath />
        <TrustStoreFileType />
        <TrustStoreFilePassword />
        <UseCertificateAttribute>false</UseCertificateAttribute>
        <CertificateAttribute />
        <ReadResponseStreamAsString>true</ReadResponseStreamAsString>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Erie.T4 - Archive outgoing SOAP message-Copy-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:#properties.get('archive.dir') +"/"+getAttribute('sourceClient')+"/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())+"/ImageUpload"}</TargetDirectory>
          <TargetFileName>{ognl:getAttribute('Incoming103_Filename')+"-"+getAttribute('Incoming103_FlownetOrderNum')+"-ImageServer-Upload-Request-" + new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-SSS").format(new java.util.Date()) + ".xml"}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

