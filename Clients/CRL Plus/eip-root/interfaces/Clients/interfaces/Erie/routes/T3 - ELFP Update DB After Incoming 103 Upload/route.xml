<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="aramos@pilotfishtechnology.com" LastModificationTime="2017-03-07T12:11:58-05:00" ModifiedBy="aramos@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="SOAPResponseToDB" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="Update DB after 103 file upload">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>true</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
      </ModuleConfig>
    </Listener>
  </Source>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Directory Listener - Rerun Image SQLXML">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <PollingInterval>30</PollingInterval>
        <PollingDirectory>{ognl:#properties.get('incoming.sqlxml.input.dir') + '/ELFP'}</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction />
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>250</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>10</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.db.DatabaseSqlTransport" name="Update Attachment Table" retries="8" retryDelayMs="60000">
      <ModuleConfig>
        <InputFile />
        <UserName>$$db.username</UserName>
        <Password>$$db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$db.driver</JdbcDriver>
        <JdbcURL>$$db.url</JdbcURL>
        <KeepConnection>false</KeepConnection>
        <Autocommit>true</Autocommit>
        <Timeout>600</Timeout>
        <RestrictMetaDataToCatalog />
        <RestrictMetaDataToSchema>$$db.username</RestrictMetaDataToSchema>
        <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
        <CallbackListenerName>Link FlownetNum to DocID Listener</CallbackListenerName>
        <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
        <JDBCProperties>null</JDBCProperties>
        <UseConnectionPooling>false</UseConnectionPooling>
        <PermittedDBConnections>5</PermittedDBConnections>
        <LogMetadata>true</LogMetadata>
        <LogSQL>true</LogSQL>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T3 - Generate failed SQLXML directory name">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_SQLML_FailedDir</AttributeName>
          <Expression>{ognl:#properties.get('incoming.sqlxml.failed.dir') + "/ELFP"}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="Erie.T3 - Create failed SQLXML dir ">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('Incoming103_SQLML_FailedDir')}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Create Folder</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T3 - Set sqlxml.stage.filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>sqlxml.filename</AttributeName>
          <Expression>{ognl:"ELFP_Completion_Image_" + new java.text.SimpleDateFormat("-yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) +#transaction.getOriginatingTransactionID() + '.xml'}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Erie.T3 - Save SQLXML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>{ognl:getAttribute('Incoming103_SQLML_FailedDir')}</TargetDirectory>
          <TargetFileName>{ognl:getAttribute("sqlxml.filename")}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.file.FileOperationProcessor" name="Erie.T3 - Delete sqlxml file">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('Incoming103_SQLML_FailedDir') + '/' + getAttribute('sqlxml.filename')}</FileName>
          <Overwrite>false</Overwrite>
          <ExceptionOnFailure>false</ExceptionOnFailure>
          <PostProcessOperation>Delete</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
</Route>

