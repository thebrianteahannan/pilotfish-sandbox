<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2017-03-06T17:38:33-05:00" ModifiedBy="aramos@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="ELFP Mark Status Sent In Database" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>ErieHTTPPostStatus</Name>
              <Operator>=</Operator>
              <Value>true</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="ELFP.4 - Archive Response" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="ELFP Status or Result POST Response">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="ELFP.4 - Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEscapingProcessor" name="Erie.4 - Unescape SOAP response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XPath>/soap:Envelope/soap:Body/dell:TXlifeProcessorResponse/dell:TXlifeProcessorResult</XPath>
          <Direction>Unescape</Direction>
          <Namespaces>[eip_pair:soap:eip_name:http://www.w3.org/2003/05/soap-envelope:eip_value][eip_pair:dell:eip_name:https://www.dell.com:eip_value]</Namespaces>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Erie.4 - Get HTTP Post status">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:ErieHTTPPostStatus:eip_name:(/soap:Envelope/soap:Body/dell:TXlifeProcessorResponse/dell:TXlifeProcessorResult/ns1:TXLife/TxLifeResponse/TransResult/ResultCode/@tc='1' ) or contains(/soap:Envelope/soap:Body/dell:NoteProcessorResponse/dell:NoteProcessorResult,'Success'):eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:soap:eip_name:http://www.w3.org/2003/05/soap-envelope:eip_value][eip_pair:dell:eip_name:https://www.dell.com:eip_value][eip_pair:ns1:eip_name:http://ACORD.org/Standards/Life/2:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.4 - Set archiveDir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>ErieArvhiveDir</AttributeName>
          <Expression>{ognl:#properties.get('archive.dir')+'/ELFP/'+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.4 - Set filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>ErieArvhiveFilename</AttributeName>
          <Expression>{ognl:getAttribute('com.pilotfish.crl.statustype')+"-response-" + getAttribute('teledexRemoteID')+'-'+getAttribute('flownetOrderNumber')+'-'+getAttribute('teledexOrderNumber')+'-'+ new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID()+"-"+((getAttribute('ErieHTTPPostStatus').equals("true"))?"SUCCESS":"FAIL")}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="Filesystem">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="ELFP.4 - Archive Response" retries="1">
      <ModuleConfig>
        <TargetDirectory>{ognl:getAttribute('ErieArvhiveDir')}</TargetDirectory>
        <FileName>{ognl:getAttribute('ErieArvhiveFilename')}</FileName>
        <FileExtension>txt</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>false</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="ELFP Response - Set archive.dir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>archive.dir</AttributeName>
          <Expression>$$archive.dir</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="ELFP Mark Status Sent In Database" retries="1">
      <ModuleConfig>
        <ServiceName>Update Status Inbound</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
  </Target>
</Route>

