        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Erie.T0A - Load Temp XML to transaction data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103Image_Temp_XML</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExProcessor" name="Erie.T0A - Set Temp XML values">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Encoding>UTF-8</Encoding>
          <REGEX_TABLE_TAG>[eip_pair:\[TELEDEXNUMBER\]:eip_name:{ognl:@java.util.regex.Matcher@quoteReplacement(getAttribute('Incoming103_TeledexOrderNum'))}:eip_value]</REGEX_TABLE_TAG>
        </ModuleConfig>
      </Processor>
