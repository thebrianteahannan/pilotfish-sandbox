        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_PDF_Data</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T0A - Get Teledex Order Number">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103_TeledexOrderNum</AttributeName>
          <Expression>{ognl:getAttribute('com.pilotfish.FileName').substring(2)}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Erie.T0A - Create temp XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Incoming103Image_Temp_XML</AttributeName>
          <Expression>&lt;INCOMING103IMAGE&gt;&lt;TELEDEXNUM&gt;[TELEDEXNUMBER]&lt;/TELEDEXNUM&gt;&lt;REMOTE_ID&gt;[REMOTEID]&lt;/REMOTE_ID&gt;&lt;REMOTE_NO&gt;[REMOTENO]&lt;/REMOTE_NO&gt;&lt;POLICY&gt;[POLICYNUM]&lt;/POLICY&gt;&lt;/INCOMING103IMAGE&gt;</Expression>
