<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="PACT3-1-MergeAndReturn" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>remainingAttachments</Name>
              <Operator>=</Operator>
              <Value>0.0</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="PACT3-1-SaveAttachmentToTempDir" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="PacificLife.3-1 - PACT Combine TIFF Attachments.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="PACT3-1-ExtractAttachment">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PACT3-1-SetTempDir">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('temp.image.dir')==null}</ExecuteProcessor>
          <AttributeName>temp.image.dir</AttributeName>
          <Expression>{ognl:#properties.get('image.large.staging.dir')+'/combine-'+#transaction.getTransactionID()}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-set previous.data">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('previous.data') == null}</ExecuteProcessor>
          <AttributeName>previous.data</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-RestoreReaminingAcord">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('remaining.acord.file') != null}</ExecuteProcessor>
          <AttributeName>remaining.acord.file</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="PACT3-1-Delete remaining.acord.file attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:remaining.acord.file:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="PACT3-1-CountRemainingAttachments">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:remainingAttachments:eip_name:count(//acord:AttachmentData):eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:acord:eip_name:http://ACORD.org/Standards/Life/2:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="System Unnamed">
    <FormatProfile name="CombineTiff-ExtractFirstAttachment" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="PACT3-1-SaveAttachmentToTempDir" retries="1">
      <ModuleConfig>
        <TargetDirectory>{ognl:getAttribute('temp.image.dir')}</TargetDirectory>
        <FileName>image</FileName>
        <FileExtension>tiff</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>false</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-Set remaining.acord.file">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>remaining.acord.file</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-get acord.tiff.image">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>acord.tiff.image</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64InputProcessor" name="PACT3-1-Base64 Decode">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="PACT3-1-Delete attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:acord.tiff.image:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="PACT3-1-Loop For Next Attachment">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>PACT3-1-ExtractAttachment</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
  <Target name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="PACT3-1-MergeAndReturn" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.TIFFCombiningProcessor" name="PACT3-1-CombineTiffs">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TiffDir>{ognl:getAttribute('temp.image.dir')}</TiffDir>
          <MIMEType>image/tiff</MIMEType>
          <ImageCompression>Group 4 (CCITT4)</ImageCompression>
          <LittleEndian>true</LittleEndian>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="PACT3-1-Base64 encode">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-Set combined.tiff.base64">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.crl.paclife.mergedTiff</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="PACT3-1-Restore previous.data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>previous.data</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="PACT3-1-Delete previous.data attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:previous.data:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileDeletionProcessor" name="PACT3-1-Delete temp dir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('temp.image.dir')}</FileName>
          <ExceptionOnFailure>false</ExceptionOnFailure>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

