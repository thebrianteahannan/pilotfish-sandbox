<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2023-11-08T12:20:34-06:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="PACT1 - Invalid Creds" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>Acord123.ValidCredentials</Name>
              <Operator>=</Operator>
              <Value>false</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Doctype Route" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="PacificLife.1 - PACT ACORD 121 SOAP.Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Incoming Routes Listener</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="From Client">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.http.SoapHttpPostListener" enabled="true" name="Pacific Life">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>true</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <RequestPath>pact</RequestPath>
        <Timeout>600</Timeout>
        <TimeoutHandlingMechanism>Send timeout message</TimeoutHandlingMechanism>
        <Synchronous>true</Synchronous>
        <RequireSSL>false</RequireSSL>
        <HTTPHeaders>[eip_pair:Content-Type:eip_name:text/xml;charset=UTF-8:eip_value]</HTTPHeaders>
        <WsdlFile>ORDER.WSDL</WsdlFile>
        <WsdlContentType>application/wsdl+xml</WsdlContentType>
        <ValidateAtListenerLevel>false</ValidateAtListenerLevel>
        <USE_BASIC_AUTH>false</USE_BASIC_AUTH>
        <AUTH_FILE>auth.txt</AUTH_FILE>
        <REALM>PilotFish</REALM>
        <AdditionalResources />
        <SoapVersion>Autodetect SOAP Version</SoapVersion>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Get user/pass">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:username:eip_name://doc:Username:eip_value][eip_pair:password:eip_name://doc:Password:eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:env:eip_name:http://schemas.xmlsoap.org/soap/envelope/:eip_value][eip_pair:doc:eip_name:http://crlcorp.com/DocumentService:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Pac1-validate creds">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Acord123.ValidCredentials</AttributeName>
          <Expression>{ognl:#userID=getAttribute('username'),#pass=getAttribute('password'),#expectedUser=#properties.get('PacificLifeIncomingAuthUser'),#expectedPass=#properties.get('PacificLifeIncomingAuthPass'),#secondPass=#properties.get('PacificLifeIncomingAuthSecondPass'),((#expectedUser.equalsIgnoreCase(#userID) ) &amp;&amp; (#expectedPass == #pass || #secondPass == #pass)) ? "true" : "false"}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathValueProcessor" name="Get CRL Doc">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Namespace>http://crlcorp.com/DocumentService</Namespace>
          <ForkingXPath>//*[local-name()='OrderData']</ForkingXPath>
          <TreatAsXML>false</TreatAsXML>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - PACT ACORD 121 SOAP.Processor1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>sourceClient</AttributeName>
          <Expression>PACT</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="PacificLife.1 - set FileName">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>&lt;PolNumber&gt;(.*)&lt;/PolNumber&gt;</RegEx>
          <AttributeName>com.pilotfish.FileName</AttributeName>
          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Source icon="" name="Test directory">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="PacLife Test Dir Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>true</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>5</PollingInterval>
        <PollingDirectory>{ognl:@com.pilotfish.eip.config.EnvironmentConfigReader@getValue(#transaction,null,"inputDir") + "/PACT"}</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction />
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>250</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>10</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set sourceClient 2">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>sourceClient</AttributeName>
          <Expression>PACT</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="PacificLife.1 - set FileName-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>&lt;PolNumber&gt;(.*)&lt;/PolNumber&gt;</RegEx>
          <AttributeName>com.pilotfish.FileName</AttributeName>
          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="To Doctype Discovery">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="Doctype Route" retries="1">
      <ModuleConfig>
        <ServiceName>Source Document Listener</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - PACT ACORD 121 SOAP.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>inboundClient</AttributeName>
          <Expression>PACT</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - set defaultSourceInfoName">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>defaultSourceInfoName</AttributeName>
          <Expression>PACT</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - set defaultSourceInfoDescr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>defaultSourceInfoDescr</AttributeName>
          <Expression>Pacific Life</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - Set timeZoneConversion">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>timeZoneConversion</AttributeName>
          <Expression>2</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="PACT1 - Invalid Creds" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="PacificLife.1 - set response code">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.HTTPResponseCode</AttributeName>
          <Expression>500</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.StaticFileProcessor" name="PacificLife.1 - load invalid creds response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>invalid-creds-response.xml</FileName>
          <PostProcessOperation>Do Nothing</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Description>&lt;h1&gt;
      Web Service to Inbound Route
    &lt;/h1&gt;
    &lt;h2&gt;
      Overview:
    &lt;/h2&gt;
    &lt;p&gt;
      The Web Service to Inbound Route listens for a SOAP web service request, 
      as defined in &amp;quot;Order.wsdl&amp;quot;, authenticates the request based on supplied 
      credentials, parses out the encapsulated CRL Order, and passes that 
      order to the Document Type Discovery route.
    &lt;/p&gt;
    &lt;h2&gt;
      
    &lt;/h2&gt;
    &lt;h2&gt;
      Listener:
    &lt;/h2&gt;
    &lt;p&gt;
      The listener is a SOAP Web Service listener configured to conform to 
      Order.wsdl. The inbound SOAP envelope must contain a username and 
      password. The username and password are parsed, the password converted 
      to a hash format, then authenticated, via a Database Authenticator, 
      against a CRL database containing customer credentials. If the 
      authentication is successful, the CRL order is stripped from the SOAP 
      envelope at which point the encapsulating envelope data is discarded.
    &lt;/p&gt;
    &lt;h2&gt;
      
    &lt;/h2&gt;
    &lt;h2&gt;
      Source Transform/Route/Target Transform:
    &lt;/h2&gt;
    &lt;p&gt;
      Relay the extracted CRL order document.
    &lt;/p&gt;
    &lt;p&gt;
      
    &lt;/p&gt;
    &lt;h2&gt;
      Transport:
    &lt;/h2&gt;
    &lt;p&gt;
      The remaining document is then relayed through the remainder of the 
      route and passed to the Document Type Discovery route. Additionally, a 
      Synchronout Response transport will send a response back to the 
      requestor containing an HTTP status code.
    &lt;/p&gt;</Description>
</Route>

