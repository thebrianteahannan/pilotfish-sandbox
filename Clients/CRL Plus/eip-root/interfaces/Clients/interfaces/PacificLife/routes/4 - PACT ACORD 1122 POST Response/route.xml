<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="PACT Mark Status Sent In Database" />
          </Targets>
          <Condition>
            <Or>
              <Expression>
                /soap:Envelope/soap:Body/req:HandleRequestResponse/req:HandleRequestResult[*[local-name()='ErrorCode']='0']
                <Namespaces>
                  <Namespace name="soap">http://schemas.xmlsoap.org/soap/envelope/</Namespace>
                  <Namespace name="req">http://tempuri.org/</Namespace>
                </Namespaces>
              </Expression>
              <Attribute>
                <Name>OrderIsReported</Name>
                <Operator>=</Operator>
                <Value>true</Value>
              </Attribute>
            </Or>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="PACT Archive 1122 POST Response" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Advanced Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>false</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
        <MonitorTransports>false</MonitorTransports>
        <IgnoreListenerErrorPeriod>900</IgnoreListenerErrorPeriod>
        <DataIDOGNLExpression>{ognl:#transaction.getTransactionID()}</DataIDOGNLExpression>
        <IgnoreTransportErrorPeriod>900</IgnoreTransportErrorPeriod>
        <MonitorListeners>false</MonitorListeners>
        <DeDuplicateErrorPeriod>86400</DeDuplicateErrorPeriod>
        <IgnoreStageErrorPeriod>900</IgnoreStageErrorPeriod>
        <CollectDataIDs>true</CollectDataIDs>
        <MonitorStages>true</MonitorStages>
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" name="PACT Result Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target name="PACT Result SOAP POST">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="PACT Archive 1122 POST Response" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$archive.dir</TargetDirectory>
        <FileName>{ognl:"PACT/"+new java.text.SimpleDateFormat('yyyy-MM').format(new java.util.Date())+"/1122-post-response-"+getAttribute('OrderNumber')+'-'+getAttribute('ReqInfoStatus')+'-'+new java.text.SimpleDateFormat("yyyy-MM-dd-HH-mm-ss-").format(new java.util.Date()) + #transaction.getOriginatingTransactionID()}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>true</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.EIPTransport" name="PACT Mark Status Sent In Database" retries="1">
      <ModuleConfig>
        <ServiceName>Update Status Inbound</ServiceName>
        <CallbackListenerName />
        <Timeout>60</Timeout>
      </ModuleConfig>
    </Transport>
  </Target>
</Route>

