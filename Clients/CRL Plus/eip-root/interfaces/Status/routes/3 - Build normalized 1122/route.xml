    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="store transactionData">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>transactionData</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="MeasureTextLength">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:textLength:eip_name:string-length(//NORMALIZEDTXT):eip_value]</XPathExpressions>
          <Namespaces>null</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEscapingProcessor" name="a.UnescapeNormalizedTxt">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &gt; 0}</ExecuteProcessor>
          <XPath>//NORMALIZEDTXT</XPath>
          <Direction>Unescape</Direction>
          <Namespaces />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="b.Generate1122Transform">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &lt;= 0}</ExecuteProcessor>
          <XSLTPath>transform.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTVersion>1.0</XSLTVersion>
          <XSLTEngine>Xalan (Interpreted)</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <CacheXSLT>false</CacheXSLT>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="b.Store Generated 1122">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &lt;= 0}</ExecuteProcessor>
          <AttributeName>Generated1122</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="b.Restore DB Results">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &lt;= 0}</ExecuteProcessor>
          <AttributeName>transactionData</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathInsertionProcessor" name="b.Insert Generated 1122 in DB Results">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &lt;= 0}</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:Generated1122:eip_name:/RESULTS:eip_value]</XPathExpressions>
          <Namespaces>null</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEscapingProcessor" name="b.Unescape Generated 1122">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('textLength') &lt;= 0}</ExecuteProcessor>
          <XPath>/RESULTS/data[@id='Generated1122']</XPath>
          <Direction>Unescape</Direction>
          <Namespaces />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="AmericanGeneral.1 - AIGP ACORD 121 SOAP.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>AmericanGeneral.1 - AIGP ACORD 121 SOAP</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="AmericanGeneral.1 - AIGP ACORD 121 SOAP.Processor1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
