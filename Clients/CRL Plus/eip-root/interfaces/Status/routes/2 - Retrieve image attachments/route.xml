  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Ignore Status Updates For Client" />
          </Targets>
          <Condition>
            <And>
              <Attribute>
                <Name>com.pilotfish.crl.statustype</Name>
                <Operator>=</Operator>
                <Value>status</Value>
              </Attribute>
              <Attribute>
                <Name>sourceClient</Name>
                <Operator>!=</Operator>
                <Value>PACT</Value>
              </Attribute>
              <Or>
                <Attribute>
                  <Name>sourceClient</Name>
                  <Operator>=</Operator>
                  <Value>METL</Value>
                </Attribute>
                <Attribute>
                  <Name>sourceClient</Name>
                  <Operator>=</Operator>
                  <Value>METD</Value>
                </Attribute>
                <Attribute>
                  <Name>sourceClient</Name>
                  <Operator>=</Operator>
                  <Value>MLFE</Value>
                </Attribute>
              </Or>
            </And>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Request Attachment" />
          </Targets>
          <Condition>
            <Expression>
              /RESULTS/TRANSACTIONATTACHMENT/ATTACHMENT/CRLDOCUMENTID[not(@id) and string-length(../CRLDRAWERNAME) &gt; 0]
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="CallCreateNormalized1122" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Advanced Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
        <MonitorTransports>false</MonitorTransports>
        <IgnoreListenerErrorPeriod>900</IgnoreListenerErrorPeriod>
        <DataIDOGNLExpression>{ognl:#transaction.getTransactionID()}</DataIDOGNLExpression>
        <IgnoreTransportErrorPeriod>900</IgnoreTransportErrorPeriod>
        <MonitorListeners>false</MonitorListeners>
        <IgnoreStageErrorPeriod>900</IgnoreStageErrorPeriod>
        <DeDuplicateErrorPeriod>86400</DeDuplicateErrorPeriod>
        <CollectDataIDs>true</CollectDataIDs>
        <MonitorStages>true</MonitorStages>
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
