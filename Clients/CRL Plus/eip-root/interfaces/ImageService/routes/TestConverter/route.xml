<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <Source name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" name="ImageService.TestConverter.Directory Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>true</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <PollingInterval>30</PollingInterval>
        <PollingDirectory>C:\Pilotfish\eip-root\data\in\test-converter</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction />
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>250</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>10</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.PDFToTIFFProcessor" name="Convert PDF to TIFF">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <MIMEType>image/tiff</MIMEType>
          <ImageCompression>Group 4 (CCITT4)</ImageCompression>
          <UseCustomDpi>true</UseCustomDpi>
          <Dpi>200</Dpi>
          <LittleEndian>false</LittleEndian>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="ImageService.TestConverter.Processor">
        <ModuleConfig>
          <ExecuteProcessor>false</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="ImageService.TestConverter.Directory Transport" retries="1">
      <ModuleConfig>
        <TargetDirectory>C:\Pilotfish\eip-root\data\out\test-converter</TargetDirectory>
        <FileName>{ognl:getAttribute('com.pilotfish.FileName')}</FileName>
        <FileExtension>TIF</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Create New</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <OutputFilePath>false</OutputFilePath>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
</Route>

