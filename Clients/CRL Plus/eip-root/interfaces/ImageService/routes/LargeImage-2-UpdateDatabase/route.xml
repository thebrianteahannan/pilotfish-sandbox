<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2026-04-24T10:29:45-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule" />
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="TriggerLargeAttachment Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="set image filename">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.image.filename</AttributeName>
          <Expression>{ognl:getAttribute('com.pilotfish.FileName')+'.'+getAttribute('com.pilotfish.FileExtension')}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="set status id">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.crl.status_id</AttributeName>
          <Expression>{ognl:#filename=getAttribute('com.pilotfish.FileName'),(#filename!=null &amp;&amp; #filename.indexOf('-')&lt;1)?'unknown' : #filename.substring(0, #filename.indexOf('-'))}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="set tx data attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>txdata</AttributeName>
          <Expression>{ognl:'&lt;attachment&gt;&lt;filename&gt;'+getAttribute('com.pilotfish.crl.image.filename')+'&lt;/filename&gt;&lt;status_id&gt;'+getAttribute('com.pilotfish.crl.status_id')+'&lt;/status_id&gt;&lt;/attachment&gt;'}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="update tx data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>txdata</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="GenerateSQLXMLforAddingAttachment" />
    <Transport class="com.pilotfish.eip.modules.db.DatabaseSqlTransport" name="LargeImage-2-UpdateDatabase.Database SQL Transport" retries="1">
      <ModuleConfig>
        <InputFile />
        <WriteQuery>false</WriteQuery>
        <Query />
        <QueryParams />
        <UserName>$$db.username</UserName>
        <Password>$$db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$db.driver</JdbcDriver>
        <JdbcURL>$$db.url</JdbcURL>
        <KeepConnection>false</KeepConnection>
        <Autocommit>false</Autocommit>
        <Timeout>300</Timeout>
        <RestrictMetaDataToCatalog />
        <RestrictMetaDataToSchema>$$db.username</RestrictMetaDataToSchema>
        <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
        <CallbackListenerName />
        <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
        <JDBCProperties>null</JDBCProperties>
        <UseConnectionPooling>false</UseConnectionPooling>
        <PermittedDBConnections>5</PermittedDBConnections>
        <LogMetadata>false</LogMetadata>
        <LogSQL>true</LogSQL>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="ImageService.LargeImage-2-UpdateDatabase.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>ImageService.LargeImage-2-UpdateDatabase</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="ImageService.LargeImage-2-UpdateDatabase.Processor1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

