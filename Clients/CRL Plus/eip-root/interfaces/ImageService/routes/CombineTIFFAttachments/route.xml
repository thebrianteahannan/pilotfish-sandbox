<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2026-04-24T10:25:31-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="MergeAndReturn" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>remainingAttachments</Name>
              <Operator>=</Operator>
              <Value>0.0</Value>
            </Attribute>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="SaveAttachmentToTempDir" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="AIG.L1-1 Error">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="Combine TIFF Attachments Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="IS.Combine-SetTempDir">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('temp.image.dir')==null}</ExecuteProcessor>
          <AttributeName>temp.image.dir</AttributeName>
          <Expression>{ognl:#properties.get('image.large.staging.dir')+'/combine-'+#transaction.getTransactionID()}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-set previous.data">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('previous.data') == null}</ExecuteProcessor>
          <AttributeName>previous.data</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-RestoreReaminingAcord">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('remaining.acord.file') != null}</ExecuteProcessor>
          <AttributeName>remaining.acord.file</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="IS.Combine-Delete remaining.acord.file attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:remaining.acord.file:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="IS.Combine-CountRemainingAttachments">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:remainingAttachments:eip_name:count(//acord:AttachmentData):eip_value]</XPathExpressions>
          <Namespaces>[eip_pair:acord:eip_name:http://ACORD.org/Standards/Life/2:eip_value]</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="ImageService.CombineTIFFAttachments.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>ImageService.CombineTIFFAttachments</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="ImageService.CombineTIFFAttachments.Processor1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="CombineTiff-ExtractFirstAttachment" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="SaveAttachmentToTempDir" retries="1">
      <ModuleConfig>
        <TargetDirectory>{ognl:getAttribute('temp.image.dir')}</TargetDirectory>
        <FileName>image</FileName>
        <FileExtension>tiff</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>false</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
        <OutputFilePath>false</OutputFilePath>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-Set remaining.acord.file">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>remaining.acord.file</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-get acord.tiff.image">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>acord.tiff.image</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64InputProcessor" name="IS.Combine-Base64 Decode">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="IS.Combine-Delete attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:acord.tiff.image:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
    <PostProcessors>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="IS.Combine-Loop For Next Attachment">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>Combine TIFF Attachments Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </PostProcessors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="MergeAndReturn" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.TIFFCombiningProcessor" name="IS.Combine-CombineTiffs">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TiffDir>{ognl:getAttribute('temp.image.dir')}</TiffDir>
          <MIMEType>image/tiff</MIMEType>
          <ImageCompression>Group 4 (CCITT4)</ImageCompression>
          <LittleEndian>true</LittleEndian>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="IS.Combine-Base64 encode">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-Set combined.tiff.base64">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.crl.mergedTiff</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="IS.Combine-Restore previous.data">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>previous.data</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="IS.Combine-Delete previous.data attr">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:previous.data:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="IS.Combine-Set PDF.images.count">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>PDF.images.count</AttributeName>
          <Expression>{ognl:getAttribute('TIFF.images.count')}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileDeletionProcessor" name="IS.Combine-Delete temp dir">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>{ognl:getAttribute('temp.image.dir')}</FileName>
          <ExceptionOnFailure>false</ExceptionOnFailure>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Description>&lt;p&gt;
      This route combines the TIFF image attachments in an ACORD 1122 file. It 
      should be called from a Call Route Processor with the synchronous option 
      selected. It return the unmodified ACORD 1122 and adds a transaction 
      attribute called com.crl.mergedTiff that contains the Base64 encoded 
      merged TIFF image.  It also adds an attribute called TIFF.images.count 
      (and an identical one called PDF.images.count for backward compatibility 
      reasons) that contains the total number of pages in the comined TIFF 
      image.
    &lt;/p&gt;</Description>
</Route>

