<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2026-04-24T10:26:32-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="PDFToTIFF Response" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors>
    <TransactionMonitor class="com.pilotfish.eip.modules.internal.RouteTriggerMonitor" name="Transaction Monitor">
      <ModuleConfig>
        <ErrorListenerName>Error On Outgoing Routes</ErrorListenerName>
        <IncludeData>true</IncludeData>
        <IncludeAttributes>true</IncludeAttributes>
        <SetDataAsMessage>false</SetDataAsMessage>
        <ExceptionClassName />
        <MustContainString />
        <MustNotContainString />
        <ExceptionMessageLevel>-1</ExceptionMessageLevel>
        <IncludeStages />
      </ModuleConfig>
    </TransactionMonitor>
  </TransactionMonitors>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.core.TriggerableListener" enabled="true" name="PDFToTIFF Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <CallingRoutes />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="StoreIncomingData">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>com.pilotfish.temp.incomingresult</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="GetPDFData">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>GetDocumentResponse</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64InputProcessor" name="DecodePDF">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.PDFToTIFFProcessor" name="ConvertPDFToTIFF">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <MIMEType>image/tiff</MIMEType>
          <ImageCompression>Group 4 (CCITT4)</ImageCompression>
          <UseCustomDpi>true</UseCustomDpi>
          <Dpi>$$image.tiff.dpi</Dpi>
          <LittleEndian>true</LittleEndian>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64OutputProcessor" name="EncodeTIFF">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <IsLineSeparated>false</IsLineSeparated>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="UpdateImageAttribute">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>GetDocumentResponse</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="UpdateMimeTypeAttribute">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>GetDocumentMimeType</AttributeName>
          <Expression>image/tiff</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="UpdateFileNameAttribute">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('GetDocumentOriginalFileName').toLowerCase().endsWith(".pdf")}</ExecuteProcessor>
          <AttributeName>GetDocumentOriginalFileName</AttributeName>
          <Expression>{ognl:getAttribute('GetDocumentOriginalFileName').substring(0, getAttribute('GetDocumentOriginalFileName').length()-4)+".tif"}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="RetrieveIncomingData">
        <ModuleConfig>
          <ExecuteProcessor>{ognl:getAttribute('com.pilotfish.temp.incomingresult')!=null}</ExecuteProcessor>
          <AttributeName>com.pilotfish.temp.incomingresult</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="ImageService.CombineTIFFAttachments.Processor-Copy-1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>ImageService.ConvertPDFToTIFF</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="ImageService.ConvertPDFToTIFF.Processor2">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="PDFToTIFF Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.AttributeRemovalProcessor" name="ConvertPDFToTIFF.RemoveAttributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetAttributes>[eip_pair:com.pilotfish.temp.incomingresult:eip_name::eip_value]</TargetAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="ImageService.ConvertPDFToTIFF.Directory Transport" retries="1">
      <ModuleConfig>
        <TargetDirectory>C:\temp</TargetDirectory>
        <FileName>test</FileName>
        <FileExtension>tiff</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Create New</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
        <OutputFilePath>false</OutputFilePath>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="ImageService.ConvertPDFToTIFF.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>GetDocumentResponse</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.Base64InputProcessor" name="ImageService.ConvertPDFToTIFF.Processor1">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

