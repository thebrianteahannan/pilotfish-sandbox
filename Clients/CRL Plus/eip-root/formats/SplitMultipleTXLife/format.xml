<?xml version="1.0" encoding="UTF-8"?>
<Format xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" name="SplitMultipleTXLife">
  <TransformationModule class="com.pilotfish.eip.modules.internal.RelayTransformationModule">
    <ModuleConfig>
      <ExecuteTransformation>true</ExecuteTransformation>
    </ModuleConfig>
  </TransformationModule>
  <XSLT>
    <ToXML />
    <CacheXSLTToXML>false</CacheXSLTToXML>
    <FromXML />
    <CacheXSLTFromXML>false</CacheXSLTFromXML>
    <XSLTVersion>1.0</XSLTVersion>
    <XSLTEngine>XALAN_INTERPRETED</XSLTEngine>
    <XSLTParameters>null</XSLTParameters>
    <ExecuteTransformation>true</ExecuteTransformation>
  </XSLT>
  <FormatMetadata />
  <SplitControl xmlns="http://www.pilotfishtechnology.com/eip/FormatSpec">
    <JoinModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.internal.NullJoinModule" />
    <ForkModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.other.XPathForkingModule">
      <ModuleConfig>
        <ForkingXPath>/ns1:TXLife | /root/ns1:TXLife</ForkingXPath>
        <Namespaces>[eip_pair:ns1:eip_name:http://ACORD.org/Standards/Life/2:eip_value]</Namespaces>
        <ExceptionOnNoNodes>false</ExceptionOnNoNodes>
        <KeepForkingSource>false</KeepForkingSource>
      </ModuleConfig>
    </ForkModule>
  </SplitControl>
</Format>

