<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="" LastModificationTime="2025-08-19T12:38:29-05:00" ModifiedBy="bthannan@pilotfishtechnology.com" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="false" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="R1 - Deliver Email" />
          </Targets>
          <Condition>
            <Attribute>
              <Name>error.count</Name>
              <Operator>!=</Operator>
              <Value>0</Value>
            </Attribute>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <Source icon="" name="System Unnamed">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.db.DatabaseSqlListener" enabled="true" name="Fallout Report Polling DB Listener">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>1200</PollingInterval>
        <InputFile>sql.xml</InputFile>
        <WriteQuery>false</WriteQuery>
        <Query />
        <QueryParams />
        <UserName>$$db.username</UserName>
        <Password>$$db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$db.driver</JdbcDriver>
        <JdbcURL>$$db.url</JdbcURL>
        <SchedulerStartTag>M0W0D1H2m0</SchedulerStartTag>
        <SchedulerEndTag>M0W0D1H2m5</SchedulerEndTag>
        <ExcludeDaysTag>Sat,Sun</ExcludeDaysTag>
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <BatchSensitive>false</BatchSensitive>
        <Timeout>600</Timeout>
        <RestrictMetaDataToCatalog />
        <RestrictMetaDataToSchema>CRL_INSIGHT_TO_PFISH</RestrictMetaDataToSchema>
        <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
        <UseSingleOutputStream>true</UseSingleOutputStream>
        <RefreshHandler>false</RefreshHandler>
        <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
        <JDBCProperties>null</JDBCProperties>
        <LogMetadata>false</LogMetadata>
        <LogSQL>false</LogSQL>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="ROOT.R1 - Count Errors">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:error.count:eip_name:string(count(//ERRORS/ERROR)):eip_value]</XPathExpressions>
          <Namespaces>null</Namespaces>
          <Namespace />
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="System Unnamed">
    <FormatProfile name="FalloutReportAttachment" />
    <Transport class="com.pilotfish.eip.modules.email.EmailTransport" name="R1 - Deliver Email" retries="1">
      <ModuleConfig>
        <Host>$$mail.server</Host>
        <UserName />
        <Password />
        <Port>25</Port>
        <SSLEnabled>false</SSLEnabled>
        <StartTLS>false</StartTLS>
        <SendFrom>$$mail.errors.from</SendFrom>
        <ReplyTo />
        <SendTo>$$mail.undeliveredstatus.to</SendTo>
        <SendCC />
        <SendBCC />
        <Subject>{ognl:'PilotFish Fallout Report for '+getAttribute('crl.environment')+' - '+getAttribute('error.count')+ ' errors'}</Subject>
        <DataInAttachment>true</DataInAttachment>
        <AttachmentFilename>fallout-report.xlsx</AttachmentFilename>
        <MIMEType>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</MIMEType>
        <AttachmentsTable />
        <ENCRYPT_MESSAGE>false</ENCRYPT_MESSAGE>
        <DNS_FIND_CERT>false</DNS_FIND_CERT>
        <PathToCertificate />
        <SIGN_MESSAGE>false</SIGN_MESSAGE>
        <PathToPemFile />
        <PrivateKeyName />
        <PrivateKeyPassword />
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="ROOT.R1 - set crl.environment">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>crl.environment</AttributeName>
          <Expression>$$crl.environment</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="ROOT.R1 - set Email.Attachment">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>Email.Attachment</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>

