        <ThrottlingMode>None</ThrottlingMode>
        <ThrottlingSynchronousTimeout>60</ThrottlingSynchronousTimeout>
        <TransactionLoggingLogAllAttributes>false</TransactionLoggingLogAllAttributes>
        <InactivityPolling>500</InactivityPolling>
        <ThrottlingMechanism>Blocking</ThrottlingMechanism>
        <CheckInactivity>false</CheckInactivity>
        <ThrottlingConcurrentMessages>1</ThrottlingConcurrentMessages>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="Back To 121 Sender">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="AIL.OrderReceived.SyncResponse.ToSender" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="AmericanIncomeLife.Processor-Copy-2">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>RouteName</AttributeName>
          <Expression>{ognl:'Clients.AmericanIncomeLife-' + getAttribute('com.pilotfish.FileName') + '-2 - 121 Response'}</Expression>
          <AttributeScope>Transaction</AttributeScope>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.CallRouteProcessor" name="AmericanIncomeLife.2 - 121 Response.Processor">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <Listener>WellnessElectronicOrderInterface.999 - Capture Requests and Responses.Programmable (Trigger) Listener</Listener>
          <Synchronous>false</Synchronous>
          <Timeout>60</Timeout>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Description>&lt;p&gt;
      &lt;b&gt;*Note:&lt;/b&gt; only send a sync response if there is something to send a 
      sync response back to ... meaning if the 121 message was sent into the 
      system from a directory listsener instead of an HTTP Post, then there 
      would be no where to send the sync response back to.
    &lt;/p&gt;</Description>
</Route>

