        <Password>$$records.db.password</Password>
        <UseDataSource>false</UseDataSource>
        <DataSource />
        <JdbcDriver>$$records.db.jdbc.driver</JdbcDriver>
        <JdbcURL>$$records.db.jdbc.url</JdbcURL>
        <KeepConnection>false</KeepConnection>
        <Autocommit>false</Autocommit>
