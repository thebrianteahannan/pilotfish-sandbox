<?xml version="1.0" encoding="UTF-8"?>
<Format xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" RoutePlacement="target" name="Generate Insert Log SQLXML">
  <TransformationModule class="com.pilotfish.eip.modules.internal.RelayTransformationModule">
    <ModuleConfig>
      <ExecuteTransformation>true</ExecuteTransformation>
    </ModuleConfig>
  </TransformationModule>
  <XSLT>
    <ToXML />
    <CacheXSLTToXML>false</CacheXSLTToXML>
    <FromXML>transform.xslt</FromXML>
    <CacheXSLTFromXML>false</CacheXSLTFromXML>
    <XSLTEngine>SAXON</XSLTEngine>
    <XSLTParameters>[eip_pair:EventType:eip_name:{ognl:getAttribute('event_type')}:eip_value][eip_pair:Status:eip_name:{ognl:getAttribute('success')}:eip_value][eip_pair:UniqueControlID:eip_name:{ognl:getAttribute('UniqueControlID')}:eip_value][eip_pair:MSHGUID:eip_name:{ognl:getAttribute('MSHGUID')}:eip_value][eip_pair:HL7Data:eip_name:{ognl:getAttribute('HL7Data')}:eip_value][eip_pair:HL7Type:eip_name:{ognl:getAttribute('hl7_type')}:eip_value][eip_pair:SequenceNo:eip_name:{ognl:getAttribute('SequenceNo')}:eip_value][eip_pair:SetNo:eip_name:{ognl:getAttribute('SetNo')}:eip_value]</XSLTParameters>
    <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
    <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
    <ExecuteTransformation>true</ExecuteTransformation>
  </XSLT>
  <FormatMetadata />
  <SplitControl xmlns="http://www.pilotfishtechnology.com/eip/FormatSpec">
    <JoinModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.internal.NullJoinModule" />
    <ForkModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.internal.NullForkModule" />
  </SplitControl>
</Format>

