{
  "version": 1,
  "interface": "SQL Server PilotFish XML Export",
  "short_name": "SQL_Server_PilotFish_XML_Export",
  "description": "Poll SQL Server Captures and write one XML export file.",
  "base_urls": {
    "webui": "http://127.0.0.1:8137",
    "eip": "http://127.0.0.1:8136/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8137/",
    "http://127.0.0.1:8137/api/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": { "url": "{webui}/" },
          "expect": { "status": 200, "contains": ["SQL Server", "Captures"] }
        },
        {
          "id": "api-health",
          "name": "API health",
          "type": "http",
          "request": { "method": "GET", "url": "{webui}/api/health" },
          "expect": { "status": 200 }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": { "method": "GET", "url": "{webui}/api/v2/routes" },
          "expect": { "status": 200, "contains": ["routes"] }
        }
      ]
    },
    {
      "id": "export",
      "name": "SQL poll then XML",
      "tests": [
        {
          "id": "wait-sql",
          "name": "SQL is reachable via Web UI health",
          "type": "wait",
          "wait": {
            "url": "{webui}/api/health",
            "timeout_sec": 180,
            "interval_sec": 4,
            "contains": ["\"sql\":true"]
          }
        },
        {
          "id": "wait-eip",
          "name": "EIP is reachable via Web UI health",
          "type": "wait",
          "wait": {
            "url": "{webui}/api/health",
            "timeout_sec": 180,
            "interval_sec": 4,
            "contains": ["\"eip\":true"]
          }
        },
        {
          "id": "seed-rows",
          "name": "Seeded Captures rows are visible",
          "type": "wait",
          "wait": {
            "url": "{webui}/api/captures",
            "timeout_sec": 60,
            "interval_sec": 2,
            "contains": ["American General"]
          }
        },
        {
          "id": "xml-export",
          "name": "XML export contains CaptureId 1001",
          "type": "wait",
          "wait": {
            "url": "{webui}/api/xml",
            "timeout_sec": 90,
            "interval_sec": 3,
            "contains": ["1001", "  <RECORDS>", "  <CAPTURE>"]
          }
        }
      ]
    },
    {
      "id": "docs",
      "name": "Documents",
      "tests": [
        {
          "id": "route-pdf",
          "name": "Route PDF on disk",
          "type": "file",
          "file": { "path": "documents/SQL_Server_PilotFish_XML_Export_V2_Route_Diagrams.pdf" }
        },
        {
          "id": "capability-pdf",
          "name": "Capability Brief PDF on disk",
          "type": "file",
          "file": { "path": "documents/SQL_Server_PilotFish_XML_Export_Capability_Brief.pdf" }
        },
        {
          "id": "test-plan-pdf",
          "name": "Test Plan PDF on disk",
          "type": "file",
          "file": { "path": "documents/SQL_Server_PilotFish_XML_Export_Test_Plan.pdf" }
        }
      ]
    }
  ]
}
