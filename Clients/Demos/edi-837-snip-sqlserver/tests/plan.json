{
  "version": 1,
  "interface": "EDI 837 SNIP SQL Server",
  "description": "SQL claim poll \u2192 generate 837 + SNIP validation artifacts.",
  "base_urls": {
    "webui": "http://127.0.0.1:8095",
    "eip": "http://127.0.0.1:8093/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8095/",
    "http://127.0.0.1:8095/api/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "api-health",
          "name": "API health",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/health"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        },
        {
          "id": "claims",
          "name": "Claims API reachable",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/claims"
          },
          "expect": {
            "status_in": [
              200,
              404
            ]
          }
        }
      ]
    }
  ]
}
