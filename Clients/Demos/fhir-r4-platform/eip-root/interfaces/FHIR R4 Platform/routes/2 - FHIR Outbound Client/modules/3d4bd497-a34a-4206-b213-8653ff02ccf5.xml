<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="3d4bd497-a34a-4206-b213-8653ff02ccf5" name="Extract Outbound URL" type="RegExIntoTransactionAttributeProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <RegEx>"url"\s*:\s*"([^"]+)"</RegEx>
      
          
      <AttributeName>fhir.OutUrl</AttributeName>
      
          
      <MatchGroupNumber>1</MatchGroupNumber>
      
        
   </ModuleConfig>
</Module>
