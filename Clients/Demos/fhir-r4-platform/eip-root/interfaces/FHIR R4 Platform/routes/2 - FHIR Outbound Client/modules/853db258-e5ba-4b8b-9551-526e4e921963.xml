<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="853db258-e5ba-4b8b-9551-526e4e921963" name="Extract Outbound URL" type="RegExIntoTransactionAttributeProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <RegEx>"url"\s*:\s*"([^"]+)"</RegEx>
      
          
      <AttributeName>fhir.OutUrl</AttributeName>
      
          
      <MatchGroupNumber>1</MatchGroupNumber>
      
        
   </ModuleConfig>
</Module>
