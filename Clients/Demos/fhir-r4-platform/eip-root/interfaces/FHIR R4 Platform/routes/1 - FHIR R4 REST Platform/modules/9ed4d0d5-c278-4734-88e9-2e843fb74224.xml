<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="9ed4d0d5-c278-4734-88e9-2e843fb74224" name="Search Resources SQL" type="Database (SQL)" tag="Processor" class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor">
   <ModuleConfig>
      <InputFile/>
      
          
      <WriteQuery>true</WriteQuery>
      
          
      <Query>SELECT TOP 50 ResourceType, ResourceId, RawFhir FROM dbo.FhirResources
WHERE ResourceType = ? AND DeletedAt IS NULL
AND (? IS NULL OR LTRIM(RTRIM(CAST(? AS NVARCHAR(128)))) = '' OR ResourceId = ?)
AND (? IS NULL OR LTRIM(RTRIM(CAST(? AS NVARCHAR(200)))) = '' OR RawFhir LIKE '%' + ? + '%')
ORDER BY UpdatedAt DESC</Query>
      
          
      <QueryParams>[eip_pair:t:eip_name:{ognl:getAttribute('com.pilotfish.ResourceName').toString()}:eip_value][eip_pair:sid1:eip_name:{ognl:getAttribute('fhir.SearchId')}:eip_value][eip_pair:sid2:eip_name:{ognl:getAttribute('fhir.SearchId')}:eip_value][eip_pair:sid3:eip_name:{ognl:getAttribute('fhir.SearchId')}:eip_value][eip_pair:q1:eip_name:{ognl:getAttribute('fhir.SearchQ')}:eip_value][eip_pair:q2:eip_name:{ognl:getAttribute('fhir.SearchQ')}:eip_value][eip_pair:q3:eip_name:{ognl:getAttribute('fhir.SearchQ')}:eip_value]</QueryParams>
      
          
      <UserName>$$sqlserver.username</UserName>
      
          
      <Password>$$sqlserver.password</Password>
      
          
      <UseDataSource>false</UseDataSource>
      
          
      <DataSource/>
      
          
      <JdbcDriver>$$sqlserver.driver</JdbcDriver>
      
          
      <JdbcURL>$$sqlserver.url</JdbcURL>
      
          
      <KeepConnection>false</KeepConnection>
      
          
      <Autocommit>true</Autocommit>
      
          
      <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
      
          
      <Timeout>60</Timeout>
      
          
      <RestrictMetaDataToCatalog/>
      
          
      <RestrictMetaDataToSchema/>
      
          
      <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
      
          
      <UseSingleOutputStream>true</UseSingleOutputStream>
      
          
      <RefreshHandler>false</RefreshHandler>
      
          
      <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
      
          
      <JDBCProperties>null</JDBCProperties>
      
          
      <LogMetadata>false</LogMetadata>
      
          
      <LogSQL>true</LogSQL>
      
        
   </ModuleConfig>
</Module>
