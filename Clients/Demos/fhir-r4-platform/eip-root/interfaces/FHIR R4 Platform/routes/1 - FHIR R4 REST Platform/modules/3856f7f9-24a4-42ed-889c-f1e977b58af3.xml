<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="3856f7f9-24a4-42ed-889c-f1e977b58af3" name="Upsert Resource SQL" type="Database (SQL)" tag="Processor" class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor">
   <ModuleConfig>
      <InputFile/>
      
          
      <WriteQuery>true</WriteQuery>
      
          
      <Query>MERGE dbo.FhirResources AS t
USING (SELECT ? AS ResourceType, ? AS ResourceId, ? AS RawFhir) AS s
ON t.ResourceType = s.ResourceType AND t.ResourceId = s.ResourceId
WHEN MATCHED THEN UPDATE SET RawFhir = s.RawFhir, ValidationStatus = 'PASS', SourceCode = 'REST', Source = 'local', DeletedAt = NULL, UpdatedAt = SYSUTCDATETIME()
WHEN NOT MATCHED THEN INSERT (SourceCode, ResourceType, ResourceId, PatientId, PatientName, IsBundle, ValidationStatus, SourceFile, RawFhir, Source)
VALUES ('REST', s.ResourceType, s.ResourceId, '', '', CASE WHEN s.ResourceType = 'Bundle' THEN 1 ELSE 0 END, 'PASS', 'rest-api', s.RawFhir, 'local')
OUTPUT INSERTED.ResourceRowId AS ResourceRowId;</Query>
      
          
      <QueryParams>[eip_pair:p1:eip_name:{ognl:getAttribute('com.pilotfish.ResourceName').toString()}:eip_value][eip_pair:p2:eip_name:{ognl:getAttribute('fhir.EffectiveId').toString()}:eip_value][eip_pair:p3:eip_name:{ognl:getAttribute('fhir.RawBody')}:eip_value]</QueryParams>
      
          
      <UserName>$$sqlserver.username</UserName>
      
          
      <Password>$$sqlserver.password</Password>
      
          
      <UseDataSource>false</UseDataSource>
      
          
      <DataSource/>
      
          
      <JdbcDriver>$$sqlserver.driver</JdbcDriver>
      
          
      <JdbcURL>$$sqlserver.url</JdbcURL>
      
          
      <KeepConnection>false</KeepConnection>
      
          
      <Autocommit>true</Autocommit>
      
          
      <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
      
          
      <Timeout>60</Timeout>
      
          
      <RestrictMetaDataToCatalog/>
      
          
      <RestrictMetaDataToSchema/>
      
          
      <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
      
          
      <UseSingleOutputStream>true</UseSingleOutputStream>
      
          
      <RefreshHandler>false</RefreshHandler>
      
          
      <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
      
          
      <JDBCProperties>null</JDBCProperties>
      
          
      <LogMetadata>false</LogMetadata>
      
          
      <LogSQL>true</LogSQL>
      
        
   </ModuleConfig>
</Module>
