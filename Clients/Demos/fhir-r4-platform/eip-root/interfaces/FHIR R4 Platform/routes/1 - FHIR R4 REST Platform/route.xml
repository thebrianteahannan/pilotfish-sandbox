        </Rule>
        <Rule>
          <Targets><TransportTarget name="Create Response" /></Targets>
          <Condition><OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; getAttribute('fhir.ValidationStatus') == 'PASS'</OGNLExpression></Condition>
        </Rule>
        <Rule>
          <Targets><TransportTarget name="Update Response" /></Targets>
          <Condition><OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'PUT' &amp;&amp; getAttribute('fhir.ValidationStatus') == 'PASS' &amp;&amp; getAttribute('com.pilotfish.ResourceID') != null &amp;&amp; getAttribute('com.pilotfish.ResourceID').toString().trim().length() &gt; 0</OGNLExpression></Condition>
        </Rule>
        <Rule>
