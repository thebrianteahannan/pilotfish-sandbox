          <Condition><OGNLExpression>(getAttribute('com.pilotfish.HttpMethodName') == 'POST' || getAttribute('com.pilotfish.HttpMethodName') == 'PUT') &amp;&amp; getAttribute('fhir.ValidationStatus') != 'PASS'</OGNLExpression></Condition>
