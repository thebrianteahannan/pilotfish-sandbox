        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributePairs>[eip_pair:fhir.EffectiveId:eip_name:{ognl:(getAttribute('com.pilotfish.ResourceID') != null &amp;&amp; getAttribute('com.pilotfish.ResourceID').toString().trim().length() &gt; 0) ? getAttribute('com.pilotfish.ResourceID').toString().trim() : ((getAttribute('fhir.LogicalId') != null) ? getAttribute('fhir.LogicalId').toString().trim() : '')}:eip_value][eip_pair:fhir.ValidationStatus:eip_name:{ognl:(getAttribute('fhir.BodyResourceType') != null &amp;&amp; getAttribute('com.pilotfish.ResourceName') != null &amp;&amp; getAttribute('fhir.BodyResourceType').toString().equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName')) &amp;&amp; getAttribute('fhir.EffectiveId') != null &amp;&amp; getAttribute('fhir.EffectiveId').toString().trim().length() &gt; 0) ? 'PASS' : 'FAIL'}:eip_value][eip_pair:fhir.SearchId:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter._id')}:eip_value][eip_pair:fhir.SearchQ:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.q')}:eip_value][eip_pair:fhir.SearchIdentifier:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.identifier')}:eip_value][eip_pair:fhir.SearchFamily:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.family')}:eip_value][eip_pair:fhir.SearchGiven:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.given')}:eip_value][eip_pair:fhir.SearchName:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.name')}:eip_value][eip_pair:fhir.SearchGender:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.gender')}:eip_value][eip_pair:fhir.SearchBirthdate:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.birthdate')}:eip_value][eip_pair:fhir.SearchPatient:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.patient')}:eip_value][eip_pair:fhir.SearchCode:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.code')}:eip_value][eip_pair:fhir.SearchDate:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.date')}:eip_value][eip_pair:fhir.SearchStatus:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.status')}:eip_value][eip_pair:fhir.SearchCategory:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.category')}:eip_value][eip_pair:fhir.SearchClass:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.class')}:eip_value][eip_pair:fhir.SearchClinicalStatus:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.clinical-status')}:eip_value][eip_pair:fhir.SearchOnsetDate:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.onset-date')}:eip_value][eip_pair:fhir.SearchActive:eip_name:{ognl:getAttribute('com.pilotfish.http.parameter.active')}:eip_value][eip_pair:fhir.IsTxnBundle:eip_name:{ognl:(getAttribute('fhir.BodyResourceType') != null &amp;&amp; 'Bundle'.equalsIgnoreCase(getAttribute('fhir.BodyResourceType').toString()) &amp;&amp; getAttribute('fhir.BundleInteraction') != null &amp;&amp; getAttribute('fhir.BundleInteraction').toString().trim().length() &gt; 0 &amp;&amp; getAttribute('com.pilotfish.ResourceName') != null &amp;&amp; 'Bundle'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName').toString())) ? 'true' : 'false'}:eip_value]</AttributePairs>
