        <PASSWORD />
        <POST_SUPPORTED>true</POST_SUPPORTED>
        <GET_SUPPORTED>true</GET_SUPPORTED>
        <PUT_SUPPORTED>true</PUT_SUPPORTED>
        <DELETE_SUPPORTED>true</DELETE_SUPPORTED>
