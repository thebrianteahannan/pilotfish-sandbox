          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Extract Bundle Interaction">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"type"\s*:\s*"(transaction|batch)"</RegEx>
