<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="708af9de-f4eb-46a4-be01-99b3d4e5013d" name="Conditional Router" type="Conditional Node Router" tag="RoutingModule" class="com.pilotfish.eip.modules.internal.ConditionalNodeRoutingModule">
   <ModuleConfig>
      <SelectionMode>FIRST_MATCH</SelectionMode>
      <RoutingPorts version="1">
         <inputs>
            <input id="76ff28d5-673d-4fb2-90f6-c784542004a6" name="Input"/>
         </inputs>
         <outputs>
            <output id="e15994b0-8c98-4f64-854e-dc7fc9ffd0d2" name="Rule 1 - Skip Auth Response" type="XPATH">
               <condition>getAttribute('fhir.AuthRequired') != 'true'</condition>
            </output>
            <output id="86874e35-15f8-4164-9e20-7c72f30e6467" name="Rule 2 - Missing Token Response" type="XPATH">
               <condition>getAttribute('fhir.BearerToken') == null || getAttribute('fhir.BearerToken').toString().trim().length() == 0</condition>
            </output>
            <output id="e8707787-d3c1-4636-95a0-e08a97703fde" name="Rule 3 - Introspect Token" type="XPATH">
               <condition>true</condition>
            </output>
         </outputs>
      </RoutingPorts>
   </ModuleConfig>
</Module>
