<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="c5352e29-615d-47b4-946d-20af7e4cd020" name="Extract Outbound URL" type="RegExIntoTransactionAttributeProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <RegEx>"url"\s*:\s*"([^"]+)"</RegEx>
      
          
      <AttributeName>fhir.OutUrl</AttributeName>
      
          
      <MatchGroupNumber>1</MatchGroupNumber>
      
        
   </ModuleConfig>
</Module>
