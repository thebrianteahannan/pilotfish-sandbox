<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="88769532-86a9-4056-bd20-a56b16523c90" name="Extract Outbound URL" type="RegExIntoTransactionAttributeProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <RegEx>"url"\s*:\s*"([^"]+)"</RegEx>
      
          
      <AttributeName>fhir.OutUrl</AttributeName>
      
          
      <MatchGroupNumber>1</MatchGroupNumber>
      
        
   </ModuleConfig>
</Module>
