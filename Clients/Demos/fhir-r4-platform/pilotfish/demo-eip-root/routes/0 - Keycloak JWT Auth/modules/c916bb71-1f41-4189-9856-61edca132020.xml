<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="c916bb71-1f41-4189-9856-61edca132020" name="Conditional Router" type="Conditional Node Router" tag="RoutingModule" class="com.pilotfish.eip.modules.internal.ConditionalNodeRoutingModule">
   <ModuleConfig>
      <SelectionMode>FIRST_MATCH</SelectionMode>
      <RoutingPorts version="1">
         <inputs>
            <input id="244e9471-f4bc-4286-bc7f-e3e2db9328be" name="Input"/>
         </inputs>
         <outputs>
            <output id="eca16338-913c-4fc2-8a79-6be4f830bae4" name="Rule 1 - Skip Auth Response" type="XPATH">
               <condition>getAttribute('fhir.AuthRequired') != 'true'</condition>
            </output>
            <output id="dc4dae61-4b8b-452a-9060-60229b38ddd0" name="Rule 2 - Missing Token Response" type="XPATH">
               <condition>getAttribute('fhir.BearerToken') == null || getAttribute('fhir.BearerToken').toString().trim().length() == 0</condition>
            </output>
            <output id="ab68a086-4bcb-4c04-991e-c66d71e677bf" name="Rule 3 - Introspect Token" type="XPATH">
               <condition>true</condition>
            </output>
         </outputs>
      </RoutingPorts>
   </ModuleConfig>
</Module>
