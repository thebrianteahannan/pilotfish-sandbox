{
  "version": 1,
  "interface": "EDI 270/271 Eligibility",
  "description": "Clinic eligibility verify over real X12 270/271 with AAA reject and success theater.",
  "base_urls": {
    "webui": "http://127.0.0.1:8107",
    "eip": "http://127.0.0.1:8106/eip",
    "payer": "http://127.0.0.1:8210"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8107/",
    "http://127.0.0.1:8210/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200,
            "contains": [
              "eligib"
            ]
          }
        },
        {
          "id": "payer",
          "name": "Mock payer health",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{payer}/health"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        }
      ]
    },
    {
      "id": "eligibility",
      "name": "Eligibility checks",
      "tests": [
        {
          "id": "fail001",
          "name": "FAIL001 returns AAA reject theater",
          "type": "http",
          "request": {
            "method": "POST",
            "url": "{webui}/api/check-eligibility",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "memberId": "FAIL001",
              "firstName": "Jane",
              "lastName": "Doe"
            }
          },
          "expect": {
            "status_in": [
              200,
              400
            ],
            "regex": [
              "AAA|reject|72|invalid"
            ]
          }
        },
        {
          "id": "ok001",
          "name": "OK001 returns benefits",
          "type": "http",
          "request": {
            "method": "POST",
            "url": "{webui}/api/check-eligibility",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "memberId": "OK001",
              "firstName": "John",
              "lastName": "Smith"
            }
          },
          "expect": {
            "status": 200,
            "regex": [
              "EB|benefit|active|OK001"
            ]
          }
        }
      ]
    }
  ]
}
