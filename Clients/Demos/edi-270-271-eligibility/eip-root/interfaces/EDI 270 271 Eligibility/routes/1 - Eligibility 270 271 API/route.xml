<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Return 270" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; 'build'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName'))</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Return Summary" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; 'parse'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName'))</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Method Not Allowed" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Clinic Eligibility Client">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.http.rest.RESTfulWebServiceListener" enabled="true" name="Eligibility REST">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <SERVICE_NAME>eligibility</SERVICE_NAME>
        <USER_NAME />
        <PASSWORD />
        <POST_SUPPORTED>true</POST_SUPPORTED>
        <GET_SUPPORTED>false</GET_SUPPORTED>
        <PUT_SUPPORTED>false</PUT_SUPPORTED>
        <DELETE_SUPPORTED>false</DELETE_SUPPORTED>
        <SupportedResources>build,parse</SupportedResources>
        <Timeout>60</Timeout>
        <RequireSSL>false</RequireSSL>
        <Synchronous>true</Synchronous>
        <HTTPHeaders />
        <UseLegacyTokenParam>false</UseLegacyTokenParam>
        <WadlFile />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Snapshot Inbound Body">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$REQUEST_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'in_' + getAttribute('com.pilotfish.ResourceName') + '_' + @java.lang.System@currentTimeMillis() + '.dat'}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>

  <Target icon="" name="Build 270 X12">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Return 270" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map Request To 270 EDI XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>transform-request-to-270-edi-xml.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Write 270 EDI XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$EDI_270_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'270_' + @java.lang.System@currentTimeMillis() + '_edi.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.EDITransformationProcessor" name="XML to EDI 270">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <ExecuteTransformation>true</ExecuteTransformation>
          <TransformationDirection>XML to EDI</TransformationDirection>
          <UseInternalData>false</UseInternalData>
          <FriendlyNamesLevel>None</FriendlyNamesLevel>
          <CODE_DEFS>false</CODE_DEFS>
          <SegmentIndexing>true</SegmentIndexing>
          <OutputEndlines>true</OutputEndlines>
          <UseProvidedDelimiters>true</UseProvidedDelimiters>
          <DataDelimiter>*</DataDelimiter>
          <SubDelimiter>:</SubDelimiter>
          <RepetitionDelimiter>^</RepetitionDelimiter>
          <RecordDelimiter>~</RecordDelimiter>
          <USE_LEGACY_FORMAT>false</USE_LEGACY_FORMAT>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Write 270 EDI Wire">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$EDI_270_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'270_' + @java.lang.System@currentTimeMillis() + '.edi'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 200 Build">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>200 OK</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="270 Response Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:text/plain; charset=UTF-8:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>

  <Target icon="" name="Parse 271">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Return Summary" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Snapshot Raw 271">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$EDI_271_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'271_' + @java.lang.System@currentTimeMillis() + '_raw.edi'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map 271 Wire To JSON">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>transform-271-xml-to-json.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Write JSON Summary">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$RESPONSE_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'summary_' + @java.lang.System@currentTimeMillis() + '.json'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 200 Parse">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>200 OK</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="JSON Response Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/json; charset=UTF-8:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>

  <Target icon="" name="Not Allowed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Method Not Allowed" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Empty Error Body">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>transform-method-not-allowed.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 405">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>405 Method Not Allowed</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="405 Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/json; charset=UTF-8:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
