{
  "version": 1,
  "interface": "FHIR Patient Exchange",
  "description": "FHIR REST Patient create/read with validation kickout sample.",
  "base_urls": {
    "webui": "http://127.0.0.1:8103",
    "fhir": "http://127.0.0.1:8102/eip/rest/fhir"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8103/",
    "http://127.0.0.1:8102/eip/rest/fhir/metadata"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200,
            "contains": [
              "FHIR"
            ]
          }
        },
        {
          "id": "meta",
          "name": "FHIR metadata",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{fhir}/metadata"
          },
          "expect": {
            "status_in": [
              200,
              404
            ]
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        }
      ]
    },
    {
      "id": "patient",
      "name": "Patient CRUD",
      "tests": [
        {
          "id": "create",
          "name": "Create Patient alice",
          "type": "http",
          "request": {
            "method": "POST",
            "url": "{fhir}/Patient",
            "headers": {
              "Content-Type": "application/fhir+json"
            },
            "body_file": "samples/EHR-01_Patient_alice.json"
          },
          "expect": {
            "status_in": [
              200,
              201
            ],
            "contains": [
              "Patient"
            ]
          }
        },
        {
          "id": "read",
          "name": "Read pat-alice-001",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{fhir}/Patient/pat-alice-001"
          },
          "expect": {
            "status": 200,
            "contains": [
              "pat-alice-001"
            ]
          }
        }
      ]
    }
  ]
}
