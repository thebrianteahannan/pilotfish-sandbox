<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Create Patient Response" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; 'Patient'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName')) &amp;&amp; getAttribute('fhir.ValidationStatus') == 'PASS'</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Bad Request Response" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; 'Patient'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName'))</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Read Patient Response" />
          </Targets>
          <Condition>
            <OGNLExpression>getAttribute('com.pilotfish.HttpMethodName') == 'GET' &amp;&amp; 'Patient'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName')) &amp;&amp; getAttribute('com.pilotfish.ResourceID') != null &amp;&amp; getAttribute('com.pilotfish.ResourceID').toString().trim().length() &gt; 0</OGNLExpression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Method Not Allowed Response" />
          </Targets>
          <Condition>
            <OGNLExpression>true</OGNLExpression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="FHIR REST Client">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.http.rest.RESTfulWebServiceListener" enabled="true" name="FHIR R4 REST">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <SERVICE_NAME>fhir</SERVICE_NAME>
        <USER_NAME />
        <PASSWORD />
        <POST_SUPPORTED>true</POST_SUPPORTED>
        <GET_SUPPORTED>true</GET_SUPPORTED>
        <PUT_SUPPORTED>false</PUT_SUPPORTED>
        <DELETE_SUPPORTED>false</DELETE_SUPPORTED>
        <SupportedResources>Patient</SupportedResources>
        <Timeout>60</Timeout>
        <RequireSSL>false</RequireSSL>
        <Synchronous>true</Synchronous>
        <HTTPHeaders />
        <UseLegacyTokenParam>false</UseLegacyTokenParam>
        <WadlFile />
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Save Raw Body">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>fhir.RawBody</AttributeName>
          <SAVEOUTTAG>false</SAVEOUTTAG>
          <SAVEINTAG>true</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Extract Logical Id">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"id"\s*:\s*"([^"]+)"</RegEx>
          <AttributeName>fhir.LogicalId</AttributeName>
          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Extract MRN">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"value"\s*:\s*"(MRN-[^"]+)"</RegEx>
          <AttributeName>fhir.PatientId</AttributeName>
          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Detect Patient Type">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"resourceType"\s*:\s*"Patient"</RegEx>
          <AttributeName>fhir.HasPatientType</AttributeName>
          <MatchGroupNumber>0</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Detect Name">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"family"\s*:\s*"[^"]+"</RegEx>
          <AttributeName>fhir.HasName</AttributeName>
          <MatchGroupNumber>0</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set Validation Status">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributePairs>[eip_pair:fhir.ValidationStatus:eip_name:{ognl:(getAttribute('fhir.HasPatientType') != null &amp;&amp; getAttribute('fhir.LogicalId') != null &amp;&amp; getAttribute('fhir.LogicalId').toString().trim().length() &gt; 0 &amp;&amp; getAttribute('fhir.PatientId') != null &amp;&amp; getAttribute('fhir.HasName') != null) ? 'PASS' : 'FAIL'}:eip_value]</AttributePairs>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="Create Patient">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Create Patient Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Restore Body For Persist">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>fhir.RawBody</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Write FHIR Store File">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$FHIR_STORE_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:getAttribute('fhir.LogicalId') + '.json'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Upsert Patient SQL">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>MERGE dbo.FhirResources AS t
USING (SELECT ? AS ResourceType, ? AS ResourceId, ? AS RawFhir, ? AS PatientId) AS s
ON t.ResourceType = s.ResourceType AND t.ResourceId = s.ResourceId
WHEN MATCHED THEN UPDATE SET RawFhir = s.RawFhir, PatientId = s.PatientId, ValidationStatus = 'PASS', SourceCode = 'REST', ReceivedAt = SYSUTCDATETIME()
WHEN NOT MATCHED THEN INSERT (SourceCode, ResourceType, ResourceId, PatientId, PatientName, IsBundle, ValidationStatus, SourceFile, RawFhir)
VALUES ('REST', s.ResourceType, s.ResourceId, s.PatientId, '', 0, 'PASS', 'rest-api', s.RawFhir)
OUTPUT INSERTED.ResourceRowId AS ResourceRowId;</Query>
          <QueryParams>[eip_pair:p1:eip_name:Patient:eip_value][eip_pair:p2:eip_name:{ognl:getAttribute('fhir.LogicalId')}:eip_value][eip_pair:p3:eip_name:{ognl:getAttribute('fhir.RawBody')}:eip_value][eip_pair:p4:eip_name:{ognl:getAttribute('fhir.PatientId')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.SaveDataToAttributeProcessor" name="Restore Body For Response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>fhir.RawBody</AttributeName>
          <SAVEOUTTAG>true</SAVEOUTTAG>
          <SAVEINTAG>false</SAVEINTAG>
          <USEDOCUMENTOBJECTMODEL>false</USEDOCUMENTOBJECTMODEL>
          <StoreAsStream>false</StoreAsStream>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 201 Created">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>201 Created</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="Create Response Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/fhir+json:eip_value][eip_pair:Location:eip_name:{ognl:'/eip/rest/fhir/Patient/' + getAttribute('fhir.LogicalId')}:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Read Patient">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Read Patient Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Select Patient SQL">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>SELECT TOP 1 RawFhir FROM dbo.FhirResources WHERE ResourceType = 'Patient' AND ResourceId = ?</Query>
          <QueryParams>[eip_pair:id:eip_name:{ognl:getAttribute('com.pilotfish.ResourceID')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Detect SQL Hit">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:fhir.FoundRaw:eip_name:normalize-space(string((.//*[upper-case(local-name())='RAWFHIR'])[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map SQL To FHIR JSON">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>sql-result-to-response.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set Read Status Code">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributePairs>[eip_pair:com.pilotfish.HTTPResponseCode:eip_name:{ognl:(getAttribute('fhir.FoundRaw') != null &amp;&amp; getAttribute('fhir.FoundRaw').toString().trim().length() &gt; 0) ? '200' : '404'}:eip_value]</AttributePairs>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="Read Response Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/fhir+json:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Bad Request">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Bad Request Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.StaticFileProcessor" name="Load 400 Outcome">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>outcomes/operation-outcome-400.json</FileName>
          <PostProcessOperation>Do Nothing</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 400 Bad Request">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>400 Bad Request</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="Bad Request Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/fhir+json:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Method Not Allowed">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.internal.SynchronousResponseTransport" name="Method Not Allowed Response" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.StaticFileProcessor" name="Load 405 Outcome">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <FileName>outcomes/operation-outcome-405.json</FileName>
          <PostProcessOperation>Do Nothing</PostProcessOperation>
          <TargetDirectory />
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.HttpResponseCodeProcessor" name="Set 405">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <StatusCode>405 Method Not Allowed</StatusCode>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.http.AddHttpResponseHeadersProcessor" name="Method Not Allowed Headers">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <HeaderTable>[eip_pair:Content-Type:eip_name:application/fhir+json:eip_value]</HeaderTable>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
