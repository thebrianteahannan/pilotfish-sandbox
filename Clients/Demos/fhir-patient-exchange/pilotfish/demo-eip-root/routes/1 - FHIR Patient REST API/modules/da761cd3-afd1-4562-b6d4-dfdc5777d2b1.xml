<Module version="2.0" id="da761cd3-afd1-4562-b6d4-dfdc5777d2b1" name="Extract MRN" type="RegExIntoTransactionAttributeProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
