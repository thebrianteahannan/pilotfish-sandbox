<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="f7dafc99-3611-4114-869d-2c66ea36bf32" name="Extract MRN" type="RegEx to Attribute" tag="Processor" class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <RegEx>"value"\s*:\s*"(MRN-[^"]+)"</RegEx>
      
          
      <AttributeName>fhir.PatientId</AttributeName>
      
          
      <MatchGroupNumber>1</MatchGroupNumber>
      
        
   </ModuleConfig>
</Module>
