<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="1da03a3f-6105-4789-84c5-2a30d411102b" name="Upsert Patient SQL" type="Database (SQL)" tag="Processor" class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor">
   <ModuleConfig>
      <InputFile/>
      
          
      <WriteQuery>true</WriteQuery>
      
          
      <Query>MERGE dbo.FhirResources AS t
USING (SELECT ? AS ResourceType, ? AS ResourceId, ? AS RawFhir, ? AS PatientId) AS s
ON t.ResourceType = s.ResourceType AND t.ResourceId = s.ResourceId
WHEN MATCHED THEN UPDATE SET RawFhir = s.RawFhir, PatientId = s.PatientId, ValidationStatus = 'PASS', SourceCode = 'REST', ReceivedAt = SYSUTCDATETIME()
WHEN NOT MATCHED THEN INSERT (SourceCode, ResourceType, ResourceId, PatientId, PatientName, IsBundle, ValidationStatus, SourceFile, RawFhir)
VALUES ('REST', s.ResourceType, s.ResourceId, s.PatientId, '', 0, 'PASS', 'rest-api', s.RawFhir)
OUTPUT INSERTED.ResourceRowId AS ResourceRowId;</Query>
      
          
      <QueryParams>[eip_pair:p1:eip_name:Patient:eip_value][eip_pair:p2:eip_name:{ognl:getAttribute('fhir.LogicalId')}:eip_value][eip_pair:p3:eip_name:{ognl:getAttribute('fhir.RawBody')}:eip_value][eip_pair:p4:eip_name:{ognl:getAttribute('fhir.PatientId')}:eip_value]</QueryParams>
      
          
      <UserName>$$sqlserver.username</UserName>
      
          
      <Password>$$sqlserver.password</Password>
      
          
      <UseDataSource>false</UseDataSource>
      
          
      <DataSource/>
      
          
      <JdbcDriver>$$sqlserver.driver</JdbcDriver>
      
          
      <JdbcURL>$$sqlserver.url</JdbcURL>
      
          
      <KeepConnection>false</KeepConnection>
      
          
      <Autocommit>true</Autocommit>
      
          
      <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
      
          
      <Timeout>60</Timeout>
      
          
      <RestrictMetaDataToCatalog/>
      
          
      <RestrictMetaDataToSchema/>
      
          
      <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
      
          
      <UseSingleOutputStream>true</UseSingleOutputStream>
      
          
      <RefreshHandler>false</RefreshHandler>
      
          
      <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
      
          
      <JDBCProperties>null</JDBCProperties>
      
          
      <LogMetadata>false</LogMetadata>
      
          
      <LogSQL>true</LogSQL>
      
        
   </ModuleConfig>
</Module>
