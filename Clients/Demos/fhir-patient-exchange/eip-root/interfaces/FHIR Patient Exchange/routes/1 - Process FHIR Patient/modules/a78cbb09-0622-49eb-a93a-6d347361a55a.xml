<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="a78cbb09-0622-49eb-a93a-6d347361a55a" name="Write Kickout" type="Directory / File" tag="Transport" class="com.pilotfish.eip.modules.file.DirectoryTransport">
   <ModuleConfig>
      <TargetDirectory>$$FHIR_KICKOUT_DIRECTORY</TargetDirectory>
      
        
      <FileName>{ognl:getAttribute('com.pilotfish.FileName') + '_kickout'}</FileName>
      
        
      <FileExtension>xml</FileExtension>
      
        
      <UseFullFilePath>Disabled</UseFullFilePath>
      
        
      <FullPathToFile/>
      
        
      <AppendToFile>Overwrite</AppendToFile>
      
        
      <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
      
        
      <FileNameConflictPattern/>
      
        
      <BatchSensitive>false</BatchSensitive>
      
        
      <Command/>
      
        
      <Shell>/bin/bash</Shell>
      
      
   </ModuleConfig>
</Module>
