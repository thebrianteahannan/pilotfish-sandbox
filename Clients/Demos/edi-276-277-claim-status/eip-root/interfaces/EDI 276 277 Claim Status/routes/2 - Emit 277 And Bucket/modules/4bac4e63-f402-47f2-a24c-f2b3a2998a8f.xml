<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="4bac4e63-f402-47f2-a24c-f2b3a2998a8f" name="Conditional Router" type="Conditional Node Router" tag="RoutingModule" class="com.pilotfish.eip.modules.internal.ConditionalNodeRoutingModule">
   <ModuleConfig>
      <SelectionMode>FIRST_MATCH</SelectionMode>
      <RoutingPorts version="1">
         <inputs>
            <input id="afe4addd-b73f-477b-a4a5-f0da30a3a915" name="Input"/>
         </inputs>
         <outputs>
            <output id="543237a8-c684-4056-84be-c2353f1588d4" name="Rule 1 - Emit 277 Response" type="XPATH">
               <condition>boolean(//DecisionBucket)</condition>
            </output>
            <output id="fb9f58ad-6e1b-4e3b-a6b8-eb655b73443e" name="Rule 2 - Write Found" type="XPATH">
               <condition>//DecisionBucket = 'found'</condition>
            </output>
            <output id="feff7d2f-d225-4bc2-9075-7e034df999a4" name="Rule 3 - Write Not Found" type="XPATH">
               <condition>//DecisionBucket = 'not-found'</condition>
            </output>
            <output id="0181e128-6196-418c-bb9a-50ec72c719a4" name="Rule 4 - Write Error" type="XPATH">
               <condition>//DecisionBucket = 'error'</condition>
            </output>
         </outputs>
      </RoutingPorts>
   </ModuleConfig>
</Module>
