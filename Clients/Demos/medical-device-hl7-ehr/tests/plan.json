{
  "version": 1,
  "interface": "Medical Device HL7 EHR",
  "description": "Device ORU via LLP \u2192 validate \u2192 EHR mock forward.",
  "base_urls": {
    "webui": "http://127.0.0.1:8101",
    "eip": "http://127.0.0.1:8100/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8101/",
    "http://127.0.0.1:8101/api/status"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "status",
          "name": "Status API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/status"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        },
        {
          "id": "sample-exists",
          "name": "Vitals sample present",
          "type": "file",
          "file": {
            "path": "samples/VITALS_ORU_panel.hl7",
            "exists": true
          }
        }
      ]
    }
  ]
}
