{
  "version": 1,
  "interface": "EDI 837 Claim Scrub",
  "description": "SQL claims \u2192 payer edits \u2192 kickout or clean 837+SNIP before clearinghouse.",
  "base_urls": {
    "webui": "http://127.0.0.1:8115",
    "eip": "http://127.0.0.1:8114/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8115/",
    "http://127.0.0.1:8115/api/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200,
            "contains": [
              "Claim Scrub",
              "Kickout"
            ]
          }
        },
        {
          "id": "api-health",
          "name": "API health",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/health"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        },
        {
          "id": "claims",
          "name": "Claims API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/claims"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "kickouts",
          "name": "Kickouts API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/kickouts"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "payer-rules",
          "name": "Payer rules seeded",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/payer-rules"
          },
          "expect": {
            "status": 200,
            "contains": [
              "MISSING_REFERRING_NPI",
              "INVALID_POS",
              "66783JJT"
            ]
          }
        },
        {
          "id": "snip-html-report",
          "name": "SNIP report returns real HTML (not escaped XML)",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/snip-report?name=5001_CLM-5001_snip.xml"
          },
          "expect": {
            "status": 200,
            "contains": ["<html", "</html>"],
            "not_contains": ["&lt;EdiValidationResults"]
          }
        }
      ]
    },
    {
      "id": "documents",
      "name": "Review PDFs",
      "tests": [
        {
          "id": "test-results-alias",
          "name": "Test results PDF serves",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/documents/test-results.pdf"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "capability-alias",
          "name": "Capability brief alias",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/documents/capability-brief.pdf"
          },
          "expect": {
            "status_in": [
              200,
              404
            ]
          }
        }
      ]
    }
  ]
}
