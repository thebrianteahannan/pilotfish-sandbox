<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule">
    <ModuleConfig />
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Inbound 835 Remits">
    <FormatProfile name="Split 835 Transactions" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Poll EDI 835 Files">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>5</PollingInterval>
        <PollingDirectory>$$EDI_INBOUND_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>edi,835,txt</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Move</PostProcessOperation>
        <TargetDirectory>$$EDI_ARCHIVE_DIRECTORY</TargetDirectory>
        <CompatModeMoved>false</CompatModeMoved>
        <Tokenizers />
        <SerializedTransactionsTag>1</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="Score Remit Against Open AR">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Stage Remit Decision" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$STAGED_DECISION_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('ClaimControlNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('ClaimControlNumber')).trim().isEmpty() ? getAttribute('ClaimControlNumber') : 'unknown') + '_' + (getAttribute('StControlNumber') != null ? getAttribute('StControlNumber') : 'st') + '_decision'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract CLP Remit Fields">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:ClaimControlNumber:eip_name:normalize-space(string((//CLP/CLP01 | //*[local-name()='CLP']/*[local-name()='CLP01'] | //*[local-name()='Segment'][*[local-name()='Element'][1]='CLP']/*[local-name()='Element'][2])[1])):eip_value][eip_pair:ChargeAmount:eip_name:normalize-space(string((//CLP/CLP03 | //*[local-name()='CLP']/*[local-name()='CLP03'] | //*[local-name()='Segment'][*[local-name()='Element'][1]='CLP']/*[local-name()='Element'][4])[1])):eip_value][eip_pair:PaidAmount:eip_name:normalize-space(string((//CLP/CLP04 | //*[local-name()='CLP']/*[local-name()='CLP04'] | //*[local-name()='Segment'][*[local-name()='Element'][1]='CLP']/*[local-name()='Element'][5])[1])):eip_value][eip_pair:CasCodes:eip_name:string-join((//CAS | //*[local-name()='CAS'])/concat(normalize-space(string((CAS01|*[local-name()='CAS01'])[1])), ':', normalize-space(string((CAS02|*[local-name()='CAS02'])[1])), ':', normalize-space(string((CAS03|*[local-name()='CAS03'])[1]))), '|'):eip_value][eip_pair:StControlNumber:eip_name:normalize-space(string((/*[local-name()='Transaction']/@ControlNumber | //*[local-name()='Transaction']/@ControlNumber | //ST/ST02 | //*[local-name()='ST']/*[local-name()='ST02'])[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write Forked Transaction">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$DEBUG_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:(getAttribute('ClaimControlNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('ClaimControlNumber')).trim().isEmpty() ? getAttribute('ClaimControlNumber') : 'unknown') + '_' + (getAttribute('StControlNumber') != null ? getAttribute('StControlNumber') : 'st') + '_txn.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Lookup Open AR">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>SELECT TOP 1 ClaimControlNumber, PatientLastName, PatientFirstName, ExpectedPaid, BilledAmount, Status, Notes FROM dbo.OpenAR WHERE ClaimControlNumber = ?</Query>
          <QueryParams>[eip_pair:ClaimControlNumber:eip_name:{ognl:getAttribute('ClaimControlNumber')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract Open AR Fields">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:ExpectedPaid:eip_name:normalize-space(string((.//*[upper-case(local-name())='EXPECTEDPAID'])[1])):eip_value][eip_pair:PatientLastName:eip_name:normalize-space(string((.//*[upper-case(local-name())='PATIENTLASTNAME'])[1])):eip_value][eip_pair:PatientFirstName:eip_name:normalize-space(string((.//*[upper-case(local-name())='PATIENTFIRSTNAME'])[1])):eip_value][eip_pair:ArStatus:eip_name:normalize-space(string((.//*[upper-case(local-name())='STATUS'])[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Compose Patient Name">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
          <AttributePairs>[eip_pair:PatientName:eip_name:{ognl:@java.lang.String@valueOf(getAttribute('PatientLastName') == null ? '' : getAttribute('PatientLastName')).trim() + ((getAttribute('PatientFirstName') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('PatientFirstName')).trim().isEmpty()) ? (',' + @java.lang.String@valueOf(getAttribute('PatientFirstName')).trim()) : '')}:eip_value]</AttributePairs>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Build Remit Decision XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>build-remit-decision.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>[eip_pair:ClaimControlNumber:eip_name:{ognl:getAttribute('ClaimControlNumber')}:eip_value][eip_pair:PaidAmount:eip_name:{ognl:getAttribute('PaidAmount')}:eip_value][eip_pair:ChargeAmount:eip_name:{ognl:getAttribute('ChargeAmount')}:eip_value][eip_pair:CasCodes:eip_name:{ognl:getAttribute('CasCodes')}:eip_value][eip_pair:ExpectedPaid:eip_name:{ognl:getAttribute('ExpectedPaid')}:eip_value][eip_pair:PatientName:eip_name:{ognl:getAttribute('PatientName')}:eip_value][eip_pair:SourceFile:eip_name:{ognl:getAttribute('com.pilotfish.FileName')}:eip_value]</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write Remit Decision">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$DEBUG_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:(getAttribute('ClaimControlNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('ClaimControlNumber')).trim().isEmpty() ? getAttribute('ClaimControlNumber') : 'unknown') + '_decision.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
