<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="Write Matched" />
            <TransportTarget name="Update AR Matched" />
          </Targets>
          <Condition>
            <Expression>
              //MatchBucket = 'matched'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Write Exception" />
            <TransportTarget name="Update AR Exception" />
          </Targets>
          <Condition>
            <Expression>
              //MatchBucket = 'exception'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Append Underpay Alert" />
          </Targets>
          <Condition>
            <Expression>
              //UnderpayFlag = 'true'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Staged Remit Decisions">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Poll Staged Remit Decisions">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>3</PollingInterval>
        <PollingDirectory>$$STAGED_DECISION_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>xml</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>1</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract Decision Attributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:ClaimControlNumber:eip_name:normalize-space(string((//ClaimControlNumber)[1])):eip_value][eip_pair:Reason:eip_name:normalize-space(string((//Reason)[1])):eip_value][eip_pair:MatchBucket:eip_name:normalize-space(string((//MatchBucket)[1])):eip_value][eip_pair:UnderpayFlag:eip_name:normalize-space(string((//UnderpayFlag)[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="Matched">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Write Matched" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$MATCHED_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('ClaimControlNumber') != null ? getAttribute('ClaimControlNumber') : 'unknown') + '_matched'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target icon="" name="Update AR Matched">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.other.NullTransport" name="Update AR Matched" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Mark Open AR Matched">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>UPDATE dbo.OpenAR SET Status = N'MATCHED', Notes = CONCAT(ISNULL(Notes, N''), N' | matched by remit'), UpdatedAt = SYSUTCDATETIME() WHERE ClaimControlNumber = ?</Query>
          <QueryParams>[eip_pair:ClaimControlNumber:eip_name:{ognl:getAttribute('ClaimControlNumber')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Exception">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Write Exception" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$EXCEPTION_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('ClaimControlNumber') != null ? getAttribute('ClaimControlNumber') : 'unknown') + '_exception'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
  </Target>
  <Target icon="" name="Update AR Exception">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.other.NullTransport" name="Update AR Exception" retries="1" />
    <Processors>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Mark Open AR Exception">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>UPDATE dbo.OpenAR SET Status = CASE WHEN ? = N'UNDERPAY' THEN N'UNDERPAY' ELSE N'EXCEPTION' END, Notes = CONCAT(ISNULL(Notes, N''), N' | ', ?), UpdatedAt = SYSUTCDATETIME() WHERE ClaimControlNumber = ?</Query>
          <QueryParams>[eip_pair:Reason:eip_name:{ognl:getAttribute('Reason')}:eip_value][eip_pair:ReasonNote:eip_name:{ognl:getAttribute('Reason')}:eip_value][eip_pair:ClaimControlNumber:eip_name:{ognl:getAttribute('ClaimControlNumber')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Underpay Alerts">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Append Underpay Alert" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$UNDERPAY_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>underpay_alerts</FileName>
        <FileExtension>csv</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Append</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map Decision To Underpay CSV Row">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>decision-to-underpay-csv.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
