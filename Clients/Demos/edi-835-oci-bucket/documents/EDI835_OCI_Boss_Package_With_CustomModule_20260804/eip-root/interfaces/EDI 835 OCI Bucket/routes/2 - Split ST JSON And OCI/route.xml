<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule">
    <ModuleConfig />
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Staged 835">
    <FormatProfile name="Split 835 Transactions" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Poll Staged EDI And Fork ST">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>5</PollingInterval>
        <PollingDirectory>$$STAGED_EDI_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>edi,835,txt</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>50</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="JSON to OCI">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.oci.OciObjectStorageTransport" name="OCI Object Storage PutObject" retries="3" retryDelayMs="2000">
      <ModuleConfig>
        <OciRegion>us-ashburn-1</OciRegion>
        <OciNamespace>floci-local</OciNamespace>
        <OciBucket>edi-835-payments</OciBucket>
        <OciObjectName>{ognl:getAttribute('OciObjectName')}</OciObjectName>
        <OciContentType>application/json</OciContentType>
        <OciEndpoint>http://floci-oci:4599</OciEndpoint>
        <OciAuthMode>API Key</OciAuthMode>
        <OciTenancyOcid>ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000</OciTenancyOcid>
        <OciUserOcid>ocid1.user.oc1..flocilocaluser0000000000000000000000000000000000000000000000</OciUserOcid>
        <OciFingerprint>31:52:38:16:49:97:52:da:62:58:63:5e:fe:ad:c7:9c</OciFingerprint>
        <OciPrivateKeyPath>/oci-config/floci_key.pem</OciPrivateKeyPath>
        <OciPrivateKeyPem />
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Read ST Control Number">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:StControlNumber:eip_name:normalize-space(string((/*[local-name()='Transaction']/@ControlNumber | //*[local-name()='Transaction']/@ControlNumber | //*[local-name()='Segment'][*[local-name()='Element'][1]='ST']/*[local-name()='Element'][3])[1])):eip_value][eip_pair:DocType:eip_name:normalize-space(string((/*[local-name()='Transaction']/@DocType | //*[local-name()='Transaction']/@DocType | //*[local-name()='Segment'][*[local-name()='Element'][1]='ST']/*[local-name()='Element'][2])[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set OCI Object Name">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>OciObjectName</AttributeName>
          <Expression>{ognl:'835_' + (getAttribute('StControlNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('StControlNumber')).trim().isEmpty() ? getAttribute('StControlNumber') : 'unknown') + '_' + @java.lang.System@currentTimeMillis() + '.json'}</Expression>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
          <AttributePairs>[eip_pair:OciObjectName:eip_name:{ognl:'835_' + (getAttribute('StControlNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('StControlNumber')).trim().isEmpty() ? getAttribute('StControlNumber') : 'unknown') + '_' + @java.lang.System@currentTimeMillis() + '.json'}:eip_value]</AttributePairs>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.internal.TransactionAttributePopulationProcessor" name="Set OCI Object URL">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeName>OciObjectUrl</AttributeName>
          <Expression>{ognl:'http://floci-oci:4599/n/floci-local/b/edi-835-payments/o/' + getAttribute('OciObjectName')}</Expression>
          <AttributeScope>Transaction</AttributeScope>
          <GlobalAttributes>BUCKET</GlobalAttributes>
          <AttributePairs>[eip_pair:OciObjectUrl:eip_name:{ognl:'http://floci-oci:4599/n/floci-local/b/edi-835-payments/o/' + getAttribute('OciObjectName')}:eip_value]</AttributePairs>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write Transaction XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$JSON_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:getAttribute('OciObjectName').replace('.json','.xml')}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map Transaction XML To JSON">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>transform-transaction-to-json.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Archive JSON Object">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$JSON_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:getAttribute('OciObjectName')}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
