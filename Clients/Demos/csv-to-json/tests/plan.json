{
  "version": 1,
  "interface": "CSV to JSON",
  "description": "Directory poll CSV \u2192 JSON conversion via Web UI / inbound drop.",
  "base_urls": {
    "webui": "http://127.0.0.1:8109",
    "eip": "http://127.0.0.1:8108/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8109/",
    "http://127.0.0.1:8109/api/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200,
            "contains": [
              "CSV",
              "JSON"
            ]
          }
        },
        {
          "id": "api-health",
          "name": "API health",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/health"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        }
      ]
    },
    {
      "id": "convert",
      "name": "Convert sample",
      "tests": [
        {
          "id": "drop-sample",
          "name": "Copy sample CSV into inbound",
          "type": "shell",
          "shell": {
            "command": "mkdir -p input/inbound && cp -f samples/SAMPLE-01_patients.csv input/inbound/"
          },
          "expect": {
            "exit_code": 0
          }
        },
        {
          "id": "json-out",
          "name": "JSON output appears",
          "type": "file",
          "file": {
            "path": "output/json/SAMPLE-01_patients.json",
            "exists": true,
            "timeout_sec": 90,
            "contains": [
              "records"
            ]
          }
        }
      ]
    },
    {
      "id": "docs",
      "name": "Documents",
      "tests": [
        {
          "id": "route-pdf",
          "name": "Route PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/CSV_to_JSON_V2_Route_Diagrams.pdf",
            "exists": true
          }
        },
        {
          "id": "brief-pdf",
          "name": "Capability Brief PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/CSV_to_JSON_Capability_Brief.pdf",
            "exists": true
          }
        },
        {
          "id": "test-plan-pdf",
          "name": "Test Plan PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/CSV_to_JSON_Test_Plan.pdf",
            "exists": true
          }
        }
      ]
    }
  ]
}
