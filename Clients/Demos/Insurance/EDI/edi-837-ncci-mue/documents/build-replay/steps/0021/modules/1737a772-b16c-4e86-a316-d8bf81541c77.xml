<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="1737a772-b16c-4e86-a316-d8bf81541c77" name="Write Kickout" type="Directory / File" tag="Transport" class="com.pilotfish.eip.modules.file.DirectoryTransport">
