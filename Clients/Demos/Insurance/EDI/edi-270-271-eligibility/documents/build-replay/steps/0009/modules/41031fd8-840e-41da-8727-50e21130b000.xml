<Module version="2.0" id="41031fd8-840e-41da-8727-50e21130b000" name="Conditional Router" type="Conditional Node Router" tag="RoutingModule" class="com.pilotfish.eip.modules.internal.ConditionalNodeRoutingModule">
   <ModuleConfig>
      <SelectionMode>FIRST_MATCH</SelectionMode>
      <RoutingPorts version="1">
         <inputs>
            <input id="7ba5a150-9672-4f1b-91a1-87779ad8ef4b" name="Input"/>
         </inputs>
         <outputs>
            <output id="e9db809d-3d9b-46a1-a4b5-173769b3819f" name="Rule 1 - Return 270" type="XPATH">
               <condition>getAttribute('com.pilotfish.HttpMethodName') == 'POST' &amp;&amp; 'build'.equalsIgnoreCase(getAttribute('com.pilotfish.ResourceName'))</condition>
