<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="true">
        <Rule>
          <Targets>
            <TransportTarget name="Emit 277 Response" />
          </Targets>
          <Condition>
            <Expression>
              boolean(//DecisionBucket)
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Write Found" />
          </Targets>
          <Condition>
            <Expression>
              //DecisionBucket = 'found'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Write Not Found" />
          </Targets>
          <Condition>
            <Expression>
              //DecisionBucket = 'not-found'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
        <Rule>
          <Targets>
            <TransportTarget name="Write Error" />
          </Targets>
          <Condition>
            <Expression>
              //DecisionBucket = 'error'
              <Namespaces />
            </Expression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Staged Claim Status Decisions">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Poll Staged Claim Status Decisions">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>3</PollingInterval>
        <PollingDirectory>$$STAGED_DECISION_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>xml</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Delete</PostProcessOperation>
        <TargetDirectory />
        <Tokenizers />
        <SerializedTransactionsTag>1</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract Decision Attributes">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:TraceNumber:eip_name:normalize-space(string((//TraceNumber)[1])):eip_value][eip_pair:DecisionBucket:eip_name:normalize-space(string((//DecisionBucket)[1])):eip_value][eip_pair:Reason:eip_name:normalize-space(string((//Reason)[1])):eip_value][eip_pair:StatusCode:eip_name:normalize-space(string((//StatusCode)[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="277 Response">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Emit 277 Response" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$RESPONSE_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('TraceNumber') != null ? getAttribute('TraceNumber') : 'unknown') + '_277_response'}</FileName>
        <FileExtension>edi</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Map Decision To 277 EDI XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>transform-decision-to-277-edi-xml.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>null</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XMLFormattingProcessor" name="Pretty-Print 277 EDI XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write 277 EDI XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$DEBUG_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:(getAttribute('TraceNumber') != null ? getAttribute('TraceNumber') : 'unknown') + '_277_edi.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.EDITransformationProcessor" name="XML to EDI 277 Response">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <ExecuteTransformation>true</ExecuteTransformation>
          <TransformationDirection>XML to EDI</TransformationDirection>
          <UseInternalData>false</UseInternalData>
          <USE_ENHANCED_CONTEXT>true</USE_ENHANCED_CONTEXT>
          <TransactionDataWithVersion>[eip_pair:{ognl:@com.pilotfish.utils.PilotFishUtils@getWorkingDirectory()+'/edi-tabledata/277-A1'}:eip_name:5010:eip_value]</TransactionDataWithVersion>
          <FriendlyNamesLevel>None</FriendlyNamesLevel>
          <CODE_DEFS>false</CODE_DEFS>
          <SegmentIndexing>true</SegmentIndexing>
          <OutputEndlines>true</OutputEndlines>
          <UseProvidedDelimiters>true</UseProvidedDelimiters>
          <DataDelimiter>*</DataDelimiter>
          <SubDelimiter>:</SubDelimiter>
          <RepetitionDelimiter>^</RepetitionDelimiter>
          <RecordDelimiter>~</RecordDelimiter>
          <USE_LEGACY_FORMAT>false</USE_LEGACY_FORMAT>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Found">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Write Found" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$FOUND_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('TraceNumber') != null ? getAttribute('TraceNumber') : 'unknown') + '_found'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XMLFormattingProcessor" name="Pretty-Print Found XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Not Found">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Write Not Found" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$NOT_FOUND_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('TraceNumber') != null ? getAttribute('TraceNumber') : 'unknown') + '_not_found'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XMLFormattingProcessor" name="Pretty-Print Not Found XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
  <Target icon="" name="Error">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Write Error" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$ERROR_OUTPUT_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('TraceNumber') != null ? getAttribute('TraceNumber') : 'unknown') + '_error'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.transform.XMLFormattingProcessor" name="Pretty-Print Error XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
