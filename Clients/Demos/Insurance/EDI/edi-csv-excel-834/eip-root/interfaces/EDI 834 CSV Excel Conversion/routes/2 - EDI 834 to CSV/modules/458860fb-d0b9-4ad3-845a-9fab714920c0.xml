<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="458860fb-d0b9-4ad3-845a-9fab714920c0" name="Write Enrollment CSV" type="Directory / File" tag="Transport" class="com.pilotfish.eip.modules.file.DirectoryTransport">
   <ModuleConfig>
      <TargetDirectory>$$CSV_OUTPUT_DIRECTORY</TargetDirectory>
      
        
      <FileName>{ognl:getAttribute('com.pilotfish.FileName')}</FileName>
      
        
      <FileExtension>csv</FileExtension>
      
        
      <UseFullFilePath>Disabled</UseFullFilePath>
      
        
      <FullPathToFile/>
      
        
      <AppendToFile>Overwrite</AppendToFile>
      
        
      <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
      
        
      <FileNameConflictPattern/>
      
        
      <BatchSensitive>false</BatchSensitive>
      
        
      <Command/>
      
        
      <Shell>/bin/bash</Shell>
      
      
   </ModuleConfig>
</Module>
