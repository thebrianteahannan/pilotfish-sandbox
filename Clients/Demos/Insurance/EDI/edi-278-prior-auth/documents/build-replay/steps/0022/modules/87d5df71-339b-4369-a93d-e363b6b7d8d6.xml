<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="87d5df71-339b-4369-a93d-e363b6b7d8d6" name="Conditional Router" type="Conditional Node Router" tag="RoutingModule" class="com.pilotfish.eip.modules.internal.ConditionalNodeRoutingModule">
