<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.internal.NullRoutingModule">
    <ModuleConfig />
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Inbound 278 Prior Auths">
    <FormatProfile name="Split 278 Transactions" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Poll EDI 278 Files">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <StopWhenPollingFailure>true</StopWhenPollingFailure>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>5</PollingInterval>
        <PollingDirectory>$$EDI_INBOUND_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>edi,278,txt</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Move</PostProcessOperation>
        <TargetDirectory>$$EDI_ARCHIVE_DIRECTORY</TargetDirectory>
        <CompatModeMoved>false</CompatModeMoved>
        <Tokenizers />
        <SerializedTransactionsTag>1</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
      </ModuleConfig>
    </Listener>
  </Source>
  <Target icon="" name="Apply Completeness And Stage">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.file.DirectoryTransport" name="Stage Auth Decision" retries="1">
      <ModuleConfig>
        <TargetDirectory>$$STAGED_DECISION_DIRECTORY</TargetDirectory>
        <FileName>{ognl:(getAttribute('AuthTraceNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('AuthTraceNumber')).trim().isEmpty() ? getAttribute('AuthTraceNumber') : 'unknown') + '_' + (getAttribute('StControlNumber') != null ? getAttribute('StControlNumber') : 'st') + '_decision'}</FileName>
        <FileExtension>xml</FileExtension>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <AppendToFile>Overwrite</AppendToFile>
        <MAXIMUM_MEMORY_SIZE>-1</MAXIMUM_MEMORY_SIZE>
        <FileNameConflictPattern />
        <BatchSensitive>false</BatchSensitive>
        <Command />
        <Shell>/bin/bash</Shell>
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract 278 Auth Fields">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:AuthTraceNumber:eip_name:normalize-space(string((//TRN/TRN02 | //*[local-name()='TRN']/*[local-name()='TRN02'] | //BHT/BHT03 | //*[local-name()='BHT']/*[local-name()='BHT03'])[1])):eip_value][eip_pair:MemberId:eip_name:normalize-space(string((//NM1[NM101='IL']/NM109 | //*[local-name()='NM1'][*[local-name()='NM101']='IL']/*[local-name()='NM109'])[1])):eip_value][eip_pair:PatientLastName:eip_name:normalize-space(string((//NM1[NM101='IL']/NM103 | //*[local-name()='NM1'][*[local-name()='NM101']='IL']/*[local-name()='NM103'])[1])):eip_value][eip_pair:PatientFirstName:eip_name:normalize-space(string((//NM1[NM101='IL']/NM104 | //*[local-name()='NM1'][*[local-name()='NM101']='IL']/*[local-name()='NM104'])[1])):eip_value][eip_pair:ProcedureCode:eip_name:normalize-space(string((//SV1/SV101/SV101_02 | //*[local-name()='SV101_02'])[1])):eip_value][eip_pair:DiagnosisCode:eip_name:normalize-space(string((//HI/HI01/HI01_02 | //*[local-name()='HI01_02'])[1])):eip_value][eip_pair:AttachmentFlag:eip_name:if ((//PWK | //*[local-name()='PWK'] | //REF[REF01='EA'] | //*[local-name()='REF'][*[local-name()='REF01']='EA'])[1]) then 'Y' else 'N':eip_value][eip_pair:StControlNumber:eip_name:normalize-space(string((/*[local-name()='Transaction']/@ControlNumber | //Transaction/@ControlNumber | //ST/ST02 | //*[local-name()='ST']/*[local-name()='ST02'])[1])):eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write Forked Transaction">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$DEBUG_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:(getAttribute('AuthTraceNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('AuthTraceNumber')).trim().isEmpty() ? getAttribute('AuthTraceNumber') : 'unknown') + '_' + (getAttribute('StControlNumber') != null ? getAttribute('StControlNumber') : 'st') + '_txn.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor" name="Lookup Auth Catalog">
        <ModuleConfig>
          <InputFile />
          <WriteQuery>true</WriteQuery>
          <Query>SELECT TOP 1 ProcedureCode, RequiresDiagnosis, RequiresAttachment, DefaultDisposition, Notes FROM dbo.AuthCatalog WHERE ProcedureCode = ?</Query>
          <QueryParams>[eip_pair:ProcedureCode:eip_name:{ognl:getAttribute('ProcedureCode')}:eip_value]</QueryParams>
          <UserName>$$sqlserver.username</UserName>
          <Password>$$sqlserver.password</Password>
          <UseDataSource>false</UseDataSource>
          <DataSource />
          <JdbcDriver>$$sqlserver.driver</JdbcDriver>
          <JdbcURL>$$sqlserver.url</JdbcURL>
          <KeepConnection>false</KeepConnection>
          <Autocommit>true</Autocommit>
          <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
          <Timeout>60</Timeout>
          <RestrictMetaDataToCatalog />
          <RestrictMetaDataToSchema />
          <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
          <UseSingleOutputStream>true</UseSingleOutputStream>
          <RefreshHandler>false</RefreshHandler>
          <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
          <JDBCProperties>null</JDBCProperties>
          <LogMetadata>false</LogMetadata>
          <LogSQL>true</LogSQL>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor" name="Extract Auth Catalog Fields">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <AttributeScope>Transaction</AttributeScope>
          <XPathExpressions>[eip_pair:RequiresDiagnosis:eip_name:normalize-space(string((.//*[upper-case(local-name())='REQUIRESDIAGNOSIS'])[1])):eip_value][eip_pair:RequiresAttachment:eip_name:normalize-space(string((.//*[upper-case(local-name())='REQUIRESATTACHMENT'])[1])):eip_value][eip_pair:DefaultDisposition:eip_name:normalize-space(string((.//*[upper-case(local-name())='DEFAULTDISPOSITION'])[1])):eip_value][eip_pair:CatalogFound:eip_name:if ((.//*[upper-case(local-name())='PROCEDURECODE'])[1]) then 'true' else 'false':eip_value]</XPathExpressions>
          <GlobalAttributeExpressions />
          <Namespaces>null</Namespaces>
          <Namespace />
          <XPath1Compatibility>false</XPath1Compatibility>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.transform.XSLTProcessor" name="Build Auth Decision XML">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <XSLTPath>build-auth-decision.xslt</XSLTPath>
          <CacheXSLTToXML>false</CacheXSLTToXML>
          <XSLTEngine>Saxon</XSLTEngine>
          <XSLTParameters>[eip_pair:AuthTraceNumber:eip_name:{ognl:getAttribute('AuthTraceNumber')}:eip_value][eip_pair:MemberId:eip_name:{ognl:getAttribute('MemberId')}:eip_value][eip_pair:PatientLastName:eip_name:{ognl:getAttribute('PatientLastName')}:eip_value][eip_pair:PatientFirstName:eip_name:{ognl:getAttribute('PatientFirstName')}:eip_value][eip_pair:ProcedureCodeRaw:eip_name:{ognl:getAttribute('ProcedureCode')}:eip_value][eip_pair:DiagnosisCodeRaw:eip_name:{ognl:getAttribute('DiagnosisCode')}:eip_value][eip_pair:AttachmentFlag:eip_name:{ognl:getAttribute('AttachmentFlag')}:eip_value][eip_pair:RequiresDiagnosis:eip_name:{ognl:getAttribute('RequiresDiagnosis')}:eip_value][eip_pair:RequiresAttachment:eip_name:{ognl:getAttribute('RequiresAttachment')}:eip_value][eip_pair:DefaultDisposition:eip_name:{ognl:getAttribute('DefaultDisposition')}:eip_value][eip_pair:CatalogFound:eip_name:{ognl:getAttribute('CatalogFound')}:eip_value][eip_pair:SourceFile:eip_name:{ognl:getAttribute('com.pilotfish.FileName')}:eip_value]</XSLTParameters>
          <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
          <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
        </ModuleConfig>
      </Processor>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Debug Write Auth Decision">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$DEBUG_OUTPUT_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:(getAttribute('AuthTraceNumber') != null &amp;&amp; !@java.lang.String@valueOf(getAttribute('AuthTraceNumber')).trim().isEmpty() ? getAttribute('AuthTraceNumber') : 'unknown') + '_decision.xml'}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
