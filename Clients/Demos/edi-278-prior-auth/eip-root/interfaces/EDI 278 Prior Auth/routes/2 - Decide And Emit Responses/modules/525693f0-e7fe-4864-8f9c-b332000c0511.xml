<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="525693f0-e7fe-4864-8f9c-b332000c0511" name="Mark Auth Request Status" type="Database (SQL)" tag="Processor" class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor">
   <ModuleConfig>
      <InputFile/>
      
          
      <WriteQuery>true</WriteQuery>
      
          
      <Query>UPDATE dbo.AuthRequest SET Status = ?, Notes = CONCAT(ISNULL(Notes, N''), N' | ', ?), UpdatedAt = SYSUTCDATETIME() WHERE AuthTraceNumber = ?; SELECT @@ROWCOUNT AS RowsAffected;</Query>
      
          
      <QueryParams>[eip_pair:StatusValue:eip_name:{ognl:getAttribute('StatusValue')}:eip_value][eip_pair:Reason:eip_name:{ognl:getAttribute('Reason')}:eip_value][eip_pair:AuthTraceNumber:eip_name:{ognl:getAttribute('AuthTraceNumber')}:eip_value]</QueryParams>
      
          
      <UserName>$$sqlserver.username</UserName>
      
          
      <Password>$$sqlserver.password</Password>
      
          
      <UseDataSource>false</UseDataSource>
      
          
      <DataSource/>
      
          
      <JdbcDriver>$$sqlserver.driver</JdbcDriver>
      
          
      <JdbcURL>$$sqlserver.url</JdbcURL>
      
          
      <KeepConnection>false</KeepConnection>
      
          
      <Autocommit>true</Autocommit>
      
          
      <UseJdbcGeneratedKeys>false</UseJdbcGeneratedKeys>
      
          
      <Timeout>60</Timeout>
      
          
      <RestrictMetaDataToCatalog/>
      
          
      <RestrictMetaDataToSchema/>
      
          
      <RestrictMetaDataToTable>%</RestrictMetaDataToTable>
      
          
      <UseSingleOutputStream>true</UseSingleOutputStream>
      
          
      <RefreshHandler>false</RefreshHandler>
      
          
      <ErrorOnUnknownElement>false</ErrorOnUnknownElement>
      
          
      <JDBCProperties>null</JDBCProperties>
      
          
      <LogMetadata>false</LogMetadata>
      
          
      <LogSQL>true</LogSQL>
      
        
   </ModuleConfig>
</Module>
