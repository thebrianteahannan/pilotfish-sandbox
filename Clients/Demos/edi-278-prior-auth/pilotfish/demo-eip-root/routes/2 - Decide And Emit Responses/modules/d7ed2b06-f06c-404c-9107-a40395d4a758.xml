<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="d7ed2b06-f06c-404c-9107-a40395d4a758" name="Write Pended" type="Directory / File" tag="Transport" class="com.pilotfish.eip.modules.file.DirectoryTransport">
   <ModuleConfig>
