{
  "version": 1,
  "interface": "EDI 278 Prior Auth",
  "description": "Directory drop EDI 278 → completeness rules → simulated payer → 278 response + ORU notice + buckets.",
  "base_urls": {
    "webui": "http://127.0.0.1:8121",
    "eip": "http://127.0.0.1:8120/eip"
  },
  "healthcheck_urls": [
    "http://127.0.0.1:8121/",
    "http://127.0.0.1:8121/api/health"
  ],
  "suites": [
    {
      "id": "health",
      "name": "Health",
      "tests": [
        {
          "id": "webui",
          "name": "Web UI loads",
          "type": "ui",
          "ui": {
            "url": "{webui}/"
          },
          "expect": {
            "status": 200,
            "contains": [
              "Prior Auth",
              "278"
            ]
          }
        },
        {
          "id": "api-health",
          "name": "API health",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/health"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "routes",
          "name": "Routes API",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/v2/routes"
          },
          "expect": {
            "status": 200,
            "contains": [
              "routes"
            ]
          }
        },
        {
          "id": "auth-requests",
          "name": "Auth requests seeded",
          "type": "http",
          "request": {
            "method": "GET",
            "url": "{webui}/api/auth-requests"
          },
          "expect": {
            "status": 200,
            "contains": [
              "PACOMPLETE01",
              "AuthTraceNumber"
            ]
          }
        }
      ]
    },
    {
      "id": "prior-auth",
      "name": "Prior auth pipeline",
      "tests": [
        {
          "id": "reset-outputs",
          "name": "Clear prior bucket files",
          "type": "shell",
          "shell": {
            "command": "rm -f output/approved/*.xml output/denied/*.xml output/incomplete/*.xml output/pended/*.xml output/responses/*.edi output/ehr-notices/*.hl7 output/staged-decisions/*.xml output/debug/* && docker compose exec -T sqlserver /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P 'PilotFish_Demo1!' -C -d Edi278PriorAuth -Q \"UPDATE dbo.AuthRequest SET Status=N'OPEN', Notes=CASE AuthTraceNumber WHEN N'PACOMPLETE01' THEN N'Complete knee PA — expect APPROVE' WHEN N'PAINCOMPLETE01' THEN N'Missing diagnosis on wire — expect INCOMPLETE' WHEN N'PADENY01' THEN N'Complete MRI brain — expect DENY' WHEN N'PAPEND01' THEN N'Complete lumbar MRI — expect PEND' ELSE Notes END, UpdatedAt=SYSUTCDATETIME();\""
          },
          "expect": {
            "exit_code": 0
          }
        },
        {
          "id": "drop-sample",
          "name": "Copy sample 278 into inbound",
          "type": "shell",
          "shell": {
            "command": "mkdir -p input/inbound && cp -f samples/sample_278_prior_auths.edi input/inbound/"
          },
          "expect": {
            "exit_code": 0
          }
        },
        {
          "id": "approved-out",
          "name": "Approved decision for PACOMPLETE01",
          "type": "file",
          "file": {
            "path": "output/approved/PACOMPLETE01_approved.xml",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "PAYER_APPROVED",
              "approved"
            ]
          }
        },
        {
          "id": "incomplete-out",
          "name": "Incomplete for PAINCOMPLETE01",
          "type": "file",
          "file": {
            "path": "output/incomplete/PAINCOMPLETE01_incomplete.xml",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "MISSING_DIAGNOSIS",
              "incomplete"
            ]
          }
        },
        {
          "id": "denied-out",
          "name": "Denied for PADENY01",
          "type": "file",
          "file": {
            "path": "output/denied/PADENY01_denied.xml",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "PAYER_DENIED",
              "denied"
            ]
          }
        },
        {
          "id": "pended-out",
          "name": "Pended for PAPEND01",
          "type": "file",
          "file": {
            "path": "output/pended/PAPEND01_pended.xml",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "PAYER_PENDED",
              "pended"
            ]
          }
        },
        {
          "id": "278-response",
          "name": "278 response for PACOMPLETE01",
          "type": "file",
          "file": {
            "path": "output/responses/PACOMPLETE01_278_response.edi",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "ST*278",
              "PACOMPLETE01",
              "HCR*A1"
            ]
          }
        },
        {
          "id": "oru-notice",
          "name": "ORU EHR notice for PACOMPLETE01",
          "type": "file",
          "file": {
            "path": "output/ehr-notices/PACOMPLETE01_auth_decided.oru.hl7",
            "exists": true,
            "timeout_sec": 120,
            "contains": [
              "ORU^R01",
              "APPROVED",
              "PACOMPLETE01"
            ]
          }
        }
      ]
    },
    {
      "id": "docs",
      "name": "Documents",
      "tests": [
        {
          "id": "route-pdf",
          "name": "Route PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/EDI278_Prior_Auth_V2_Route_Diagrams.pdf",
            "exists": true
          }
        },
        {
          "id": "brief-pdf",
          "name": "Capability Brief PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/EDI278_Prior_Auth_Capability_Brief.pdf",
            "exists": true
          }
        },
        {
          "id": "test-plan-pdf",
          "name": "Test Plan PDF on disk",
          "type": "file",
          "file": {
            "path": "documents/EDI278_Prior_Auth_Test_Plan.pdf",
            "exists": true
          }
        }
      ]
    }
  ]
}
