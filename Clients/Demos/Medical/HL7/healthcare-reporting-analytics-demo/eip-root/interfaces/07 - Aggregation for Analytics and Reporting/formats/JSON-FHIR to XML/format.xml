<?xml version="1.0" encoding="UTF-8"?>
<Format xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" name="JSON-FHIR to XML">
  <TransformationModule class="com.pilotfish.eip.modules.json.JSONTransformationModule">
    <ModuleConfig>
      <ConverterVersion>2.0</ConverterVersion>
      <HandleAttributes>false</HandleAttributes>
      <SkipNS>false</SkipNS>
      <ExcludeMarkups>false</ExcludeMarkups>
      <HandleRelativeXMLNamespaceTag>false</HandleRelativeXMLNamespaceTag>
      <ExecuteTransformation>true</ExecuteTransformation>
      <EnhancedConversion>false</EnhancedConversion>
      <RenameInvalidElements>false</RenameInvalidElements>
    </ModuleConfig>
  </TransformationModule>
  <XSLT>
    <XSLTParameters>null</XSLTParameters>
    <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
    <CacheXSLTToXML>false</CacheXSLTToXML>
    <FromXML />
    <ToXML>FHIR XML to XML.xslt</ToXML>
    <ExecuteTransformation>true</ExecuteTransformation>
    <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
    <XSLTEngine>SAXON</XSLTEngine>
    <ToXMLAdditional>null</ToXMLAdditional>
    <CacheXSLTFromXML>false</CacheXSLTFromXML>
    <XSLTVersion>1.0</XSLTVersion>
    <FromXMLAdditional>null</FromXMLAdditional>
  </XSLT>
  <FormatMetadata />
  <SplitControl xmlns="http://www.pilotfishtechnology.com/eip/FormatSpec">
    <JoinModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.internal.NullJoinModule" />
    <ForkModule xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" class="com.pilotfish.eip.modules.internal.NullForkModule" />
  </SplitControl>
</Format>

