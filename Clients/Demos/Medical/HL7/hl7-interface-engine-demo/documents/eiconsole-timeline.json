    {
      "id": "r1-smap2",
      "action": "wait_for",
      "detail": "All of your logical mapping is done here between your source format \u2014 in this case our HL7 data represented as a tree to the left \u2014 and our target format, a custom XML representation of some of the patient data we wanted to retain in our database.",
      "started_at_ms": 132641,
