<Module version="2.0" id="aa37d2c0-1f77-48d8-84ef-d71a35ed9155" name="Soft Delete SQL" type="Database (SQL)" tag="Processor" class="com.pilotfish.eip.modules.db.DatabaseSqlProcessor">
   <ModuleConfig>
