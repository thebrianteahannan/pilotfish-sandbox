<?xml version="1.0" encoding="UTF-8"?>
<Route xmlns="http://www.pilotfishtechnology.com/eipr/RouteSpec" CreatedBy="cursor-agent" RouteSpecificPooling="true" debugTraceCurrentSecondsToKeepFiles="-1" debugTraceMaxFiles="-1" debuggingTrace="true" debuggingTraceExpression="" debuggingTracePath="" transactionTimeToLive="300000">
  <RouteMetadata />
  <RoutingModule class="com.pilotfish.eip.modules.routing.XPathRoutingModule">
    <ModuleConfig>
      <RuleSet accumulate="false">
        <Rule>
          <Targets>
            <TransportTarget name="Call Remote FHIR" />
          </Targets>
          <Condition>
            <Expression>true()<Namespaces /></Expression>
          </Condition>
        </Rule>
      </RuleSet>
    </ModuleConfig>
  </RoutingModule>
  <TransactionMonitors />
  <Source icon="" name="Outbound Request Files">
    <FormatProfile name="Relay (System Format)" />
    <Listener class="com.pilotfish.eip.modules.file.DirectoryListener" enabled="true" name="Outbound Request Poll">
      <ModuleConfig>
        <IS_TRIGGERABLE_LISTENER>false</IS_TRIGGERABLE_LISTENER>
        <CLIAllowed>false</CLIAllowed>
        <RESTART_ON_ERROR_TAG>false</RESTART_ON_ERROR_TAG>
        <FIFOQueueName />
        <FIFOQueueDelay>500</FIFOQueueDelay>
        <TransactionLoggingAllowed>false</TransactionLoggingAllowed>
        <TransactionLoggingStoreAttributes>false</TransactionLoggingStoreAttributes>
        <TransactionLoggingStoreData>false</TransactionLoggingStoreData>
        <TransactionLoggingStoreDataBase64>false</TransactionLoggingStoreDataBase64>
        <PollingInterval>5</PollingInterval>
        <PollingDirectory>$$OUTBOUND_REQUEST_DIRECTORY</PollingDirectory>
        <FileNameRestriction />
        <FileExtensionRestriction>json</FileExtensionRestriction>
        <UseFullFilePath>Disabled</UseFullFilePath>
        <FullPathToFile />
        <PostProcessOperation>Move</PostProcessOperation>
        <TargetDirectory>$$OUTBOUND_RESPONSE_DIRECTORY</TargetDirectory>
        <CompatModeMoved>false</CompatModeMoved>
        <Tokenizers />
        <SerializedTransactionsTag>1</SerializedTransactionsTag>
        <SubFolderIterationTag>false</SubFolderIterationTag>
        <FullFolderPathRestrictionsTag />
        <HiddenFilesTag>false</HiddenFilesTag>
        <SchedulerStartTag />
        <SchedulerEndTag />
        <ExcludeDaysTag />
        <ExcludeDatesTag />
        <TimeZone>System Default</TimeZone>
        <MinSecondsSinceFileModified>1</MinSecondsSinceFileModified>
        <MinDaysSinceFileModified>-1</MinDaysSinceFileModified>
        <MaxDaysSinceFileModified>-1</MaxDaysSinceFileModified>
        <CombineFiles>false</CombineFiles>
        <HeaderLines>0</HeaderLines>
        <SynchResponse>false</SynchResponse>
      </ModuleConfig>
    </Listener>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.other.RegExIntoTransactionAttributeProcessor" name="Extract Outbound URL">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <RegEx>"url"\s*:\s*"([^"]+)"</RegEx>
          <AttributeName>fhir.OutUrl</AttributeName>
          <MatchGroupNumber>1</MatchGroupNumber>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Source>
  <Target icon="" name="Remote FHIR">
    <FormatProfile name="Relay (System Format)" />
    <Transport class="com.pilotfish.eip.modules.http.rest.RESTfulWebServiceTransport" name="Call Remote FHIR" retries="1">
      <ModuleConfig>
        <RESOURCE_PATH>{ognl:getAttribute('fhir.OutUrl').toString()}</RESOURCE_PATH>
        <METHOD_TO_EXECUTE>GET</METHOD_TO_EXECUTE>
        <ACCEPT_MEDIA_TYPE>application/fhir+json</ACCEPT_MEDIA_TYPE>
        <QUERY_PARAMS />
        <HttpHeaders>[eip_pair:Accept:eip_name:application/fhir+json:eip_value]</HttpHeaders>
        <Timeout>60</Timeout>
        <USER_NAME />
        <PASSWORD />
        <CALLBACK />
      </ModuleConfig>
    </Transport>
    <Processors>
      <Processor class="com.pilotfish.eip.modules.file.FileWriteProcessor" name="Save Outbound Response Body">
        <ModuleConfig>
          <ExecuteProcessor>true</ExecuteProcessor>
          <TargetDirectory>$$OUTBOUND_RESPONSE_DIRECTORY</TargetDirectory>
          <TargetFileName>{ognl:'resp_' + @java.lang.System@currentTimeMillis() + '.json'}</TargetFileName>
        </ModuleConfig>
      </Processor>
    </Processors>
  </Target>
</Route>
