<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="2c17d260-bbf9-4b43-accb-3f950fc39621" name="Go pickup ap demographics csv for this charges file from input directory" type="StaticFileProcessor" tag="Processor" class="com.pilotfish.eip.modules.file.StaticFileProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <FileName>{ognl:#properties.get('FLAT_FILE_INPUT_DIRECTORY') + '/' + getAttribute('com.pilotfish.FileName').replace('AP_Charges_','AP_Demographics_') + '.csv'}</FileName>
      
          
      <PostProcessOperation>Move</PostProcessOperation>
      
          
      <TargetDirectory>$$FLAT_FILE_ARCHIVE_DIRECTORY</TargetDirectory>
      
        
   </ModuleConfig>
</Module>
