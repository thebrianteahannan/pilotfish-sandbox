      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <FileName>{ognl:#properties.get('FLAT_FILE_INPUT_DIRECTORY') + '/' + getAttribute('com.pilotfish.FileName').replace('AP_Charges_','CP_Demographics_') + '.csv'}</FileName>
      
          
      <PostProcessOperation>Move</PostProcessOperation>
      
          
      <TargetDirectory>$$FLAT_FILE_ARCHIVE_DIRECTORY</TargetDirectory>
      
        
   </ModuleConfig>
</Module>
