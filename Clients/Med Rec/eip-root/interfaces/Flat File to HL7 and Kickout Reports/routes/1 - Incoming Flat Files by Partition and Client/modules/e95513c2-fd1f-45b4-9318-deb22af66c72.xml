<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="e95513c2-fd1f-45b4-9318-deb22af66c72" name="Remove xml header line because it makes it invalid xml when wrapping" type="RegExProcessor" tag="Processor" class="com.pilotfish.eip.modules.other.RegExProcessor">
   <ModuleConfig>
      <ExecuteProcessor>true</ExecuteProcessor>
      
          
      <UseDefaultEncoding>false</UseDefaultEncoding>
      
          
      <Encoding>UTF-8</Encoding>
      
          
      <REGEX_TABLE_TAG>[eip_pair:\s*&lt;\?xml[^&gt;]*\?&gt;\s*:eip_name::eip_value]</REGEX_TABLE_TAG>
      
          
      <PostProcessOptions>Replace all \n with newlines</PostProcessOptions>
      
        
   </ModuleConfig>
</Module>
