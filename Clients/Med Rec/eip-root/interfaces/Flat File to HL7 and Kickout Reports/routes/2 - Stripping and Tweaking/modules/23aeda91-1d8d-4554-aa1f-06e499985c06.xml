<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="23aeda91-1d8d-4554-aa1f-06e499985c06" name="Combine Import XML and Database Query Results - XSLT - PPS ONLY" type="XSLT Transformation" tag="Processor" class="com.pilotfish.eip.modules.transform.XSLTProcessor">
   <ModuleConfig>
      <ExecuteProcessor>{ognl:getAttribute('Partition') == 'PPS'}</ExecuteProcessor>
      
          
      <XSLTPath>transform-concatenate.xslt</XSLTPath>
      
          
      <CacheXSLTToXML>false</CacheXSLTToXML>
      
          
      <XSLTEngine>Saxon</XSLTEngine>
      
          
      <XSLTParameters>[eip_pair:Tag1:eip_name:query_results:eip_value][eip_pair:Source1:eip_name:feed_info_query_results:eip_value]</XSLTParameters>
      
          
      <SaxonConverterHandling>Throw Exception</SaxonConverterHandling>
      
          
      <SaxonConverterEncoding>UTF-8</SaxonConverterEncoding>
      
        
   </ModuleConfig>
</Module>
