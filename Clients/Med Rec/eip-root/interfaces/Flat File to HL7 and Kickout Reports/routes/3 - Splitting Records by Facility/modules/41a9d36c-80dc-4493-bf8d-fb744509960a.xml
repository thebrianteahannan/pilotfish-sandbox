<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="41a9d36c-80dc-4493-bf8d-fb744509960a" name="Get Default Perf Dr (after the split has happened) - PPA and SPG ONLY" type="XPath Evaluation" tag="Processor" class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor">
   <ModuleConfig>
      <ExecuteProcessor>{ognl:getAttribute('Client') == 'PPA' || getAttribute('Partition') == 'NGP' || (getAttribute('Partition') == 'HAL' &amp;&amp; getAttribute('Client') == 'HAX')}</ExecuteProcessor>
      
          
      <AttributeScope>Transaction</AttributeScope>
      
          
      <XPathExpressions>[eip_pair:DefaultPerfDr:eip_name:{ognl:"//SplitInfo/Split[@split_code = '" + getAttribute("SplitCode") + "']/@default_perf_dr"}:eip_value]</XPathExpressions>
      
          
      <GlobalAttributeExpressions/>
      
          
      <Namespaces>null</Namespaces>
      
          
      <Namespace/>
      
          
      <XPath1Compatibility>false</XPath1Compatibility>
      
        
   </ModuleConfig>
</Module>
