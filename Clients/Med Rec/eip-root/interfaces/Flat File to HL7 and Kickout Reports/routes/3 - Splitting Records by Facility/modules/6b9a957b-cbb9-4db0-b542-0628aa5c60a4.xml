      <ExecuteProcessor>{ognl:getAttribute('Client') == 'SPG'}</ExecuteProcessor>
      
          
      <AttributeScope>Transaction</AttributeScope>
      
          
      <XPathExpressions>[eip_pair:DefaultPerfDr:eip_name:{ognl:"//SplitInfo/Split[@split_code = '" + getAttribute("SplitCode") + "']/@default_perf_dr"}:eip_value]</XPathExpressions>
      
          
      <GlobalAttributeExpressions/>
      
          
      <Namespaces>null</Namespaces>
      
          
      <Namespace/>
      
          
      <XPath1Compatibility>false</XPath1Compatibility>
      
        
   </ModuleConfig>
</Module>
