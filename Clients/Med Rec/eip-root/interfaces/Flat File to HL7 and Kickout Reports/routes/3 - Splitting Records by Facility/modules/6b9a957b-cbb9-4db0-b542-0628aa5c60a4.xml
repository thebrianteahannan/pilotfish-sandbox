<?xml version="1.0" encoding="UTF-8"?>
<Module version="2.0" id="6b9a957b-cbb9-4db0-b542-0628aa5c60a4" name="Get Default Perf Dr (after the split has happened) - SPG ONLY" type="XPath Evaluation" tag="Processor" class="com.pilotfish.eip.modules.other.XPathEvaluatorProcessor">
