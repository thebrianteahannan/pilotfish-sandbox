# Secrets / license
pflicense.key
*.key

# Runtime input/output — never commit
data/
data-834/
debug-trace/
debug-trace-834/
**/debug-trace/
logs/
**/logs/

# Large vendor / reference trees (keep local only)
PilotFish_V2/
# Ignore doc copies under PilotFish_Documentation, but keep the external path pointer
PilotFish_Documentation/*
!PilotFish_Documentation/DOCUMENTATION_LOCATION.txt

# Large / non-route artifacts
eip.war*
*.war
*.zip
*.trace.db
logs-834/

# Keep committed H2 DB under Clients/Med Rec/database/; ignore other copies
/medreceivables.mv.db
eip-root/*.mv.db
eip-root/*.trace.db
Clients/**/eip-root/*.mv.db
Clients/**/eip-root/*.trace.db
Clients/Med Rec/database/medreceivables-original.mv.db
Clients/Med Rec/CAT_GAN_Expanse_Deploy/
Clients/Med Rec/deploy/
Clients/Med Rec/funky-chars-issues/

# Demo runtime scratch (keep documents/ route PDFs and .gitkeep placeholders)
Clients/Demos/**/output/**
!Clients/Demos/**/output/**/.gitkeep
Clients/Demos/**/input/**
Clients/Demos/**/Chat_User_Prompts*.pdf

# Local process logs / helpers
Clients/CRL Plus/sandbox/*.log
Clients/CRL Plus/sandbox/*.out

# Local tooling
.venv*/
.DS_Store
__pycache__/
*.pyc
.env
.env.*
node_modules/

# Hindsight (Cursor long-term memory) — keep secrets & session state local
.cursor/mcp.json
.cursor/rules/hindsight-session.mdc
.agents/

jets-pizza-clone/node_modules/
jets-pizza-clone/package-lock.json
jets-pizza-clone/artifacts/screenshots/
